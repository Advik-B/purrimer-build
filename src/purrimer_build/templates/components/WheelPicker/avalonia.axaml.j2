<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:WheelPicker}" TargetType="pm:WheelPicker">
    <Setter Property="Ink" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="MutedInk" Value="{{ "fgColor-muted" | tok }}" />
    <Setter Property="BandBrush" Value="{{ "bgColor-neutral-muted" | tok }}" />
    <Setter Property="BandStroke" Value="{{ "borderColor-default" | tok }}" />
    <Setter Property="FocusBrush" Value="{{ "focus-outlineColor" | tok }}" />
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
  </ControlTheme>
</ResourceDictionary>
