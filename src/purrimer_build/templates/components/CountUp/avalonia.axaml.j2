<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:CountUp}" TargetType="pm:CountUp">
    <Setter Property="FontFamily" Value="{{ "numeric" | font }}" />
    <Setter Property="FontSize" Value="{{ "text-stat" | tokx("FontSize") }}" />
    <Setter Property="LineHeight" Value="{{ "text-stat" | tokx("LineHeight") }}" />
    <Setter Property="Foreground" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </ControlTheme>
</ResourceDictionary>
