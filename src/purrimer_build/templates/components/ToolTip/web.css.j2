.pm-tooltip { position: relative; display: inline-flex; }
.pm-tooltip__bubble,
.pm-tooltip__note {
  position: absolute;
  z-index: 60;
  box-sizing: border-box;
  width: max-content;
  animation: pm-tooltip-pop {{ "duration-base" | tok }} {{ "easing-standard" | tok }} both;
}
.pm-tooltip__bubble {
  max-width: 240px;
  padding: 4px 8px;
  border-radius: {{ "borderRadius-small" | tok }};
  background: {{ "bgColor-emphasis" | tok }};
  color: {{ "fgColor-onEmphasis" | tok }};
  font: 400 12px/16px var(--font-sans);
  pointer-events: none;
}
.pm-tooltip__note {
  max-width: 280px;
  padding: 12px 14px;
  border: {{ "borderWidth-thin" | tok }} solid {{ "borderColor-default" | tok }};
  border-radius: {{ "borderRadius-large" | tok }};
  background: {{ "overlay-bgColor" | tok }};
  box-shadow: {{ "shadow-floating-small" | tok }};
  color: {{ "fgColor-default" | tok }};
  font: 400 14px/20px var(--font-sans);
}
.pm-tooltip--top { bottom: calc(100% + 6px); left: 50%; translate: -50% 0; }
.pm-tooltip--bottom { top: calc(100% + 6px); left: 50%; translate: -50% 0; }
.pm-tooltip--left { right: calc(100% + 6px); top: 50%; translate: 0 -50%; }
.pm-tooltip--right { left: calc(100% + 6px); top: 50%; translate: 0 -50%; }
@keyframes pm-tooltip-pop {
  from { opacity: 0; transform: translateY(-4px); }
  to { opacity: 1; transform: none; }
}
@media (prefers-reduced-motion: reduce) {
  .pm-tooltip__bubble, .pm-tooltip__note { animation-name: pm-tooltip-fade; }
}
@keyframes pm-tooltip-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}
[data-density="touch"] .pm-tooltip__bubble { display: none; }
