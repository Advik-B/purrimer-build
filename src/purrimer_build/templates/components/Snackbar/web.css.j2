.pm-snackbar {
  position: fixed;
  left: 50%;
  bottom: calc({{ "mobile-bottomNav-height" | tok }} + {{ "base-size-16" | tok }} + env(safe-area-inset-bottom, 0px));
  z-index: 90;
  display: flex;
  align-items: center;
  gap: 8px;
  width: min(calc(100vw - 2 * {{ "mobile-gutter" | tok }}), 560px);
  min-height: 48px;
  padding: 4px 4px 4px 16px;
  box-sizing: border-box;
  border-radius: {{ "borderRadius-large" | tok }};
  background: {{ "bgColor-emphasis" | tok }};
  color: {{ "fgColor-onEmphasis" | tok }};
  box-shadow: {{ "shadow-floating-small" | tok }};
  font: 400 14px/20px var(--font-sans);
  translate: calc(-50% + var(--pm-snackbar-dx, 0px)) 0;
  opacity: var(--pm-snackbar-opacity, 1);
  touch-action: pan-y;
  user-select: none;
  -webkit-user-select: none;
  transition: translate var(--pm-settle-dur, 360ms) var(--pm-settle-ease, ease), opacity var(--pm-settle-dur, 360ms) var(--pm-settle-ease, ease);
  /* The toast choreography: rise when sleepy, slink in from the end side when playful. */
  animation: var(--pm-m-p-toast) var(--pm-m-medium) var(--pm-m-enter) both;
}
/* Swiped sideways it follows the finger and fades; once dismissed it slides on out. */
.pm-snackbar--dragging { transition: none; }
.pm-snackbar--leaving { transition-duration: {{ "duration-base" | tok }}; transition-timing-function: {{ "easing-sleepy-exit" | tok }}; }
.pm-snackbar__message { flex: 1; min-width: 0; }
.pm-snackbar__action { height: 40px; padding: 0 12px; border: 0; border-radius: {{ "borderRadius-medium" | tok }}; background: transparent; color: inherit; font: 600 14px/20px var(--font-sans); text-decoration: underline; cursor: pointer; }
.pm-snackbar__action:hover { background: rgb(from currentColor r g b / 0.12); }
.pm-snackbar__action:focus-visible { outline: {{ "borderWidth-thick" | tok }} solid currentColor; }
@media (prefers-reduced-motion: reduce) {
  .pm-snackbar { animation-name: pm-fade-in; transition-duration: {{ "duration-reduced" | tok }}; transition-timing-function: {{ "easing-standard" | tok }}; }
}
