<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<script lang="ts">
  import { wireDismissSwipe } from "../motion";

  let { open = $bindable(false), message, action = "", duration = {{ c.spec.props.duration.default }}, onaction, onclose }: {
    open?: boolean;
    message: string;
    action?: string;
    duration?: number;
    onaction?: () => void;
    onclose?: () => void;
  } = $props();

  let bar: HTMLElement | undefined = $state();
  let dx = $state(0);
  let dragging = $state(false);
  let leaving = $state(false);
  let held = $state(false);

  function close() {
    open = false;
    dx = 0;
    leaving = false;
    onclose?.();
  }

  // The timer pauses while a finger is on the bar.
  $effect(() => {
    if (!open || duration <= 0 || held || leaving) return;
    const id = setTimeout(close, duration);
    return () => clearTimeout(id);
  });

  $effect(() => {
    if (!bar) return;
    return wireDismissSwipe({
      el: bar,
      enabled: () => !leaving,
      onHold: (h) => (held = h),
      onMove: (v, _armed, d) => {
        dx = v;
        dragging = d;
      },
      onDismiss: (direction) => {
        dragging = false;
        leaving = true;
        dx = direction * (bar?.offsetWidth ?? 320) * 1.2;
        setTimeout(close, {{ ms("duration-base") }});
      },
    });
  });
</script>

{#if open}
  <div
    bind:this={bar}
    class={["pm-snackbar", dragging && "pm-snackbar--dragging", leaving && "pm-snackbar--leaving"]}
    role="status"
    aria-live="polite"
    style="--pm-snackbar-dx: {dx}px; --pm-snackbar-opacity: {leaving ? 0 : Math.max(0, 1 - Math.abs(dx) / ((bar?.offsetWidth ?? 320) * 0.6))}"
  >
    <span class="pm-snackbar__message">{message}</span>
    {#if action}<button type="button" class="pm-snackbar__action" onclick={() => { onaction?.(); close(); }}>{action}</button>{/if}
  </div>
{/if}
