from __future__ import annotations

from PySide6.QtCore import QRectF, Qt, Signal
from PySide6.QtGui import QPainter, QPen
from PySide6.QtWidgets import QLabel, QVBoxLayout, QWidget

from ..theme import theme


def _surface(widget: QWidget, painter: QPainter, bg: str, border: str, radius: float) -> None:
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setPen(QPen(theme.color(border), 1))
    painter.setBrush(theme.color(bg))
    painter.drawRoundedRect(QRectF(widget.rect()).adjusted(0.5, 0.5, -0.5, -0.5), radius, radius)


class Card(QWidget):
    """A bordered surface with an optional title. Add widgets to `body`; set interactive for a pressable card."""

    clicked = Signal()

    def __init__(self, title: str = "", interactive: bool = False, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self._interactive = interactive
        self._hover = False
        pad = {{ px("stack-padding-normal") | int }}
        layout = QVBoxLayout(self)
        layout.setContentsMargins(pad, pad, pad, pad)
        layout.setSpacing({{ px("stack-gap-condensed") | int }})
        self.title = QLabel(title)
        self.title.setStyleSheet(theme.text_css({{ "text-title-small" | tok }}))
        self.title.setVisible(bool(title))
        layout.addWidget(self.title)
        self.body = QVBoxLayout()
        self.body.setContentsMargins(0, 0, 0, 0)
        layout.addLayout(self.body)
        if interactive:
            self.setCursor(Qt.CursorShape.PointingHandCursor)
            self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        theme.changed.connect(self._restyle)
        self._restyle()

    def _restyle(self) -> None:
        theme.apply_shadow(self, {{ "shadow-resting-medium" | tok }} if self._hover else {{ "shadow-resting-small" | tok }})
        self.update()

    def enterEvent(self, event) -> None:
        if self._interactive:
            self._hover = True
            self._restyle()

    def leaveEvent(self, event) -> None:
        if self._interactive:
            self._hover = False
            self._restyle()

    def mouseReleaseEvent(self, event) -> None:
        if self._interactive and self.rect().contains(event.position().toPoint()):
            self.clicked.emit()

    def keyPressEvent(self, event) -> None:
        if self._interactive and event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter, Qt.Key.Key_Space):
            self.clicked.emit()
            return
        super().keyPressEvent(event)

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        _surface(self, painter, {{ "bgColor-default" | tok }}, {{ "borderColor-default" | tok }}, {{ px("borderRadius-large") | num }})
        if self.hasFocus():
            painter.setPen(QPen(theme.color({{ "focus-outlineColor" | tok }}), 2))
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawRoundedRect(QRectF(self.rect()).adjusted(1, 1, -1, -1), {{ px("borderRadius-large") | num }}, {{ px("borderRadius-large") | num }})
