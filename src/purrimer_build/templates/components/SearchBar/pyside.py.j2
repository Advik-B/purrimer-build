from __future__ import annotations

from PySide6.QtWidgets import QLineEdit, QWidget

from ..icons import icon
from ..theme import theme


class SearchBar(QLineEdit):
    """A search field with a leading magnifier and a clear button."""

    def __init__(self, text: str = "", placeholder: str = "{{ c.spec.props.placeholder.default }}",
                 parent: QWidget | None = None) -> None:
        super().__init__(text, parent)
        self.setPlaceholderText(placeholder)
        self.setAccessibleName("Search")
        self.setClearButtonEnabled(True)
        self.setProperty("search", "true")
        # The leading action already reserves room for the icon.
        self.setStyleSheet("QLineEdit, QLineEdit:focus { padding-left: 4px; }")
        self.setMinimumHeight({{ px("control-large-size") | int }})
        self._action = None
        theme.changed.connect(self._refresh_icon)
        self._refresh_icon()

    def _refresh_icon(self) -> None:
        if self._action is not None:
            self.removeAction(self._action)
        self._action = self.addAction(icon("search", 16, theme.color({{ "fgColor-muted" | tok }})),
                                      QLineEdit.ActionPosition.LeadingPosition)
