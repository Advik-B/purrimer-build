{## Fonts, token custom properties and themes, shared by purrimer.css and purrimer-classless.css. ##}
{% for f in web_fonts %}
@font-face {
  font-family: "{{ f.family }}";
  src: url("{{ font_prefix }}{{ f.filename }}") format("woff2");
  font-weight: {{ f.weight }};
  font-style: {{ f.style }};
  font-display: swap;
}

{% endfor %}
:root {
{% for n, v in tokens.lengths_css + tokens.durations_css + tokens.easings_css + tokens.other_css %}
  --{{ n }}: {{ v }};
{% endfor %}
{% for key, stack in tokens.families.items() %}
  --font-{{ key }}: {{ stack }};
{% endfor %}
}

{% for theme in themes %}
{% if loop.first %}
:root,
[data-theme="{{ theme }}"] {
{% else %}
[data-theme="{{ theme }}"] {
{% endif %}
  color-scheme: {{ "dark" if theme in tokens.dark_themes else "light" }};
{% for name in tokens.colors %}
  --{{ name }}: {{ tokens.css_color(name, theme) }};
{% endfor %}
{% for name in tokens.shadow_css %}
  --{{ name }}: {{ tokens.shadow_css[name][theme] }};
{% endfor %}
}

{% endfor %}
@media (prefers-reduced-motion: reduce) {
  :root {
{% for n, _ in tokens.durations_css if n != "duration-reduced" %}
    --{{ n }}: var(--duration-reduced);
{% endfor %}
  }
}

/* Motion kinds. Sleepy is the default; data-motion="playful" on any element switches its subtree, and the closest scope
   wins. Every --pm-m-* value comes from the motion catalog (data/motion.toml), which the native targets share.
   Durations are written out rather than read from the duration tokens, because reduced motion shortens those tokens.
   The pose values size the resting snapshot a looping animation shows when animations are off, so reduced motion
   leaves them alone. Touch feedback: surfaces compress to --pm-press-scale while held, spring back over
   --pm-release-*, and settle after a drag over --pm-settle-*. */
{% set touch = {
  "sleepy": {"release": ("duration-sleepy-short", "easing-sleepy-enter"), "settle": ("duration-slow", "easing-sleepy-move")},
  "playful": {"release": ("duration-playful-press", "easing-playful-pop"), "settle": ("duration-playful-medium", "easing-playful-spring")},
} %}
{% macro motion_vars(kind, feel, press=True, pose=True) %}
{% for n, v in motion.css_vars(tokens, kind) %}
  --{{ n }}: {{ v }};
{% endfor %}
  --pm-press-scale: {{ 0.96 if press else 1 }};
  --pm-release-dur: var(--{{ touch[feel].release[0] }});
  --pm-release-ease: var(--{{ touch[feel].release[1] }});
  --pm-settle-dur: var(--{{ touch[feel].settle[0] }});
  --pm-settle-ease: var(--{{ touch[feel].settle[1] }});
{% if pose %}
  --pm-m-pose-dist: {{ motion.kinds[kind].dist | num }}px;
  --pm-m-pose-peak: {{ motion.kinds[kind].peak | num }};
{% endif %}
{% endmacro %}
:root,
[data-motion="sleepy"] {
  {{ motion_vars("sleepy", "sleepy") | trim }}
}

[data-motion="playful"] {
  {{ motion_vars("playful", "playful") | trim }}
}

/* Reduced motion: playful falls back to sleepy, and sleepy keeps its fades but drops movement. */
@media (prefers-reduced-motion: reduce) {
  :root,
  [data-motion="sleepy"] {
    {{ motion_vars("reduced", "sleepy", False, False) | trim | indent(2) }}
  }

  [data-motion="playful"] {
    {{ motion_vars("sleepy", "sleepy", False, False) | trim | indent(2) }}
  }
}

/* The same fallback as an in-app setting: data-motion-reduce on html or any ancestor (MotionScope reduce). */
[data-motion-reduce],
[data-motion-reduce] [data-motion="sleepy"] {
  {{ motion_vars("reduced", "sleepy", False, False) | trim }}
}

[data-motion-reduce][data-motion="playful"],
[data-motion-reduce] [data-motion="playful"] {
  {{ motion_vars("sleepy", "sleepy", False, False) | trim }}
}

@keyframes pm-fade-in {
  from { opacity: 0; }
}

@keyframes pm-fade-out {
  to { opacity: 0; }
}

@keyframes pm-chase {
  from { rotate: 0deg; }
  to { rotate: 360deg; }
}

@keyframes pm-chase-dash {
  0% { stroke-dasharray: 8 100; stroke-dashoffset: 0; }
  50% { stroke-dasharray: 60 100; stroke-dashoffset: -16; }
  100% { stroke-dasharray: 8 100; stroke-dashoffset: -92; }
}
