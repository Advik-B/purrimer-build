// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { PmMotionCatalog, PmMotionFrame } from "../motion.slint";

// Place it in the window above the bottom bar; it shows while open is true and closes after duration. Swipe it
// sideways to dismiss it: it follows the pointer and fades, and past 30% of its width, or on a flick, it slides out and
// closes. Its timer pauses while the pointer is held on it. It arrives with the toast choreography (rise when sleepy,
// slink in from the end side when playful) and leaves with toast-out. Slint cannot see a MotionScope, so set kind by
// hand.
export component Snackbar inherits Rectangle {
    in-out property <bool> open;
    in property <string> message;
    in property <string> action;
    in property <duration> duration: {{ c.spec.props.duration.default }}ms;
    callback action-triggered();
    callback closed();
    property <length> dx;
    property <bool> dragging;
    property <bool> leaving;
    property <string> axis;
    property <length> origin-x;
    property <length> origin-y;
    property <length> last-x;
    property <duration> last-t;
    property <float> velocity;
    // sleepy or playful; empty follows PurrimerMotion.playful.
    in property <string> kind: "";
    in property <bool> reduce: false;
    property <bool> playful: root.kind == "" ? PurrimerMotion.playful : root.kind == "playful";
    property <int> kind-index: root.reduce || PurrimerMotion.reduce ? (root.playful ? 0 : 2) : (root.playful ? 1 : 0);
    // toast-out plays after a close that was not a swipe.
    property <bool> closing;
    property <bool> swiped;
    property <bool> active;
    property <duration> started;
    property <float> elapsed: root.active ? (animation-tick() - root.started) / 1ms : 100000;
    property <string> motion: root.closing ? "toast-out" : "toast";
    property <float> motion-length: PmMotionCatalog.entry(root.motion, root.kind-index).dur / 1ms;
    property <PmMotionFrame> frame: PurrimerMotion.pause-loops
        ? { opacity: 1, sx: 1, sy: 1, reveal: 1, ring-s: 1, draw: 1 }
        : PmMotionCatalog.sample(root.motion, root.kind-index, Math.clamp(root.elapsed / root.motion-length, 0, 1), "");

    init => {
        root.started = animation-tick();
        root.active = root.open;
    }
    changed open => {
        if root.open {
            root.closing = false;
        } else if root.swiped {
            // A swipe already took it away.
            root.swiped = false;
            return;
        } else {
            root.closing = true;
        }
        root.started = animation-tick();
        root.active = true;
    }

    // Ticks only while it moves; toast-out ends with the bar hidden.
    Timer {
        interval: 16ms;
        running: root.active;
        triggered => {
            if PurrimerMotion.pause-loops || root.elapsed >= root.motion-length {
                root.active = false;
                root.closing = false;
            }
        }
    }

    visible: root.open || root.closing || root.leaving;
    height: max(48px, row.preferred-height);
    accessible-role: AccessibleRole.text;
    accessible-label: message;
    animate dx {
        duration: root.dragging || PurrimerMotion.pause-loops ? 0ms : root.leaving ? {{ "duration-base" | tok }} : {{ "duration-slow" | tok }};
        easing: root.leaving ? ease-in : ease-out;
    }

    function close() {
        root.open = false;
        root.closed();
    }

    Timer {
        interval: root.duration;
        running: root.open && root.duration > 0ms && !touch.pressed && !root.leaving;
        triggered => { root.close(); }
    }

    Timer {
        interval: PurrimerMotion.pause-loops ? 1ms : {{ "duration-base" | tok }};
        running: root.leaving;
        triggered => {
            root.swiped = true;
            root.leaving = false;
            root.close();
            root.dx = 0;
        }
    }

    bar := Rectangle {
        x: root.dx + root.frame.tx * 1px + root.frame.txp * root.width;
        y: root.frame.ty * 1px + root.frame.typ * root.height;
        width: root.width;
        transform-scale-x: root.frame.sx;
        transform-scale-y: root.frame.sy;
        // The swipe fades it as it follows the pointer, and fades it out as it slides away.
        opacity: root.leaving ? 0 : root.frame.opacity * max(0, 1 - abs(root.dx) / (root.width * 0.6));
        animate opacity { duration: root.leaving ? {{ "duration-base" | tok }} : 0ms; }
        border-radius: {{ "borderRadius-large" | tok }};
        background: {{ "bgColor-emphasis" | tok }};
        drop-shadow-offset-y: {{ "shadow-floating-small" | tok }}.offset-y;
        drop-shadow-blur: {{ "shadow-floating-small" | tok }}.blur;
        drop-shadow-color: {{ "shadow-floating-small" | tok }}.color;

        touch := TouchArea {
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.origin-x = self.mouse-x + root.dx;
                    root.origin-y = self.mouse-y;
                    root.axis = "";
                    root.velocity = 0;
                    root.last-x = root.origin-x;
                    root.last-t = animation-tick();
                } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) || event.kind == PointerEventKind.cancel {
                    if root.axis == "x" {
                        root.dragging = false;
                        let flick = abs(root.velocity) > 0.6 && (root.velocity > 0) == (root.dx > 0);
                        if event.kind != PointerEventKind.cancel && root.dx != 0 && (abs(root.dx) >= root.width * 0.3 || flick) {
                            root.leaving = true;
                            root.dx = (root.dx > 0 ? 1 : -1) * root.width * 1.2;
                        } else {
                            root.dx = 0;
                        }
                    }
                    root.axis = "";
                }
            }
            moved => {
                // Measured in the root's space, since the bar itself moves with the pointer.
                let x = self.mouse-x + root.dx;
                let mx = x - root.origin-x;
                let my = self.mouse-y - root.origin-y;
                if root.axis == "" {
                    if abs(mx) < 10px && abs(my) < 10px {
                        return;
                    }
                    root.axis = abs(mx) > abs(my) ? "x" : "y";
                }
                if root.axis != "x" {
                    return;
                }
                let now = animation-tick();
                if now > root.last-t {
                    root.velocity = (x - root.last-x) / 1px / ((now - root.last-t) / 1ms);
                }
                root.last-x = x;
                root.last-t = now;
                root.dragging = true;
                root.dx = mx;
            }
        }

        row := HorizontalLayout {
            padding-left: 16px;
            padding-right: 4px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;
            Text {
                horizontal-stretch: 1;
                text: root.message;
                wrap: word-wrap;
                vertical-alignment: center;
                color: {{ "fgColor-onEmphasis" | tok }};
                font-family: {{ "text-body-medium" | tok }}.font-family;
                font-size: 14px;
            }
            if root.action != "": Rectangle {
                height: 40px;
                width: action-text.preferred-width + 24px;
                border-radius: {{ "borderRadius-medium" | tok }};
                background: action-touch.pressed ? {{ "fgColor-onEmphasis" | tok }}.with-alpha(0.12) : transparent;
                accessible-role: button;
                accessible-label: root.action;
                accessible-action-default => { root.action-triggered(); root.close(); }
                action-text := Text {
                    text: root.action;
                    color: {{ "fgColor-onEmphasis" | tok }};
                    font-family: {{ "text-body-medium" | tok }}.font-family;
                    font-size: 14px;
                    font-weight: 600;
                }
                // Slint text has no underline, so the action draws its own.
                Rectangle {
                    x: (parent.width - action-text.preferred-width) / 2;
                    y: (parent.height + action-text.preferred-height) / 2 - 3px;
                    width: action-text.preferred-width;
                    height: 1px;
                    background: {{ "fgColor-onEmphasis" | tok }};
                }
                action-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.action-triggered(); root.close(); }
                }
            }
        }
    }
}
