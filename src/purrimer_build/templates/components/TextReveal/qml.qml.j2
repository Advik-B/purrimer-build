// {{ note }}
// {{ c.summary }}
// One line. Screen readers hear the whole line at once.
pragma ComponentBehavior: Bound
import QtQuick

Item {
    id: root

    property string text: ""
    // word or letter
    property string by: "{{ c.spec.props.by.default }}"
    // reveal, or tangle: scrambled letters settle left to right.
    property string effect: "reveal"
    // Any entrance.
    property string name: "{{ c.spec.props.name.default }}"
    // ms between pieces; 0 uses the kind's stagger (tangle: 48 sleepy, 22 playful per letter).
    property int step: 0
    // mount or inView
    property string trigger: "mount"
    // Empty follows the scope.
    property string kind: ""
    // Change it to play again.
    property int replay: 0
    property font font: Purrimer.textTitleLarge
    property color color: {{ "fgColor-default" | tok }}

    readonly property string effective: Purrimer.effectiveKind(root, root.kind)
    readonly property var pieces: {
        const parts = by === "letter" ? text.split("") : text.split(/(\s+)/).filter(p => p !== "")
        let n = 0
        return parts.map(p => ({ text: p, space: /^\s+$/.test(p), index: /^\s+$/.test(p) ? -1 : n++ }))
    }
    property string tangled: text
    property real elapsed: 0

    implicitWidth: effect === "tangle" ? tangleText.implicitWidth : row.implicitWidth
    implicitHeight: effect === "tangle" ? tangleText.implicitHeight : row.implicitHeight
    Accessible.role: Accessible.StaticText
    Accessible.name: text

    function startTangle() {
        if (effect !== "tangle")
            return
        if (Purrimer.pauseLoops || effective === "still") {
            tangled = text
            return
        }
        elapsed = 0
        frames.start()
    }

    Component.onCompleted: if (trigger === "mount") startTangle()
    onReplayChanged: startTangle()

    FrameAnimation {
        id: frames
        onTriggered: {
            root.elapsed += frameTime * 1000
            const step = root.step > 0 ? root.step : (root.effective === "playful" ? 22 : 48)
            const settled = Math.floor(root.elapsed / step)
            const alphabet = "abcdefghijklmnopqrstuvwxyz0123456789"
            let out = ""
            for (let i = 0; i < root.text.length; i++) {
                const ch = root.text.charAt(i)
                out += i < settled || /\s/.test(ch) ? ch : alphabet.charAt(Math.floor(Math.random() * alphabet.length))
            }
            root.tangled = out
            if (settled >= root.text.length)
                stop()
        }
    }

    Text {
        id: tangleText
        visible: root.effect === "tangle"
        text: root.tangled
        font: root.font
        color: root.color
        Accessible.ignored: true
    }

    Row {
        id: row
        visible: root.effect !== "tangle"
        Repeater {
            model: root.effect === "tangle" ? [] : root.pieces
            delegate: Motion {
                id: piece
                required property var modelData
                name: root.name
                trigger: root.trigger
                kind: root.kind
                index: root.step > 0 ? 0 : Math.max(0, modelData.index)
                delay: root.step > 0 ? Math.max(0, modelData.index) * root.step : 0
                replay: root.replay
                Text {
                    text: piece.modelData.text
                    font: root.font
                    color: root.color
                    Accessible.ignored: true
                }
            }
        }
    }
}
