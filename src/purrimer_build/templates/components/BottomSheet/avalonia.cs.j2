// {{ note }}
// {{ c.summary }}
using System;
using System.Globalization;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Controls.Metadata;
using Avalonia.Controls.Primitives;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.Media.Transformation;

namespace {{ ns }};

// A sheet that rises from the bottom. Place it last in a Panel that covers the screen. Drag the handle down, tap the
// scrim or press Escape to dismiss; IsInline draws it in place as an ordinary control, for docs and previews.
[PseudoClasses(":open", ":inline", ":dragging")]
[TemplatePart("PART_Sheet", typeof(Border))]
[TemplatePart("PART_Handle", typeof(Control))]
[TemplatePart("PART_Backdrop", typeof(Control))]
public class BottomSheet : ContentControl
{
    public static readonly StyledProperty<bool> IsOpenProperty =
        AvaloniaProperty.Register<BottomSheet, bool>(nameof(IsOpen), defaultBindingMode: global::Avalonia.Data.BindingMode.TwoWay);

    public static readonly StyledProperty<string?> TitleProperty =
        AvaloniaProperty.Register<BottomSheet, string?>(nameof(Title));

    public static readonly StyledProperty<string?> DescriptionProperty =
        AvaloniaProperty.Register<BottomSheet, string?>(nameof(Description));

    public static readonly StyledProperty<object?> ActionsProperty =
        AvaloniaProperty.Register<BottomSheet, object?>(nameof(Actions));

    public static readonly StyledProperty<string> SizeProperty =
        AvaloniaProperty.Register<BottomSheet, string>(nameof(Size), "auto");

    public static readonly StyledProperty<bool> IsDismissibleProperty =
        AvaloniaProperty.Register<BottomSheet, bool>(nameof(IsDismissible), true);

    public static readonly StyledProperty<bool> ShowGrabberProperty =
        AvaloniaProperty.Register<BottomSheet, bool>(nameof(ShowGrabber), true);

    public static readonly StyledProperty<bool> IsInlineProperty =
        AvaloniaProperty.Register<BottomSheet, bool>(nameof(IsInline));

    // A fixed sheet height in pixels; NaN lets Size decide.
    public static readonly StyledProperty<double> SheetHeightProperty =
        AvaloniaProperty.Register<BottomSheet, double>(nameof(SheetHeight), double.NaN);

    public static readonly RoutedEvent<RoutedEventArgs> ClosedEvent =
        RoutedEvent.Register<BottomSheet, RoutedEventArgs>(nameof(Closed), RoutingStrategies.Bubble);

    private const double DismissDistance = 96;
    private const double FlickVelocity = 600;

    private readonly PurrimerSpring _spring = new(0, 0.5);
    private readonly PurrimerVelocityTracker _tracker = new();
    private Border? _sheet;
    private Control? _handle;
    private Control? _backdrop;
    private global::Avalonia.Animation.Transitions? _transitions;
    private Point? _grabOrigin;
    private double _grabBase;
    private double _offset;
    private bool _sprung;

    public BottomSheet()
    {
        _spring.Changed += v =>
        {
            _offset = v;
            UpdatePosition();
        };
        _spring.Settled += OnSpringSettled;
    }

    public bool IsOpen
    {
        get => GetValue(IsOpenProperty);
        set => SetValue(IsOpenProperty, value);
    }

    public string? Title
    {
        get => GetValue(TitleProperty);
        set => SetValue(TitleProperty, value);
    }

    public string? Description
    {
        get => GetValue(DescriptionProperty);
        set => SetValue(DescriptionProperty, value);
    }

    // Buttons under the body, stacked full width with the accepting one last.
    public object? Actions
    {
        get => GetValue(ActionsProperty);
        set => SetValue(ActionsProperty, value);
    }

    // "auto" fits the content; "half" and "full" set the height.
    public string Size
    {
        get => GetValue(SizeProperty);
        set => SetValue(SizeProperty, value);
    }

    public bool IsDismissible
    {
        get => GetValue(IsDismissibleProperty);
        set => SetValue(IsDismissibleProperty, value);
    }

    public bool ShowGrabber
    {
        get => GetValue(ShowGrabberProperty);
        set => SetValue(ShowGrabberProperty, value);
    }

    public bool IsInline
    {
        get => GetValue(IsInlineProperty);
        set => SetValue(IsInlineProperty, value);
    }

    public double SheetHeight
    {
        get => GetValue(SheetHeightProperty);
        set => SetValue(SheetHeightProperty, value);
    }

    public event EventHandler<RoutedEventArgs>? Closed
    {
        add => AddHandler(ClosedEvent, value);
        remove => RemoveHandler(ClosedEvent, value);
    }

    public void Close() => Close(null);

    // A drag hands over its velocity so the sheet carries on under the spring.
    private void Close(double? velocity)
    {
        if (!IsOpen || IsInline)
            return;
        if (velocity is { } v && _sheet != null)
        {
            _sheet.Transitions = null;
            _sprung = true;
            _spring.Set(_offset);
            SetCurrentValue(IsOpenProperty, false);
            _spring.To(_sheet.Bounds.Height + 32, v);
        }
        else
        {
            SetCurrentValue(IsOpenProperty, false);
        }
        RaiseEvent(new RoutedEventArgs(ClosedEvent, this));
    }

    private void Dismiss(double? velocity = null)
    {
        if (IsDismissible)
            Close(velocity);
    }

    protected override void OnApplyTemplate(TemplateAppliedEventArgs e)
    {
        if (_handle != null)
        {
            _handle.PointerPressed -= OnHandlePressed;
            _handle.PointerMoved -= OnHandleMoved;
            _handle.PointerReleased -= OnHandleReleased;
            _handle.PointerCaptureLost -= OnHandleCaptureLost;
        }
        if (_backdrop != null)
            _backdrop.PointerPressed -= OnBackdropPressed;
        base.OnApplyTemplate(e);
        _sheet = e.NameScope.Find<Border>("PART_Sheet");
        _handle = e.NameScope.Find<Control>("PART_Handle");
        _backdrop = e.NameScope.Find<Control>("PART_Backdrop");
        _transitions = _sheet?.Transitions;
        if (_handle != null)
        {
            _handle.PointerPressed += OnHandlePressed;
            _handle.PointerMoved += OnHandleMoved;
            _handle.PointerReleased += OnHandleReleased;
            _handle.PointerCaptureLost += OnHandleCaptureLost;
        }
        if (_backdrop != null)
            _backdrop.PointerPressed += OnBackdropPressed;
        PseudoClasses.Set(":inline", IsInline);
        PseudoClasses.Set(":open", IsOpen || IsInline);
        ApplySize();
        UpdatePosition();
    }

    protected override void OnPropertyChanged(AvaloniaPropertyChangedEventArgs change)
    {
        base.OnPropertyChanged(change);
        if (change.Property == IsOpenProperty || change.Property == IsInlineProperty)
        {
            PseudoClasses.Set(":inline", IsInline);
            PseudoClasses.Set(":open", IsOpen || IsInline);
            if (IsOpen && change.Property == IsOpenProperty)
            {
                _spring.Stop();
                RestoreTransitions();
                _offset = 0;
                Focus();
            }
            UpdatePosition();
        }
        else if (change.Property == SizeProperty || change.Property == SheetHeightProperty || change.Property == BoundsProperty)
        {
            ApplySize();
            UpdatePosition();
        }
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        base.OnKeyDown(e);
        if (IsOpen && !IsInline && e.Key == Key.Escape)
        {
            e.Handled = true;
            Dismiss();
        }
    }

    private void ApplySize()
    {
        if (_sheet == null)
            return;
        var limit = Math.Max(0, Bounds.Height - 48);
        _sheet.MaxHeight = IsInline ? double.PositiveInfinity : limit;
        _sheet.Height = !double.IsNaN(SheetHeight) ? SheetHeight
            : IsInline ? double.NaN
            : Size == "half" ? Bounds.Height / 2
            : Size == "full" ? limit
            : double.NaN;
    }

    private void UpdatePosition()
    {
        if (_sheet == null)
            return;
        var height = _sheet.Bounds.Height > 0 ? _sheet.Bounds.Height : 400;
        var y = IsInline ? 0 : IsOpen || _sprung ? _offset : height + 32;
        _sheet.RenderTransform = TransformOperations.Parse(
            string.Create(CultureInfo.InvariantCulture, $"translateY({y}px)"));
        if (_backdrop == null)
            return;
        if (_sprung)
            _backdrop.Opacity = Math.Max(0, 1 - Math.Max(_offset, 0) / height);
        else
            _backdrop.ClearValue(OpacityProperty);
    }

    private void RestoreTransitions()
    {
        _sprung = false;
        if (_sheet != null)
            _sheet.Transitions = _transitions;
        _backdrop?.ClearValue(OpacityProperty);
    }

    private void OnSpringSettled()
    {
        if (!IsOpen)
            _offset = 0;
        RestoreTransitions();
        UpdatePosition();
    }

    private void OnBackdropPressed(object? sender, PointerPressedEventArgs e)
    {
        e.Handled = true;
        Dismiss();
    }

    private void OnHandlePressed(object? sender, PointerPressedEventArgs e)
    {
        if (!IsDismissible || IsInline || !IsOpen)
            return;
        var p = e.GetPosition(this);
        _spring.Stop();
        _grabOrigin = p;
        _grabBase = _offset;
        _tracker.Reset();
        _tracker.Add(p);
        e.Pointer.Capture(_handle);
        e.Handled = true;
    }

    private void OnHandleMoved(object? sender, PointerEventArgs e)
    {
        if (_grabOrigin is not { } origin || _sheet == null)
            return;
        var p = e.GetPosition(this);
        _tracker.Add(p);
        var next = _grabBase + p.Y - origin.Y;
        if (!_sprung)
        {
            _sprung = true;
            _sheet.Transitions = null;
            PseudoClasses.Set(":dragging", true);
        }
        if (next < 0)
            next = PurrimerMotion.RubberBand(next, _sheet.Bounds.Height);
        _offset = next;
        UpdatePosition();
    }

    private void OnHandleReleased(object? sender, PointerReleasedEventArgs e)
    {
        if (_grabOrigin == null)
            return;
        e.Pointer.Capture(null);
        EndGrab();
    }

    private void OnHandleCaptureLost(object? sender, PointerCaptureLostEventArgs e) => EndGrab();

    private void EndGrab()
    {
        if (_grabOrigin == null)
            return;
        _grabOrigin = null;
        PseudoClasses.Set(":dragging", false);
        if (!_sprung)
            return;
        var velocity = _tracker.Velocity().Y;
        if (_offset > DismissDistance || (_offset > 24 && velocity > FlickVelocity))
        {
            Dismiss(velocity);
        }
        else
        {
            _spring.Set(_offset);
            _spring.To(0, velocity);
        }
    }
}
