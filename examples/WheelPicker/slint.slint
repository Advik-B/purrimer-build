import { WheelPicker } from "purrimer-components.slint";

export component Example inherits VerticalLayout {
    alignment: start;
    WheelPicker {
        columns: [
            { label: "Hour", options: ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"], index: 6, align: "end" },
            { label: "Minute", options: ["00", "05", "10", "15", "20", "25", "30", "35", "40", "45", "50", "55"], index: 6 },
            { label: "AM or PM", options: ["AM", "PM"], index: 0, align: "start" },
        ];
        changed(column, index) => { debug("column", column, index); }
    }
}
