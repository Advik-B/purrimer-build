import { ImageViewer } from "purrimer-components.slint";

export component Example inherits Rectangle {
    width: 390px;
    height: 520px;

    ImageViewer {
        inline: true;
        source: @image-url("photo.jpg");
        alt: "Sunset over the lake";
        caption: "Lake Ilgen, an hour before dark";
        closed => { debug("close"); }
    }
}
