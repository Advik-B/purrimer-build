<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Purrimer.Showcase.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Purrimer.Avalonia/Purrimer/Purrimer.axaml" />
        <ResourceInclude Source="avares://Purrimer.Avalonia/Purrimer/Icons.axaml" />
        <ResourceInclude Source="avares://Purrimer.Avalonia/Purrimer/Controls.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
