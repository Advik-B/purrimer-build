// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { BottomNav, BottomNavItem } from "bottom-nav.slint";
import { Icon } from "icon.slint";

// The navigation state, shared by MobileNavigator and its NavScreens (one navigator per app). Slint cannot build
// components by name, so every screen is declared up front as a NavScreen with a name; push(name) and pop() move
// between them. A name can be on the stack once, at most eight deep, and screens read their own params from app
// properties. The stack holds names in slots s0 to s7.
export global PurrimerNavigator {
    in-out property <int> depth: 1;
    in-out property <string> s0;
    in-out property <string> s1;
    in-out property <string> s2;
    in-out property <string> s3;
    in-out property <string> s4;
    in-out property <string> s5;
    in-out property <string> s6;
    in-out property <string> s7;
    // "", "push", "pop", "drag" (an edge swipe in progress) or "settle" (a swipe going back to the start).
    in-out property <string> mode;
    // Set when a pop carries on from a swipe, which already moved with the finger, so it runs without easing.
    in-out property <bool> linear;
    // How far the current transition or swipe has come, 0 to 1.
    in-out property <float> progress;
    in-out property <int> tab;
    out property <string> top: self.slot(self.depth - 1);
    out property <string> below: self.depth > 1 ? self.slot(self.depth - 2) : "";

    pure function slot(i: int) -> string {
        return i == 0 ? self.s0 : i == 1 ? self.s1 : i == 2 ? self.s2 : i == 3 ? self.s3 : i == 4 ? self.s4 : i == 5 ? self.s5 : i == 6 ? self.s6 : self.s7;
    }

    function set-slot(i: int, name: string) {
        if i == 0 { self.s0 = name; } else if i == 1 { self.s1 = name; } else if i == 2 { self.s2 = name; } else if i == 3 { self.s3 = name; }
        else if i == 4 { self.s4 = name; } else if i == 5 { self.s5 = name; } else if i == 6 { self.s6 = name; } else { self.s7 = name; }
    }

    // Sets the root screen and clears the stack, with no transition.
    public function reset(name: string) {
        self.s0 = name;
        self.depth = 1;
        self.mode = "";
        self.progress = 0;
    }

    public function push(name: string) {
        if self.mode == "" && self.depth < 8 {
            self.set-slot(self.depth, name);
            self.depth += 1;
            self.progress = PurrimerMotion.pause-loops ? 1 : 0;
            self.linear = false;
            self.mode = PurrimerMotion.pause-loops ? "" : "push";
        }
    }

    public function pop() {
        if self.mode == "" && self.depth > 1 {
            if PurrimerMotion.pause-loops {
                self.depth -= 1;
            } else {
                self.progress = 0;
                self.linear = false;
                self.mode = "pop";
            }
        }
    }
}

// One screen of a MobileNavigator, shown while its name is on top of the stack. Put a MobileScreen inside.
export component NavScreen inherits Rectangle {
    in property <string> name;
    out property <bool> active: PurrimerNavigator.top == root.name && PurrimerNavigator.mode == "";
    property <bool> is-top: PurrimerNavigator.top == root.name;
    property <bool> is-below: PurrimerNavigator.below == root.name && PurrimerNavigator.mode != "";
    property <bool> raw: PurrimerNavigator.linear || PurrimerNavigator.mode == "drag" || PurrimerNavigator.mode == "settle";
    property <float> p: self.raw ? PurrimerNavigator.progress : 1 - Math.pow(1 - PurrimerNavigator.progress, 3);

    visible: self.is-top || self.is-below;
    x: !self.is-top ? (PurrimerNavigator.mode == "push" ? -0.3 * self.width * self.p : -0.3 * self.width * (1 - self.p))
        : PurrimerNavigator.mode == "push" ? self.width * (1 - self.p)
        : PurrimerNavigator.mode == "" ? 0px
        : self.width * self.p;
    z: self.is-top ? 2 : 1;
    background: {{ "bgColor-default" | tok }};

    @children

    // Dims a screen as the next one covers it.
    if root.is-below: Rectangle {
        background: {{ "overlay-backdrop-bgColor" | tok }};
        opacity: 0.4 * (PurrimerNavigator.mode == "push" ? root.p : 1 - root.p);
    }
}

// A stack of phone screens: NavScreens as children. Pushes slide in from the right while the screen under shifts 30%
// and dims; pops reverse it. A swipe from the left edge, by finger or mouse, drags the top screen back and goes back
// past 35% of the width or on a flick. With nav-items the navigator draws the BottomNav; picking a tab resets the stack
// to tab-screens[i] with a crossfade (Slint keeps one stack, not one per tab).
export component MobileNavigator inherits Rectangle {
    in property <[BottomNavItem]> nav-items;
    in property <[string]> tab-screens;
    // The first screen when there are no tabs.
    in property <string> initial;
    callback tab-changed(int);
    property <string> mode-watch: PurrimerNavigator.mode;

    init => {
        if root.initial != "" {
            PurrimerNavigator.reset(root.initial);
        } else if root.tab-screens.length > 0 {
            PurrimerNavigator.reset(root.tab-screens[0]);
        }
    }

    // Restarts the clock when a transition starts, so its first step is not the time since the last one.
    changed mode-watch => {
        root.last = animation-tick();
    }
    property <duration> span: PurrimerMotion.playful ? {{ "duration-playful-screen" | tok }} : {{ "duration-sleepy-screen" | tok }};
    property <duration> last;
    property <length> drag-x;
    property <duration> drag-t;
    property <float> velocity;
    property <float> fade: 1;

    background: {{ "bgColor-default" | tok }};
    forward-focus: keys;

    keys := FocusScope {
        key-pressed(event) => {
            if event.modifiers.alt && event.text == Key.LeftArrow {
                PurrimerNavigator.pop();
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        stage := Rectangle {
            clip: true;
            opacity: root.fade;
            @children

            if PurrimerNavigator.mode == "drag": Rectangle {
                x: 4px + Math.min(PurrimerNavigator.progress * stage.width, 48px);
                y: (stage.height - self.height) / 2;
                z: 10;
                width: 32px;
                height: 32px;
                border-radius: 16px;
                background: PurrimerNavigator.progress >= 0.35 ? {{ "button-primary-bgColor-rest" | tok }} : {{ "overlay-bgColor" | tok }};
                drop-shadow-offset-y: {{ "shadow-floating-small" | tok }}.offset-y;
                drop-shadow-blur: {{ "shadow-floating-small" | tok }}.blur;
                drop-shadow-color: {{ "shadow-floating-small" | tok }}.color;
                Icon {
                    path: PurrimerIcons.arrow-left-16;
                    color: PurrimerNavigator.progress >= 0.35 ? {{ "fgColor-onEmphasis" | tok }} : {{ "fgColor-default" | tok }};
                }
            }

            if PurrimerNavigator.depth > 1: TouchArea {
                x: 0;
                width: {{ "mobile-edge-width" | tok }};
                z: 11;
                pointer-event(event) => {
                    if event.kind == PointerEventKind.down && PurrimerNavigator.mode == "" {
                        PurrimerNavigator.mode = "drag";
                        PurrimerNavigator.progress = 0;
                        root.drag-x = 0;
                        root.drag-t = animation-tick();
                        root.velocity = 0;
                    } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) && PurrimerNavigator.mode == "drag" {
                        if PurrimerNavigator.progress >= 0.35 || root.velocity > 600 {
                            PurrimerNavigator.linear = true;
                            PurrimerNavigator.mode = "pop";
                        } else {
                            PurrimerNavigator.mode = "settle";
                        }
                        root.last = animation-tick();
                    }
                }
                moved => {
                    if PurrimerNavigator.mode == "drag" {
                        let dx = self.mouse-x - self.pressed-x;
                        let now = animation-tick();
                        let dt = (now - root.drag-t) / 1s;
                        if dt > 0 {
                            root.velocity = (dx - root.drag-x) / 1px / dt;
                        }
                        root.drag-x = dx;
                        root.drag-t = now;
                        PurrimerNavigator.progress = Math.clamp(dx / stage.width, 0, 1);
                    }
                }
            }
        }
        if root.nav-items.length > 0: BottomNav {
            items: root.nav-items;
            show-labels: true;
            selected: PurrimerNavigator.tab;
            activated(i) => {
                if i != PurrimerNavigator.tab || PurrimerNavigator.depth > 1 {
                    PurrimerNavigator.tab = i;
                    PurrimerNavigator.reset(root.tab-screens[i]);
                    root.fade = PurrimerMotion.pause-loops ? 1 : 0;
                    root.last = animation-tick();
                    root.tab-changed(i);
                }
            }
        }
    }

    // Drives transitions on the render clock. A pop from a swipe carries on from where the finger let go; "settle"
    // runs a swipe that did not go far enough back to the start.
    Timer {
        interval: 8ms;
        running: PurrimerNavigator.mode == "push" || PurrimerNavigator.mode == "pop" || PurrimerNavigator.mode == "settle" || root.fade < 1;
        triggered => {
            let now = animation-tick();
            let step = Math.max(0, (now - root.last) / root.span);
            root.last = now;
            if root.fade < 1 {
                root.fade = Math.min(1, root.fade + step * root.span / {{ "duration-screen-fade" | tok }});
            }
            if PurrimerNavigator.mode == "settle" {
                PurrimerNavigator.progress = Math.max(0, PurrimerNavigator.progress - step * 2);
                if PurrimerNavigator.progress <= 0 {
                    PurrimerNavigator.mode = "";
                }
            } else if PurrimerNavigator.mode != "" {
                PurrimerNavigator.progress = Math.min(1, PurrimerNavigator.progress + step);
                if PurrimerNavigator.progress >= 1 {
                    if PurrimerNavigator.mode == "pop" {
                        PurrimerNavigator.depth -= 1;
                    }
                    PurrimerNavigator.mode = "";
                    PurrimerNavigator.linear = false;
                    PurrimerNavigator.progress = 0;
                }
            }
        }
    }
}
