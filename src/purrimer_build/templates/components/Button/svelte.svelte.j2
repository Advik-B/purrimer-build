<button
  {...rest}
  {type}
  class={["pm-button", variant !== "default" && `pm-button--${variant}`, size !== "medium" && `pm-button--${size}`, block && "pm-button--block", className]}
>
  {#if leadingIcon}<Icon name={leadingIcon} />{/if}
