// {{ c.summary }}
import { For, Show, createSignal, createUniqueId } from "solid-js";
import type { JSX } from "@solidjs/web";
import { Icon } from "./Icon";

export type SelectProps = {
  label: string;
  options: string[];
  value?: number;
  placeholder?: string;
  disabled?: boolean;
  onChange?: (index: number) => void;
};

export function Select(props: SelectProps): JSX.Element {
  const uid = createUniqueId();
  const [value, setValue] = createSignal(() => props.value ?? -1);
  const [open, setOpen] = createSignal(false);
  const [active, setActive] = createSignal(0);
  let root: HTMLDivElement | undefined;

  const show = () => {
    if (props.disabled) return;
    setActive(value() >= 0 ? value() : 0);
    setOpen(true);
  };
  const choose = (index: number) => {
    setValue(index);
    setOpen(false);
    props.onChange?.(index);
  };
  const onKeyDown = (e: KeyboardEvent) => {
    const last = props.options.length - 1;
    if (!open()) {
      if (["ArrowDown", "ArrowUp", "Enter", " "].includes(e.key)) {
        e.preventDefault();
        show();
      }
      return;
    }
    if (e.key === "ArrowDown") setActive(Math.min(last, active() + 1));
    else if (e.key === "ArrowUp") setActive(Math.max(0, active() - 1));
    else if (e.key === "Home") setActive(0);
    else if (e.key === "End") setActive(last);
    else if (e.key === "Enter" || e.key === " ") choose(active());
    else if (e.key === "Escape") setOpen(false);
    else return;
    e.preventDefault();
  };

  return (
    <div
      ref={(el) => (root = el)}
      class={["pm-select", open() && "pm-select--open", props.disabled && "pm-select--disabled"]}
      onFocusOut={(e) => {
        if (!root?.contains(e.relatedTarget as Node)) setOpen(false);
      }}
    >
      <span class="pm-select__label" id={`${uid}-label`}>{props.label}</span>
      <button
        type="button"
        class="pm-select__field"
        role="combobox"
        aria-haspopup="listbox"
        aria-expanded={open() ? "true" : "false"}
        aria-controls={`${uid}-list`}
        aria-labelledby={`${uid}-label`}
        aria-activedescendant={open() ? `${uid}-${active()}` : undefined}
        disabled={props.disabled}
        onClick={() => (open() ? setOpen(false) : show())}
        onKeyDown={onKeyDown}
      >
        <Show when={value() >= 0} fallback={<span class="pm-select__placeholder">{props.placeholder ?? "{{ c.spec.props.placeholder.default }}"}</span>}>
          <span>{props.options[value()]}</span>
        </Show>
        <Icon name="chevron-down" />
      </button>
      <Show when={open()}>
        <ul class="pm-select__list" role="listbox" id={`${uid}-list`} aria-labelledby={`${uid}-label`}>
          <For each={props.options}>
            {(option, i) => (
              <li
                id={`${uid}-${i()}`}
                class={["pm-select__option", i() === active() && "pm-select__option--active"]}
                role="option"
                aria-selected={i() === value() ? "true" : "false"}
                onPointerEnter={() => setActive(i())}
                onPointerDown={(e) => e.preventDefault()}
                onClick={() => choose(i())}
              >
                <span>{option}</span>
                <Show when={i() === value()}><Icon name="check" /></Show>
              </li>
            )}
          </For>
        </ul>
      </Show>
    </div>
  );
}
