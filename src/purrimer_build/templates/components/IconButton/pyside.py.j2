from __future__ import annotations

from PySide6.QtCore import QSize, Qt
from PySide6.QtWidgets import QPushButton, QWidget

from ..icons import icon
from ..motion import ControlPress
from ..theme import theme


def _repolish(widget: QWidget) -> None:
    widget.style().unpolish(widget)
    widget.style().polish(widget)
    widget.update()


class IconButton(QPushButton):
    """A square button with one icon; the label is the tooltip and the accessible name. In a playful scope it presses
    to 95% and pops back."""

    def __init__(self, icon_name: str, label: str, variant: str = "default", size: str = "medium",
                 parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self._icon_name = icon_name
        self.setToolTip(label)
        self.setAccessibleName(label)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self._press = ControlPress(self)
        self.setProperty("iconOnly", "true")
        self.setProperty("variant", variant)
        # "size" would shadow QWidget.size, so the stylesheet reads pmSize.
        self.setProperty("pmSize", size)
        side = {"small": {{ px("control-small-size") | int }}, "large": {{ px("control-large-size") | int }}}.get(
            size, {{ px("control-medium-size") | int }})
        self.setFixedSize(side, side)
        _repolish(self)
        theme.changed.connect(self._refresh_icon)
        self._refresh_icon()

    def set_icon_name(self, name: str) -> None:
        self._icon_name = name
        self._refresh_icon()

    def _refresh_icon(self) -> None:
        size = 24 if self.property("pmSize") == "large" else 16
        token = {"primary": {{ "fgColor-onEmphasis" | tok }}, "danger": {{ "fgColor-danger" | tok }}}.get(
            self.property("variant"), {{ "fgColor-muted" | tok }})
        self.setIcon(icon(self._icon_name, size, theme.color(token)))
        self.setIconSize(QSize(size, size))
