from __future__ import annotations

from PySide6.QtCore import QPointF, QPropertyAnimation, QRectF, Qt, Signal
from PySide6.QtGui import QPainter, QPainterPath, QPen
from PySide6.QtWidgets import QGraphicsOpacityEffect, QHBoxLayout, QLabel, QVBoxLayout, QWidget

from ..icons import paint_icon
from ..motion import Spring, VelocityTracker, in_touch_scope
from ..theme import theme
from .icon import Icon
from .icon_button import IconButton

# Share of the width past which a release dismisses.
COMMIT = 0.3
RADIUS = {{ px("borderRadius-large") | num }}


def _surface(widget: QWidget, painter: QPainter, bg: str, border: str, radius: float) -> None:
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setPen(QPen(theme.color(border), 1))
    painter.setBrush(theme.color(bg))
    painter.drawRoundedRect(QRectF(widget.rect()).adjusted(0.5, 0.5, -0.5, -0.5), radius, radius)

TONES = {
    "info": "info",
    "success": "check-circle",
    "attention": "alert",
    "danger": "stop",
    "done": "check-circle-fill",
}
COLORS = {
{% for t in ["info", "success", "attention", "danger", "done"] %}
    "{{ t }}": ({{ ("bgColor-" ~ t ~ "-muted") | tok }}, {{ ("borderColor-" ~ t ~ "-emphasis") | tok }}, {{ ("fgColor-" ~ t) | tok }}),
{% endfor %}
}


class _Card(QWidget):
    def __init__(self, banner: Banner) -> None:
        super().__init__(banner)
        self._banner = banner

    def paintEvent(self, event) -> None:
        bg, border, _ = COLORS[self._banner.tone]
        _surface(self, QPainter(self), bg, border, RADIUS)


class Banner(QWidget):
    """An inline message in info, success, attention, danger or done tone.

    Inside a touch scope (an ancestor with the pmTouchScope property set, such as MobileScreen) a dismissible banner
    also swipes sideways to dismiss: it follows the pointer and fades over a panel with a close mark, which fills past
    30% of its width. A release there, or a flick, slides it out and closes the gap before `dismissed` is emitted; an
    earlier release springs back. A vertical drag is left to scrolling, and the close button stays for keyboards.
    """

    dismissed = Signal()

    def __init__(self, tone: str = "info", title: str = "", text: str = "", dismissible: bool = False,
                 parent: QWidget | None = None) -> None:
        super().__init__(parent)
        if tone not in TONES:
            raise ValueError(f"tone must be one of {tuple(TONES)}")
        self.tone = tone
        self._dismissible = dismissible
        bg, border, fg = COLORS[tone]
        outer = QVBoxLayout(self)
        outer.setContentsMargins(0, 0, 0, 0)
        self._card = _Card(self)
        outer.addWidget(self._card)
        layout = QHBoxLayout(self._card)
        layout.setContentsMargins(16, 12, 8 if dismissible else 16, 12)
        layout.setSpacing(12)
        self.icon = Icon(TONES[tone], 16, fg)
        layout.addWidget(self.icon, 0, Qt.AlignmentFlag.AlignTop)
        texts = QVBoxLayout()
        texts.setSpacing(0)
        body_font = theme.font({{ "text-body-medium" | tok }})
        self.title = QLabel(title)
        title_font = theme.font({{ "text-body-medium" | tok }})
        title_font.setBold(True)
        self.title.setFont(title_font)
        self.title.setWordWrap(True)
        self.title.setVisible(bool(title))
        self.text = QLabel(text)
        self.text.setFont(body_font)
        self.text.setWordWrap(True)
        self.text.setVisible(bool(text))
        texts.addWidget(self.title)
        texts.addWidget(self.text)
        layout.addLayout(texts, 1)
        if dismissible:
            close = IconButton("x", "Dismiss", variant="invisible", size="small")
            close.clicked.connect(self.dismissed)
            layout.addWidget(close, 0, Qt.AlignmentFlag.AlignTop)
        self._dx = Spring(0.0, precision=0.5, parent=self)
        self._dx.changed.connect(self._slid)
        self._dx.settled.connect(self._settled)
        self._mark = Spring(1.0, precision=0.001, parent=self)
        self._mark.changed.connect(lambda _v: self.update())
        self._origin: QPointF | None = None
        self._axis: str | None = None
        self._armed = False
        self._side = 0
        self._leaving = False
        self._tracker = VelocityTracker()
        self._fade: QGraphicsOpacityEffect | None = None
        self._collapse = QPropertyAnimation(self, b"maximumHeight", self)
        self._collapse.setDuration({{ ms("duration-base") }})
        self._collapse.setEasingCurve(theme.easing({{ "easing-standard" | tok }}))
        self._collapse.finished.connect(self._collapsed)
        theme.changed.connect(self.update)

    def _swipeable(self) -> bool:
        return self._dismissible and not self._leaving and in_touch_scope(self)

    def _slid(self, dx: float) -> None:
        self._card.move(round(dx), 0)
        if self._fade is None and abs(dx) >= 0.5:
            self._fade = QGraphicsOpacityEffect(self._card)
            self._card.setGraphicsEffect(self._fade)
        if self._fade is not None:
            self._fade.setOpacity(1 - min(1.0, abs(dx) / max(1, self.width())) * 0.6)
        self.update()

    def _settled(self) -> None:
        if self._leaving:
            self._collapse.setStartValue(self.height())
            self._collapse.setEndValue(0)
            if theme.pause_loops:
                self._collapsed()
            else:
                self._collapse.start()
        elif self._dx.value == 0:
            self._side = 0
            self._card.setGraphicsEffect(None)
            self._fade = None
            self.update()

    def _collapsed(self) -> None:
        self.hide()
        self.dismissed.emit()

    def resizeEvent(self, event) -> None:
        super().resizeEvent(event)
        if self._dx.value:
            self._card.move(round(self._dx.value), 0)

    def mousePressEvent(self, event) -> None:
        if event.button() != Qt.MouseButton.LeftButton or not self._swipeable():
            super().mousePressEvent(event)
            return
        self._origin = event.globalPosition()
        self._axis = None
        self._tracker.reset()
        self._tracker.add(event.globalPosition())

    def mouseMoveEvent(self, event) -> None:
        if self._origin is None:
            super().mouseMoveEvent(event)
            return
        delta = event.globalPosition() - self._origin
        self._tracker.add(event.globalPosition())
        if self._axis is None:
            if abs(delta.x()) < 10 and abs(delta.y()) < 10:
                return
            self._axis = "x" if abs(delta.x()) > abs(delta.y()) else "y"
        if self._axis != "x":
            return
        dx = delta.x()
        if dx:
            self._side = 1 if dx > 0 else -1
        armed = abs(dx) >= self.width() * COMMIT
        if armed != self._armed:
            self._armed = armed
            self._mark.to(1.15 if armed and not theme.pause_loops else 1.0)
        self._dx.set(dx)

    def mouseReleaseEvent(self, event) -> None:
        origin, axis, self._origin, self._axis = self._origin, self._axis, None, None
        if origin is None or axis != "x":
            super().mouseReleaseEvent(event)
            return
        dx = self._dx.value
        velocity = self._tracker.velocity().x() / 1000
        flick = abs(velocity) > 0.6 and (velocity > 0) == (dx > 0) and abs(dx) > 20
        if (self._armed or flick) and dx:
            self._leaving = True
            self._dx.to((1 if dx > 0 else -1) * self.width())
        else:
            self._armed = False
            self._mark.to(1.0)
            self._dx.to(0.0)

    def paintEvent(self, event) -> None:
        if not self._side:
            return
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(theme.color({{ "bgColor-neutral-muted" | tok }}))
        painter.drawRoundedRect(QRectF(self.rect()), RADIUS, RADIUS)
        # The close mark sits on the side the card has uncovered.
        cx = 16 + 16 if self._side > 0 else self.width() - 16 - 16
        cy = self.height() / 2
        scale = self._mark.value
        painter.save()
        painter.translate(cx, cy)
        painter.scale(scale, scale)
        if self._armed:
            disc = QPainterPath()
            disc.addEllipse(QPointF(0, 0), 16, 16)
            painter.fillPath(disc, theme.color({{ "bgColor-neutral-emphasis" | tok }}))
        ink = {{ "fgColor-onEmphasis" | tok }} if self._armed else {{ "fgColor-muted" | tok }}
        paint_icon(painter, QRectF(-8, -8, 16, 16), "x", theme.color(ink))
        painter.restore()
