<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="PmProgressBar" TargetType="ProgressBar">
    <Setter Property="Background" Value="{{ "controlTrack-bgColor-rest" | tok }}" />
    <Setter Property="Foreground" Value="{{ "bgColor-accent-emphasis" | tok }}" />
    <Setter Property="Height" Value="8" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Template">
      <ControlTemplate TargetType="ProgressBar">
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Panel>
            <!-- Width starts at 0, not NaN: a Width transition from NaN stays NaN and the fill never shows. -->
            <!-- The width eases on the kind's curve (set from code, over this sleepy default). -->
            <Border Name="PART_Indicator" Width="0" pm:PurrimerControlMotion.Role="progress" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}"
                    HorizontalAlignment="Left" IsVisible="{Binding !IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}">
              <Border.Transitions>
                <Transitions>
                  <DoubleTransition Property="Width" Duration="{{ "duration-slow" | tok }}" Easing="{{ "easing-sleepy-move" | tok }}" />
                </Transitions>
              </Border.Transitions>
            </Border>
            <Border Name="PART_IndeterminateIndicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"
                    CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="{Binding IsIndeterminate, RelativeSource={RelativeSource TemplatedParent}}" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:horizontal:indeterminate /template/ Border#PART_IndeterminateIndicator">
      <Style.Animations>
        <Animation Easing="LinearEasing" IterationCount="Infinite" Duration="0:0:1.4">
          <KeyFrame Cue="0%">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateStartingOffset}" />
          </KeyFrame>
          <KeyFrame Cue="100%">
            <Setter Property="TranslateTransform.X" Value="{Binding $parent[ProgressBar].TemplateSettings.IndeterminateEndingOffset}" />
          </KeyFrame>
        </Animation>
      </Style.Animations>
      <Setter Property="Width" Value="{Binding TemplateSettings.ContainerWidth, RelativeSource={RelativeSource TemplatedParent}}" />
    </Style>
    <Style Selector="^.success">
      <Setter Property="Foreground" Value="{{ "bgColor-success-emphasis" | tok }}" />
    </Style>
    <Style Selector="^.attention">
      <Setter Property="Foreground" Value="{{ "bgColor-attention-emphasis" | tok }}" />
    </Style>
    <Style Selector="^.danger">
      <Setter Property="Foreground" Value="{{ "bgColor-danger-emphasis" | tok }}" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar" BasedOn="{StaticResource PmProgressBar}" />
</ResourceDictionary>
