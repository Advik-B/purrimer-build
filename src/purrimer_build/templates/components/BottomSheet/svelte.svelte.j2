<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<script lang="ts">
  import type { Snippet } from "svelte";
  import Icon from "./Icon.svelte";
  import { Spring, VelocityTracker, buzz, motionKind, reducedMotion, rubberBand, springs } from "../motion";

  let {
    open = $bindable(false),
    title = "",
    description = "",
    icon = "",
    tone = "accent",
    size = "auto",
    dismissible = true,
    grabber = true,
    inline = false,
    ariaLabel = "",
    onclose,
    children,
    actions,
  }: {
    open?: boolean;
    title?: string;
    description?: string;
    icon?: string;
    tone?: "accent" | "info" | "success" | "attention" | "danger" | "neutral";
    size?: "auto" | "half" | "full";
    dismissible?: boolean;
    grabber?: boolean;
    inline?: boolean;
    ariaLabel?: string;
    onclose?: () => void;
    children?: Snippet;
    actions?: Snippet;
  } = $props();

  const DISMISS = 96;
  const FLICK = 600;
  const titleId = `pm-sheet-${Math.random().toString(36).slice(2)}`;

  let phase: "closed" | "open" | "closing" = $state("closed");
  let offset = $state(0);
  let sprung = $state(false);
  let dragging = $state(false);
  let sheet: HTMLElement | undefined = $state();
  let lastFocus: HTMLElement | null = null;
  let grab: { y: number; base: number; id: number; armed: boolean } | null = null;
  let release = 0;
  let timer = 0;
  const tracker = new VelocityTracker();
  const spring = new Spring(0, (v) => (offset = v), springs.sleepy, 0.5);

  const height = () => sheet?.offsetHeight || 400;

  function finish() {
    phase = "closed";
    sprung = false;
    spring.set(0);
    lastFocus?.focus({ preventScroll: true });
    lastFocus = null;
  }

  $effect(() => {
    if (inline) return;
    if (open && phase !== "open") {
      clearTimeout(timer);
      spring.stop();
      lastFocus = document.activeElement as HTMLElement | null;
      sprung = false;
      offset = 0;
      phase = "open";
    } else if (!open && phase === "open") {
      phase = "closing";
      if (sprung) {
        spring.config = springs[motionKind(sheet ?? null)];
        spring.to(height(), release);
        spring.onSettleOnce(finish);
      } else {
        timer = window.setTimeout(finish, reducedMotion() ? {{ ms("duration-reduced") }} : {{ ms("duration-sleepy-exit") }});
      }
    }
  });

  $effect(() => {
    if (phase === "open" && sheet) sheet.focus({ preventScroll: true });
  });

  function close() {
    if (!dismissible || !open) return;
    open = false;
    onclose?.();
  }

  function down(e: PointerEvent) {
    if (!dismissible || e.button > 0) return;
    spring.stop();
    grab = { y: e.clientY, base: sprung ? offset : 0, id: e.pointerId, armed: false };
    tracker.reset();
    tracker.add(0, e.clientY);
    (e.currentTarget as HTMLElement).setPointerCapture(e.pointerId);
  }

  function move(e: PointerEvent) {
    if (!grab || grab.id !== e.pointerId) return;
    tracker.add(0, e.clientY);
    let next = grab.base + e.clientY - grab.y;
    if (!dragging && Math.abs(next - grab.base) < 2) return;
    dragging = true;
    sprung = true;
    if (next < 0) next = rubberBand(next, height());
    if (next > DISMISS !== grab.armed) {
      grab.armed = next > DISMISS;
      if (grab.armed) buzz();
    }
    spring.set(next);
  }

  function up(e: PointerEvent) {
    if (!grab || grab.id !== e.pointerId) return;
    grab = null;
    const velocity = tracker.velocity().y;
    const wasDragging = dragging;
    dragging = false;
    if (!wasDragging) return;
    spring.config = springs[motionKind(sheet ?? null)];
    if (offset > DISMISS || (offset > 24 && velocity > FLICK)) {
      release = velocity;
      close();
      if (open) spring.to(0, velocity);
    } else {
      spring.to(0, velocity);
    }
  }

  function onkeydown(e: KeyboardEvent) {
    if (e.key === "Escape") {
      e.stopPropagation();
      close();
    }
  }
</script>

{#snippet content()}
  <!-- The drag handle is a pointer-only affordance; Escape and the scrim close the sheet from the keyboard. -->
  <!-- svelte-ignore a11y_no_static_element_interactions -->
  <div
    class={["pm-sheet__handle", dismissible && !inline && "pm-sheet__handle--drag"]}
    onpointerdown={inline ? undefined : down}
    onpointermove={inline ? undefined : move}
    onpointerup={inline ? undefined : up}
    onpointercancel={inline ? undefined : up}
  >
    {#if grabber}<span class="pm-sheet__grabber" aria-hidden="true"></span>{/if}
    {#if title}
      <div class="pm-sheet__head">
        {#if icon}
          <div class="pm-sheet__title-row">
            <span class={["pm-sheet__tile", `pm-sheet__tile--${tone}`]} aria-hidden="true"><Icon name={icon} /></span>
            <h2 class="pm-sheet__title" id={titleId}>{title}</h2>
          </div>
        {:else}
          <h2 class="pm-sheet__title" id={titleId}>{title}</h2>
        {/if}
        {#if description}<p class="pm-sheet__desc">{description}</p>{/if}
      </div>
    {/if}
  </div>
  <div class="pm-sheet__body">{@render children?.()}</div>
  {#if actions}<div class="pm-sheet__actions">{@render actions()}</div>{/if}
{/snippet}

{#if inline}
  <div class={["pm-sheet", "pm-sheet--inline", size !== "auto" && `pm-sheet--${size}`]} role="dialog" aria-labelledby={title ? titleId : undefined} aria-label={title ? undefined : ariaLabel || undefined}>
    {@render content()}
  </div>
{:else if phase !== "closed"}
  <div class={["pm-sheet-layer", phase === "closing" && "pm-sheet-layer--closing"]}>
    <!-- svelte-ignore a11y_click_events_have_key_events, a11y_no_static_element_interactions -->
    <div class="pm-sheet-scrim" aria-hidden="true" style:opacity={sprung ? Math.max(0, 1 - offset / height()) : undefined} onclick={close}></div>
    <div
      bind:this={sheet}
      class={["pm-sheet", size !== "auto" && `pm-sheet--${size}`, sprung && "pm-sheet--sprung", dragging && "pm-sheet--dragging"]}
      role="dialog"
      aria-modal="true"
      aria-labelledby={title ? titleId : undefined}
      aria-label={title ? undefined : ariaLabel || undefined}
      tabindex="-1"
      style:translate={sprung ? `0 ${offset}px` : undefined}
      {onkeydown}
    >
      {@render content()}
    </div>
  </div>
{/if}
