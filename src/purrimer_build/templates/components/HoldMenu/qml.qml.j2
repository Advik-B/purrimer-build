// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Effects

// Press and hold the child button to open more options around it, slide onto one and release to choose it; a plain
// tap still does the button's own job, or opens the menu with tapOpens. Moving 10px before the hold completes gives the
// press back. Releasing on the button keeps the menu open for tapping. Right-click, the Menu key, Shift+F10 and the
// arrow towards the menu open it for the keyboard; arrows move between options, Enter chooses and Escape closes.
Item {
    id: root
    // [{ label, icon, variant?: "danger", disabled? }]; item 0 sits nearest the button.
    property var items: []
    // "stack": labelled options in a column. "arc": two to four icon-only options fanned around a corner button.
    property string layout: "stack"
    property string direction: "up"
    property string align: "end"
    property bool tapOpens: false
    property int holdDelay: {{ "duration-hold" | tok }}
    property real radius: 0
    property string hint: "Slide to choose"
    property string accessibleName: "More options"
    property bool defaultOpen: false
    // "", "held" while the finger is still down, or "sticky" for tapping and the keyboard.
    property string mode: ""
    property int active: -1
    default property alias content: slot.data
    // A button elsewhere to attach to instead of the child, as FAB does with its actions.
    property Item target: null
    readonly property Item trigger: target ? target : slot.children.length > 0 ? slot.children[0] : null
    // The trigger untyped, so any button's clicked signal can be reached.
    readonly property var button: trigger
    readonly property real arcRadius: radius > 0 ? radius : Math.max(96, 72 + items.length * 12)
    property rect triggerRect
    property point origin
    property bool pressing: false
    signal selected(int index)

    implicitWidth: trigger ? trigger.implicitWidth : 0
    implicitHeight: trigger ? trigger.implicitHeight : 0

    function firstEnabled() {
        for (let i = 0; i < items.length; i++)
            if (!items[i].disabled)
                return i
        return -1
    }

    function open(next) {
        if (mode !== "" || items.length === 0 || !trigger || !trigger.enabled)
            return
        triggerRect = trigger.mapToItem(menuLayer, 0, 0, trigger.width, trigger.height)
        active = next === "sticky" ? firstEnabled() : -1
        mode = next
        if (next === "sticky")
            menuLayer.forceActiveFocus()
    }

    function close(refocus) {
        mode = ""
        active = -1
        if (refocus && trigger)
            trigger.forceActiveFocus()
    }

    function choose(i) {
        if (i < 0 || i >= items.length || items[i].disabled)
            return
        close(true)
        selected(i)
    }

    function itemAt(x, y) {
        let best = -1
        let bestDist = Infinity
        for (let i = 0; i < options.count; i++) {
            const option = options.itemAt(i)
            if (!option || root.items[i].disabled)
                continue
            const dx = Math.max(option.x - x, 0, x - option.x - option.width)
            const dy = Math.max(option.y - y, 0, y - option.y - option.height)
            const dist = Math.hypot(dx, dy)
            if (dist < bestDist) {
                best = i
                bestDist = dist
            }
        }
        return bestDist <= 24 ? best : -1
    }

    function angleOf(i) {
        const n = items.length
        const from = direction === "down" ? 270 : 90
        const to = direction === "down" ? (align === "end" ? 180 : 360) : (align === "end" ? 180 : 0)
        return (n === 1 ? from : from + (to - from) * i / (n - 1)) * Math.PI / 180
    }

    function step(delta) {
        const enabled = []
        for (let i = 0; i < items.length; i++)
            if (!items[i].disabled)
                enabled.push(i)
        if (enabled.length === 0)
            return
        const at = enabled.indexOf(active)
        active = enabled[(at + delta + enabled.length) % enabled.length]
    }

    Component.onCompleted: {
        if (button && button.clicked)
            button.clicked.connect(() => {
                if (root.tapOpens && root.mode === "")
                    root.open("sticky")
            })
        if (defaultOpen)
            openWhenShown.start()
    }

    // The trigger only has its final place once the window is showing.
    Timer {
        id: openWhenShown
        interval: 16
        repeat: true
        onTriggered: {
            if (root.Window.window && root.Window.window.visible && root.width > 0) {
                stop()
                root.open("sticky")
            }
        }
    }

    Item {
        id: slot
        anchors.fill: parent
    }

    Timer {
        id: hold
        interval: root.holdDelay
        onTriggered: {
            // Disabling the button for a moment drops its press, so releasing over it won't click it.
            root.trigger.enabled = false
            root.trigger.enabled = true
            root.open("held")
        }
    }

    // Sits on the button so it sees the press before the button takes it; it only watches, so the button still works.
    PointHandler {
        id: tracker
        parent: root.trigger
        acceptedButtons: Qt.LeftButton
        onActiveChanged: {
            if (active && root.mode === "") {
                root.origin = point.scenePosition
                root.pressing = true
                hold.restart()
            } else if (!active && root.pressing) {
                root.pressing = false
                if (hold.running) {
                    hold.stop()
                    return
                }
                if (root.mode !== "held")
                    return
                const p = menuLayer.mapFromItem(null, point.scenePosition.x, point.scenePosition.y)
                const i = root.itemAt(p.x, p.y)
                const t = root.triggerRect
                if (i >= 0) {
                    root.choose(i)
                } else if (p.x >= t.x && p.x <= t.x + t.width && p.y >= t.y && p.y <= t.y + t.height) {
                    root.mode = "sticky"
                    root.active = root.firstEnabled()
                    menuLayer.forceActiveFocus()
                } else {
                    root.close(false)
                }
            }
        }
        onPointChanged: {
            if (!root.pressing)
                return
            if (hold.running) {
                if (Math.abs(point.scenePosition.x - root.origin.x) > 10 || Math.abs(point.scenePosition.y - root.origin.y) > 10) {
                    hold.stop()
                    root.pressing = false
                }
            } else if (root.mode === "held") {
                const p = menuLayer.mapFromItem(null, point.scenePosition.x, point.scenePosition.y)
                root.active = root.itemAt(p.x, p.y)
            }
        }
    }

    TapHandler {
        parent: root.trigger
        acceptedButtons: Qt.RightButton
        onTapped: root.open("sticky")
    }

    Keys.onPressed: (event) => {
        const towards = root.direction === "up" ? Qt.Key_Up : Qt.Key_Down
        if (root.mode === "" && (event.key === towards || event.key === Qt.Key_Menu || (event.key === Qt.Key_F10 && (event.modifiers & Qt.ShiftModifier)))) {
            root.open("sticky")
            event.accepted = true
        }
    }

    FocusScope {
        id: menuLayer
        parent: root.Window.window ? root.Window.window.contentItem : root
        anchors.fill: parent
        z: 1000
        visible: root.mode !== ""
        onWidthChanged: if (root.mode !== "") root.triggerRect = root.trigger.mapToItem(menuLayer, 0, 0, root.trigger.width, root.trigger.height)
        onHeightChanged: if (root.mode !== "") root.triggerRect = root.trigger.mapToItem(menuLayer, 0, 0, root.trigger.width, root.trigger.height)
        Accessible.role: Accessible.PopupMenu
        Accessible.name: root.accessibleName

        Keys.onPressed: (event) => {
            const outward = root.direction === "up" ? Qt.Key_Up : Qt.Key_Down
            const inward = root.direction === "up" ? Qt.Key_Down : Qt.Key_Up
            const away = root.align === "end" ? Qt.Key_Left : Qt.Key_Right
            const back = root.align === "end" ? Qt.Key_Right : Qt.Key_Left
            if (event.key === outward || (root.layout === "arc" && event.key === away))
                root.step(1)
            else if (event.key === inward || (root.layout === "arc" && event.key === back))
                root.step(-1)
            else if ((event.key === Qt.Key_Return || event.key === Qt.Key_Enter || event.key === Qt.Key_Space) && root.active >= 0)
                root.choose(root.active)
            else if (event.key === Qt.Key_Escape)
                root.close(true)
            else if (event.key === Qt.Key_Tab || event.key === Qt.Key_Backtab)
                root.close(false)
            else
                return
            event.accepted = true
        }

        Rectangle {
            anchors.fill: parent
            color: {{ "overlay-backdrop-bgColor" | tok }}
            opacity: root.mode !== "" ? 1 : 0
            Behavior on opacity { NumberAnimation { duration: {{ "duration-base" | tok }} } }
            MouseArea {
                anchors.fill: parent
                onClicked: root.close(true)
            }
        }

        // The button stays visible above the scrim.
        ShaderEffectSource {
            x: root.triggerRect.x
            y: root.triggerRect.y
            width: root.triggerRect.width
            height: root.triggerRect.height
            sourceItem: root.mode !== "" ? root.trigger : null
            live: true
        }

        Repeater {
            id: options
            model: root.mode !== "" ? root.items : []

            Item {
                id: option
                required property var modelData
                required property int index
                readonly property bool on: root.active === index
                readonly property bool danger: modelData.variant === "danger"
                readonly property bool arc: root.layout === "arc"
                readonly property real gap: 8
                readonly property real distance: 12 + index * (48 + gap)
                width: arc ? 48 : label.width + 12 + 48
                height: 48
                x: arc ? root.triggerRect.x + root.triggerRect.width / 2 + Math.cos(root.angleOf(index)) * root.arcRadius - 24
                   : Math.max(8, Math.min(root.align === "end" ? root.triggerRect.x + root.triggerRect.width - width : root.triggerRect.x, menuLayer.width - width - 8))
                y: arc ? root.triggerRect.y + root.triggerRect.height / 2 - Math.sin(root.angleOf(index)) * root.arcRadius - 24
                   : Math.max(8, Math.min(menuLayer.height - 56, root.direction === "up" ? root.triggerRect.y - distance - 48 : root.triggerRect.y + root.triggerRect.height + distance))
                Accessible.role: Accessible.MenuItem
                Accessible.name: modelData.label
                Accessible.onPressAction: root.choose(index)

                property real enter: Purrimer.pauseLoops ? 1 : 0
                opacity: enter
                transform: Translate {
                    x: option.arc ? (1 - option.enter) * (root.triggerRect.x + root.triggerRect.width / 2 - option.x - 24) : 0
                    y: option.arc ? (1 - option.enter) * (root.triggerRect.y + root.triggerRect.height / 2 - option.y - 24) : (1 - option.enter) * 8
                }
                SequentialAnimation on enter {
                    running: !Purrimer.pauseLoops
                    PauseAnimation { duration: Purrimer.pauseLoops ? 0 : option.index * 30 }
                    NumberAnimation { from: 0; to: 1; duration: Purrimer.pauseLoops ? 0 : {{ "duration-base" | tok }}; easing.type: Easing.OutCubic }
                }

                Rectangle {
                    id: label
                    visible: !option.arc
                    x: root.align === "end" ? 0 : parent.width - width
                    anchors.verticalCenter: parent.verticalCenter
                    width: text.implicitWidth + 24
                    height: 32
                    radius: {{ "borderRadius-medium" | tok }}
                    color: {{ "overlay-bgColor" | tok }}
                    border.width: {{ "borderWidth-thin" | tok }}
                    border.color: option.on ? {{ "borderColor-accent-emphasis" | tok }} : {{ "borderColor-default" | tok }}
                    Text {
                        id: text
                        anchors.centerIn: parent
                        text: option.modelData.label
                        font.family: {{ "text-body-medium" | tok }}.family
                        font.pixelSize: 14
                        font.weight: Font.DemiBold
                        color: option.modelData.disabled ? {{ "fgColor-disabled" | tok }} : {{ "fgColor-default" | tok }}
                    }
                }

                Item {
                    id: tile
                    x: option.arc || root.align === "end" ? parent.width - 48 : 0
                    width: 48
                    height: 48
                    scale: option.on && !Purrimer.pauseLoops ? (option.arc ? 1.14 : 1.08) : 1
                    Behavior on scale { SpringAnimation { spring: 4; damping: 0.3; epsilon: 0.001 } }

                    RectangularShadow {
                        anchors.fill: body
                        visible: !option.on
                        readonly property var key: {{ "shadow-floating-small" | tok }}[0]
                        offset.y: key ? key.y : 2
                        blur: key ? key.blur : 8
                        color: key ? key.color : "transparent"
                        radius: body.radius
                    }
                    Rectangle {
                        id: body
                        anchors.fill: parent
                        radius: {{ "borderRadius-large" | tok }} * 1.2
                        color: option.on ? (option.danger ? {{ "bgColor-danger-emphasis" | tok }} : {{ "button-primary-bgColor-rest" | tok }}) : {{ "overlay-bgColor" | tok }}
                        border.width: option.on ? 0 : {{ "borderWidth-thin" | tok }}
                        border.color: {{ "borderColor-default" | tok }}
                    }
                    Icon {
                        anchors.centerIn: parent
                        name: option.modelData.icon
                        size: 24
                        color: option.modelData.disabled ? {{ "fgColor-disabled" | tok }} : option.on ? {{ "fgColor-onEmphasis" | tok }}
                               : option.danger ? {{ "fgColor-danger" | tok }} : {{ "fgColor-accent" | tok }}
                    }
                    Rectangle {
                        visible: menuLayer.activeFocus && root.mode === "sticky" && option.on
                        anchors.fill: parent
                        anchors.margins: -4
                        radius: body.radius + 4
                        color: "transparent"
                        border.width: {{ "borderWidth-thick" | tok }}
                        border.color: {{ "focus-outlineColor" | tok }}
                    }
                }

                MouseArea {
                    anchors.fill: parent
                    enabled: root.mode === "sticky" && !option.modelData.disabled
                    onClicked: root.choose(option.index)
                }
            }
        }

        Rectangle {
            visible: root.layout === "arc"
            readonly property real centerY: root.triggerRect.y + root.triggerRect.height / 2
            x: Math.max(8, Math.min(root.align === "end" ? root.triggerRect.x + root.triggerRect.width - width : root.triggerRect.x, menuLayer.width - width - 8))
            y: root.direction === "up" ? centerY - root.arcRadius - 36 - height : centerY + root.arcRadius + 36
            width: hintText.implicitWidth + 24
            height: 32
            radius: {{ "borderRadius-medium" | tok }}
            color: {{ "bgColor-emphasis" | tok }}
            Text {
                id: hintText
                anchors.centerIn: parent
                text: root.active >= 0 && root.active < root.items.length ? root.items[root.active].label : root.hint
                font.family: {{ "text-body-medium" | tok }}.family
                font.pixelSize: 14
                font.weight: Font.DemiBold
                color: {{ "fgColor-onEmphasis" | tok }}
            }
        }
    }
}
