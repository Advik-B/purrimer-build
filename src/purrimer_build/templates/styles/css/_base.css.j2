{## Fonts, token custom properties and themes, shared by purrimer.css and purrimer-classless.css. ##}
{% for f in web_fonts %}
@font-face {
  font-family: "{{ f.family }}";
  src: url("{{ font_prefix }}{{ f.filename }}") format("woff2");
  font-weight: {{ f.weight }};
  font-style: {{ f.style }};
  font-display: swap;
}

{% endfor %}
:root {
{% for n, v in tokens.lengths_css + tokens.durations_css + tokens.easings_css + tokens.other_css %}
  --{{ n }}: {{ v }};
{% endfor %}
{% for key, stack in tokens.families.items() %}
  --font-{{ key }}: {{ stack }};
{% endfor %}
}

{% for theme in themes %}
{% if loop.first %}
:root,
[data-theme="{{ theme }}"] {
{% else %}
[data-theme="{{ theme }}"] {
{% endif %}
  color-scheme: {{ "dark" if theme in tokens.dark_themes else "light" }};
{% for name in tokens.colors %}
  --{{ name }}: {{ tokens.css_color(name, theme) }};
{% endfor %}
{% for name in tokens.shadow_css %}
  --{{ name }}: {{ tokens.shadow_css[name][theme] }};
{% endfor %}
}

{% endfor %}
@media (prefers-reduced-motion: reduce) {
  :root {
{% for n, _ in tokens.durations_css if n != "duration-reduced" %}
    --{{ n }}: var(--duration-reduced);
{% endfor %}
  }
}

/* Motion kinds. Sleepy is the default; data-motion="playful" on any element switches its subtree. Loop values are
   written out rather than read from the duration tokens, because reduced motion shortens those tokens. The pose
   values size the resting snapshot a looping animation shows when animations are off, so reduced motion leaves them
   alone. Touch feedback: surfaces compress to --pm-press-scale while held, spring back over --pm-release-*, and
   settle after a drag over --pm-settle-*. */
{% set kinds = {
  "sleepy": {"loop": ms("duration-sleepy-loop"), "spin": ms("duration-sleepy-loop") * 0.4, "dots": ms("duration-sleepy-loop") * 0.45, "dist": 8, "peak": 1.03, "wave": "easing-sleepy-drift", "dash": "none",
             "release": ("duration-sleepy-short", "easing-sleepy-enter"), "settle": ("duration-slow", "easing-sleepy-move")},
  "playful": {"loop": ms("duration-playful-loop"), "spin": ms("duration-playful-loop") * 0.6, "dots": ms("duration-playful-loop") * 0.7, "dist": 18, "peak": 1.14, "wave": "easing-playful-snap", "dash": "pm-chase-dash",
              "release": ("duration-playful-press", "easing-playful-pop"), "settle": ("duration-playful-medium", "easing-playful-spring")},
} %}
{% macro motion_vars(k, dist=None, pose=True) %}
  --pm-m-loop: {{ k.loop | num }}ms;
  --pm-m-spin-dur: {{ k.spin | num }}ms;
  --pm-m-dots-dur: {{ k.dots | num }}ms;
  --pm-m-dist: {{ (k.dist if dist is none else dist) | num }}px;
  --pm-m-peak: {{ (k.peak if dist is none else 1) | num }};
  --pm-m-wave: var(--{{ k.wave }});
  --pm-m-dash: {{ k.dash }};
  --pm-press-scale: {{ 0.96 if pose else 1 }};
  --pm-release-dur: var(--{{ k.release[0] }});
  --pm-release-ease: var(--{{ k.release[1] }});
  --pm-settle-dur: var(--{{ k.settle[0] }});
  --pm-settle-ease: var(--{{ k.settle[1] }});
{% if pose %}
  --pm-m-pose-dist: {{ k.dist | num }}px;
  --pm-m-pose-peak: {{ k.peak | num }};
{% endif %}
{% endmacro %}
:root,
[data-motion="sleepy"] {
  {{ motion_vars(kinds.sleepy) | trim }}
}

[data-motion="playful"] {
  {{ motion_vars(kinds.playful) | trim }}
}

/* Reduced motion: playful falls back to sleepy, and sleepy keeps its fades but drops movement. */
@media (prefers-reduced-motion: reduce) {
  :root,
  [data-motion="sleepy"] {
    {{ motion_vars(kinds.sleepy, 0, False) | trim | indent(2) }}
  }

  [data-motion="playful"] {
    {{ motion_vars(kinds.sleepy, None, False) | trim | indent(2) }}
  }
}

@keyframes pm-fade-in {
  from { opacity: 0; }
}

@keyframes pm-fade-out {
  to { opacity: 0; }
}

@keyframes pm-chase {
  from { rotate: 0deg; }
  to { rotate: 360deg; }
}

@keyframes pm-chase-dash {
  0% { stroke-dasharray: 8 100; stroke-dashoffset: 0; }
  50% { stroke-dasharray: 60 100; stroke-dashoffset: -16; }
  100% { stroke-dasharray: 8 100; stroke-dashoffset: -92; }
}
