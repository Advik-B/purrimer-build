// {{ note }}
// {{ c.summary }}
// Sleepy types 62ms a character and pauses after punctuation; playful types 28ms with a little jitter. Screen readers
// hear the whole text at once.
import QtQuick

Item {
    id: root

    property string text: ""
    // ms per character; 0 uses 62 sleepy, 28 playful.
    property int speed: 0
    property int delay: 0
    // "true" hides the caret when done, "always" keeps it blinking, "false" never shows it.
    property string caret: "true"
    // mount or inView
    property string trigger: "mount"
    // Empty follows the scope.
    property string kind: ""
    // Change it to type again.
    property int replay: 0
    property font font: Purrimer.textBodyMedium
    property color color: {{ "fgColor-default" | tok }}
    signal done()

    property int count: 0
    readonly property string effective: Purrimer.effectiveKind(root, root.kind)
    // Everything shows at once while loops are paused or motion is reduced, whenever that is switched on.
    readonly property int shown: Purrimer.pauseLoops || effective === "still" ? text.length : count
    readonly property bool finished: shown >= text.length

    implicitWidth: full.implicitWidth + 4
    implicitHeight: full.implicitHeight
    Accessible.role: Accessible.StaticText
    Accessible.name: text

    function start() {
        step.stop()
        if (Purrimer.pauseLoops || effective === "still") {
            count = text.length
            done()
            return
        }
        count = 0
        step.interval = Math.max(1, delay)
        step.start()
    }

    Component.onCompleted: if (trigger === "mount") start()
    onReplayChanged: start()
    onTextChanged: start()

    Timer {
        id: step
        onTriggered: {
            root.count += 1
            if (root.count >= root.text.length) {
                root.done()
                return
            }
            const base = root.speed > 0 ? root.speed : (root.effective === "playful" ? 28 : 62)
            const playful = root.effective === "playful"
            const pause = ".,;:!?".indexOf(root.text.charAt(root.count - 1)) >= 0 ? base * (playful ? 4 : 6) : 0
            interval = Math.round(base + pause + (playful ? Math.random() * base : 0))
            start()
        }
    }

    Timer {
        interval: 100
        repeat: true
        running: root.trigger === "inView" && root.count === 0 && !step.running
        onTriggered: {
            const w = root.Window.window
            if (!w || !root.visible)
                return
            const p = root.mapToItem(null, 0, 0)
            if (p.x < w.width && p.y < w.height && p.x + root.width > 0 && p.y + root.height > 0)
                root.start()
        }
    }

    // Sizes the item for the whole line, so layout does not move while it types.
    Text {
        id: full
        visible: false
        text: root.text
        font: root.font
    }

    Text {
        id: typed
        text: root.text.substring(0, root.shown)
        font: root.font
        color: root.color
        Accessible.ignored: true
    }

    TextMetrics {
        id: typedWidth
        font: root.font
        text: typed.text
    }

    Rectangle {
        visible: root.caret !== "false" && (!root.finished || root.caret === "always")
        x: typedWidth.advanceWidth + 1
        width: 2
        height: typed.contentHeight * 1.1 / 1.2
        y: (typed.contentHeight - height) / 2
        radius: 1
        color: {{ "fgColor-accent" | tok }}

        SequentialAnimation on opacity {
            running: !Purrimer.pauseLoops
            loops: Animation.Infinite
            PropertyAction { value: 1 }
            PauseAnimation { duration: (root.effective === "playful" ? {{ ms("duration-playful-loop") }} : {{ ms("duration-sleepy-loop") }}) * 0.15 }
            PropertyAction { value: 0 }
            PauseAnimation { duration: (root.effective === "playful" ? {{ ms("duration-playful-loop") }} : {{ ms("duration-sleepy-loop") }}) * 0.15 }
        }
    }
}
