from __future__ import annotations

from PySide6.QtCore import QEvent, QObject, QRectF, Qt, Signal
from PySide6.QtGui import QPainter, QPen
from PySide6.QtWidgets import QFrame, QHBoxLayout, QLabel, QPlainTextEdit, QVBoxLayout, QWidget

from ..theme import theme
from .icon import Icon


class _Box(QWidget):
    """The field's frame: Purrimer draws the border, the fill and the focus ring around a bare text editor."""

    def __init__(self, owner: Textarea) -> None:
        super().__init__(owner)
        self._owner = owner
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, False)

    def paintEvent(self, event) -> None:
        owner = self._owner
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        enabled = owner.isEnabled()
        focused = owner.edit.hasFocus()
        if not enabled:
            fill, border, width = {{ "bgColor-disabled" | tok }}, {{ "borderColor-default" | tok }}, 1
        elif focused:
            fill, border, width = {{ "control-bgColor-rest" | tok }}, {{ "focus-outlineColor" | tok }}, 2
        elif owner.error():
            fill, border, width = {{ "control-bgColor-rest" | tok }}, {{ "borderColor-danger-emphasis" | tok }}, 1
        else:
            fill, border, width = {{ "control-bgColor-rest" | tok }}, {{ "control-borderColor-rest" | tok }}, 1
        radius = {{ px("borderRadius-medium") | num }}
        rect = QRectF(self.rect()).adjusted(width / 2, width / 2, -width / 2, -width / 2)
        painter.setPen(QPen(theme.color(border), width))
        painter.setBrush(theme.color(fill))
        painter.drawRoundedRect(rect, radius - width / 2, radius - width / 2)


class Textarea(QWidget):
    """A multi-line text editor with a label above and a caption or error below."""

    textChanged = Signal(str)

    def __init__(self, label: str = "", text: str = "", placeholder: str = "", caption: str = "", error: str = "",
                 rows: int = {{ c.spec.props.rows.default }}, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(4)
        self.label = QLabel(label)
        font = theme.font({{ "text-body-medium" | tok }})
        font.setBold(True)
        self.label.setFont(font)
        self.label.setVisible(bool(label))
        self.box = _Box(self)
        box_layout = QVBoxLayout(self.box)
        box_layout.setContentsMargins(8, 5, 8, 5)
        self.edit = QPlainTextEdit(text)
        self.edit.setFrameShape(QFrame.Shape.NoFrame)
        self.edit.setStyleSheet("QPlainTextEdit { background: transparent; border: none; padding: 0; }")
        self.edit.document().setDocumentMargin(0)
        self.edit.setPlaceholderText(placeholder)
        self.edit.setAccessibleName(label)
        self.edit.setTabChangesFocus(True)
        self.edit.installEventFilter(self)
        box_layout.addWidget(self.edit)
        self.box.setMinimumHeight(max(80, rows * 20 + 12))
        self.label.setBuddy(self.edit)
        row = QHBoxLayout()
        row.setContentsMargins(0, 0, 0, 0)
        row.setSpacing(4)
        self._error_icon = Icon("alert-fill", 12, {{ "fgColor-danger" | tok }})
        self.message = QLabel()
        self.message.setProperty("textStyle", "caption")
        self.message.setWordWrap(True)
        row.addWidget(self._error_icon)
        row.addWidget(self.message, 1)
        layout.addWidget(self.label)
        layout.addWidget(self.box, 1)
        layout.addLayout(row)
        self._caption = caption
        self._error = error
        self.edit.textChanged.connect(lambda: self.textChanged.emit(self.edit.toPlainText()))
        theme.changed.connect(self.box.update)
        self._refresh_message()

    def eventFilter(self, watched: QObject, event: QEvent) -> bool:
        if watched is self.edit and event.type() in (QEvent.Type.FocusIn, QEvent.Type.FocusOut):
            self.box.update()
        return super().eventFilter(watched, event)

    def changeEvent(self, event: QEvent) -> None:
        super().changeEvent(event)
        if event.type() == QEvent.Type.EnabledChange:
            self.box.update()

    def text(self) -> str:
        return self.edit.toPlainText()

    def set_text(self, text: str) -> None:
        self.edit.setPlainText(text)

    def error(self) -> str:
        return self._error

    def set_caption(self, caption: str) -> None:
        self._caption = caption
        self._refresh_message()

    def set_error(self, error: str) -> None:
        self._error = error
        self._refresh_message()

    def _refresh_message(self) -> None:
        invalid = bool(self._error)
        self.message.setText(self._error or self._caption)
        self.message.setProperty("role", "danger" if invalid else "muted")
        self.message.style().unpolish(self.message)
        self.message.style().polish(self.message)
        self.message.setVisible(bool(self._error or self._caption))
        self._error_icon.setVisible(invalid)
        self.box.update()
