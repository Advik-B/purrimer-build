// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Templates as T
import QtQuick.Effects
import "PmMotion.js" as PmMotion

T.Popup {
    id: control
    property string title
    default property alias content: body.data
    property alias footer: footerRow.data
    // sleepy or playful; empty follows Purrimer.motionKind (a popup sits in the overlay, outside any MotionScope).
    property string kind: ""

    // The dialog choreography: rise when sleepy, pounce when playful; dialog-out when it closes.
    readonly property string effectiveKind: Purrimer.effectiveKind(control, control.kind)
    property string motionName: "dialog"
    property real motionProgress: 1
    readonly property var frame: Purrimer.pauseLoops ? PmMotion.rest() : PmMotion.sample(motionName, effectiveKind, motionProgress)

    parent: T.Overlay.overlay
    modal: true
    dim: true
    anchors.centerIn: parent
    width: parent ? Math.min(parent.width - 2 * {{ "mobile-gutter" | tok }}, 440) : 440
    padding: 0
    // T.Popup leaves its implicit size to the style; without this the dialog is 0 high.
    implicitHeight: contentItem.implicitHeight
    closePolicy: T.Popup.CloseOnEscape | T.Popup.CloseOnPressOutside

    // The backdrop fades on its own curve: in over the kind's short duration, out over its exit.
    T.Overlay.modal: Rectangle {
        color: {{ "overlay-backdrop-bgColor" | tok }}
        opacity: Purrimer.pauseLoops ? 1 : PmMotion.sample(control.motionName === "dialog" ? "backdrop" : "backdrop-out", control.effectiveKind,
            Math.min(1, control.motionProgress * PmMotion.entry(control.motionName, control.effectiveKind).dur / PmMotion.entry(control.motionName === "dialog" ? "backdrop" : "backdrop-out", control.effectiveKind).dur)).opacity
    }

    opacity: frame.opacity
    scale: frame.sx

    enter: Transition {
        SequentialAnimation {
            PropertyAction { target: control; property: "motionName"; value: "dialog" }
            NumberAnimation {
                target: control
                property: "motionProgress"
                from: 0
                to: 1
                duration: Purrimer.pauseLoops ? 0 : PmMotion.entry("dialog", control.effectiveKind).dur
            }
        }
    }
    exit: Transition {
        SequentialAnimation {
            PropertyAction { target: control; property: "motionName"; value: "dialog-out" }
            NumberAnimation {
                target: control
                property: "motionProgress"
                from: 0
                to: 1
                duration: Purrimer.pauseLoops ? 0 : PmMotion.entry("dialog-out", control.effectiveKind).dur
            }
        }
    }

    background: Rectangle {
        transform: Translate { x: control.frame.tx; y: control.frame.ty }
        radius: {{ "borderRadius-large" | tok }}
        color: {{ "overlay-bgColor" | tok }}
        border.width: {{ "borderWidth-thin" | tok }}
        border.color: {{ "borderColor-default" | tok }}
        RectangularShadow {
            readonly property var key: {{ "shadow-floating-large" | tok }}[0]
            anchors.fill: parent
            z: -1
            radius: parent.radius
            offset.x: key.x
            offset.y: key.y
            blur: key.blur
            spread: key.spread
            color: key.color
        }
    }

    contentItem: Column {
        transform: Translate { x: control.frame.tx; y: control.frame.ty }
        Item {
            width: parent.width
            height: 48
            Text {
                x: 16
                width: parent.width - 64
                anchors.verticalCenter: parent.verticalCenter
                text: control.title
                elide: Text.ElideRight
                font: {{ "text-title-medium" | tok }}
                color: {{ "fgColor-default" | tok }}
            }
            IconButton {
                anchors.right: parent.right
                anchors.rightMargin: 8
                anchors.verticalCenter: parent.verticalCenter
                iconName: "x"
                label: "Close"
                variant: "invisible"
                onClicked: control.close()
            }
            Rectangle { anchors.bottom: parent.bottom; width: parent.width; height: {{ "borderWidth-thin" | tok }}; color: {{ "borderColor-default" | tok }} }
        }
        Item {
            id: body
            x: 16
            width: parent.width - 32
            implicitHeight: childrenRect.height + 32
            Component.onCompleted: {
                for (let i = 0; i < children.length; i++)
                    children[i].y += 16
            }
        }
        Row {
            id: footerRow
            anchors.right: parent.right
            anchors.rightMargin: 16
            spacing: 8
            bottomPadding: 16
            layoutDirection: Qt.LeftToRight
        }
    }
}
