.pm-toggle { display: inline-flex; align-items: center; gap: 12px; font: 400 14px/20px var(--font-sans); color: {{ "fgColor-default" | tok }}; cursor: pointer; }
.pm-toggle__track {
  position: relative;
  flex: none;
  width: 36px;
  height: 20px;
  padding: 0;
  border: {{ "borderWidth-thin" | tok }} solid {{ "control-borderColor-rest" | tok }};
  border-radius: {{ "borderRadius-full" | tok }};
  background: {{ "controlTrack-bgColor-rest" | tok }};
  cursor: inherit;
  transition: background-color {{ "duration-base" | tok }} {{ "easing-standard" | tok }}, border-color {{ "duration-base" | tok }} {{ "easing-standard" | tok }};
}
.pm-toggle__knob {
  position: absolute;
  top: 2px;
  left: 2px;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: {{ "controlKnob-bgColor-rest" | tok }};
  box-shadow: 0 0 0 1px {{ "control-borderColor-rest" | tok }};
  transition: translate var(--pm-m-toggle-dur) var(--pm-m-toggle-ease), width var(--pm-m-toggle-dur) var(--pm-m-toggle-ease);
}
/* Playful scopes stretch the handle while held (toggle-stretch is 1 in sleepy). */
.pm-toggle__track:active:not(:disabled) .pm-toggle__knob { width: calc(14px * var(--pm-m-toggle-stretch)); }
.pm-toggle__track[aria-checked="true"]:active:not(:disabled) .pm-toggle__knob { translate: calc(30px - 14px * var(--pm-m-toggle-stretch)) 0; }
.pm-toggle__track[aria-checked="true"] { background: {{ "bgColor-accent-emphasis" | tok }}; border-color: {{ "bgColor-accent-emphasis" | tok }}; }
.pm-toggle__track[aria-checked="true"] .pm-toggle__knob { translate: 16px 0; background: {{ "fgColor-onEmphasis" | tok }}; box-shadow: none; }
.pm-toggle__track:focus-visible { outline: {{ "borderWidth-thick" | tok }} solid {{ "focus-outlineColor" | tok }}; outline-offset: 2px; }
.pm-toggle__track:disabled { background: {{ "bgColor-disabled" | tok }}; border-color: {{ "bgColor-disabled" | tok }}; cursor: not-allowed; }
.pm-toggle:has(:disabled) { color: {{ "fgColor-disabled" | tok }}; }
