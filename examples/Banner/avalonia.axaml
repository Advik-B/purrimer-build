<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:pm="using:Purrimer.Avalonia">
  <StackPanel Spacing="12">
    <pm:Banner Tone="success" Title="Deployed" Text="Version 2.4 is live for everyone." IsDismissible="True" />
    <pm:Banner Tone="danger" Text="The build failed on two checks." />
  </StackPanel>
</UserControl>
