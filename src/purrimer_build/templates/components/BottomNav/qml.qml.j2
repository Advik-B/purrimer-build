// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick

// The bottom navigation bar: three to five destinations, the current one marked by a short bar on the top edge that
// slides from tab to tab. Press anywhere on the bar and slide to scrub: the bar follows the pointer, the tab under it
// lifts, and that tab opens on release. activated(index) fires on every press, the current tab included.
Rectangle {
    id: root
    // [{ icon, label, activeIcon?, badge?: a count, or true for a dot }]
    property var items: []
    property int selected: 0
    property bool showLabels: false
    property string accessibleName: "Main"
    property int scrub: -1
    property int pressed: -1
    property int focusIndex: 0
    property bool keyboard: false
    readonly property int count: Math.min(items.length, 5)
    readonly property real cell: width / Math.max(1, count)
    readonly property int marked: scrub >= 0 ? scrub : selected
    signal activated(int index)

    function pick(i) {
        selected = i
        focusIndex = i
        activated(i)
    }

    implicitWidth: 360
    implicitHeight: {{ "mobile-bottomNav-height" | tok }}
    color: {{ "bgColor-default" | tok }}
    activeFocusOnTab: true
    Accessible.role: Accessible.PageTabList
    Accessible.name: accessibleName
    onActiveFocusChanged: if (!activeFocus) keyboard = false
    Keys.onPressed: (event) => {
        if (event.key === Qt.Key_Left || event.key === Qt.Key_Right) {
            keyboard = true
            focusIndex = Math.max(0, Math.min(count - 1, focusIndex + (event.key === Qt.Key_Left ? -1 : 1)))
            event.accepted = true
        } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter || event.key === Qt.Key_Space) {
            pick(focusIndex)
            event.accepted = true
        }
    }

    Rectangle { width: parent.width; height: {{ "borderWidth-thin" | tok }}; color: {{ "borderColor-default" | tok }} }

    Repeater {
        model: root.items.slice(0, 5)

        Item {
            id: cell
            required property var modelData
            required property int index
            readonly property bool current: root.selected === index
            readonly property bool lit: root.scrub === index || (current && (root.scrub < 0 || root.scrub === index))
            readonly property var badge: modelData.badge
            x: index * root.cell
            width: root.cell
            height: root.height
            Accessible.role: Accessible.PageTab
            Accessible.name: modelData.label + (badge === true ? ", new" : badge ? ", " + badge + " new" : "")
            Accessible.selected: current
            Accessible.onPressAction: root.pick(index)

            Column {
                anchors.centerIn: parent
                spacing: {{ "base-size-4" | tok }}

                Rectangle {
                    id: indicator
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: 56
                    height: 32
                    radius: {{ "borderRadius-medium" | tok }} * 1.4
                    color: root.pressed === cell.index ? {{ "control-transparent-bgColor-hover" | tok }} : "transparent"
                    scale: root.pressed === cell.index && !Purrimer.pauseLoops ? 0.9 : 1
                    transform: Translate {
                        y: root.scrub === cell.index && !Purrimer.pauseLoops ? -2 : 0
                        Behavior on y { NumberAnimation { duration: {{ "duration-fast" | tok }} } }
                    }
                    Behavior on scale { SpringAnimation { spring: 5; damping: 0.4; epsilon: 0.001 } }

                    Icon {
                        anchors.centerIn: parent
                        name: cell.current && cell.modelData.activeIcon ? cell.modelData.activeIcon : cell.modelData.icon
                        size: 24
                        color: cell.lit ? {{ "fgColor-accent" | tok }} : {{ "fgColor-muted" | tok }}
                    }

                    Rectangle {
                        id: badgeMark
                        readonly property bool dot: cell.badge === true
                        visible: !!cell.badge
                        x: parent.width / 2 + 6
                        y: dot ? 2 : -2
                        width: dot ? 12 : Math.max(20, count.implicitWidth + 10 + 2 * border.width)
                        height: dot ? 12 : 20
                        radius: height / 2
                        color: {{ "bgColor-danger-emphasis" | tok }}
                        border.width: {{ "borderWidth-thick" | tok }}
                        border.color: {{ "bgColor-default" | tok }}
                        Text {
                            id: count
                            visible: !badgeMark.dot
                            anchors.centerIn: parent
                            text: typeof cell.badge === "number" ? (cell.badge > 99 ? "99+" : String(cell.badge)) : ""
                            font.family: {{ "text-mobile-navLabel" | tok }}.family
                            font.pixelSize: 12
                            font.weight: Font.DemiBold
                            color: {{ "fgColor-onEmphasis" | tok }}
                        }
                        SequentialAnimation {
                            id: bump
                            NumberAnimation { target: badgeMark; property: "scale"; from: 0.4; to: 1.15; duration: {{ "duration-sleepy-short" | tok }} * 0.6; easing.type: Easing.OutCubic }
                            NumberAnimation { target: badgeMark; property: "scale"; to: 1; duration: {{ "duration-sleepy-short" | tok }} * 0.4; easing.type: Easing.InOutQuad }
                        }
                    }

                    Rectangle {
                        visible: root.keyboard && root.activeFocus && root.focusIndex === cell.index
                        anchors.fill: parent
                        anchors.margins: -4
                        radius: parent.radius + 4
                        color: "transparent"
                        border.width: {{ "borderWidth-thick" | tok }}
                        border.color: {{ "focus-outlineColor" | tok }}
                    }
                }

                Text {
                    visible: root.showLabels
                    anchors.horizontalCenter: parent.horizontalCenter
                    width: Math.min(implicitWidth, cell.width - 8)
                    horizontalAlignment: Text.AlignHCenter
                    elide: Text.ElideRight
                    text: cell.modelData.label
                    font.family: {{ "text-mobile-navLabel" | tok }}.family
                    font.pixelSize: 12
                    font.weight: cell.lit ? Font.DemiBold : Font.Medium
                    color: cell.lit ? {{ "fgColor-accent" | tok }} : {{ "fgColor-muted" | tok }}
                }
            }

            onBadgeChanged: if (badge && !Purrimer.pauseLoops) bump.restart()
        }
    }

    // One marker that slides between tabs and follows the pointer while scrubbing; clipped so only its rounded
    // bottom shows.
    Item {
        anchors.fill: parent
        clip: true
        Rectangle {
            visible: root.marked >= 0 && root.count > 0
            x: root.cell * (root.marked + 0.5) - 16
            y: -radius
            width: 32
            height: {{ "borderWidth-thick" | tok }} + radius
            radius: {{ "borderRadius-small" | tok }}
            color: {{ "bgColor-accent-emphasis" | tok }}
            Behavior on x {
                NumberAnimation {
                    duration: Purrimer.pauseLoops ? 0 : root.scrub >= 0 ? {{ "duration-fast" | tok }} : {{ "duration-slow" | tok }}
                    easing.type: Easing.OutCubic
                }
            }
        }
    }

    MouseArea {
        property real originX
        anchors.fill: parent
        cursorShape: Qt.PointingHandCursor
        function indexAt(x) {
            return Math.max(0, Math.min(root.count - 1, Math.floor(x / root.cell)))
        }
        onPressed: (mouse) => {
            root.keyboard = false
            originX = mouse.x
            root.pressed = indexAt(mouse.x)
        }
        onPositionChanged: (mouse) => {
            if (root.scrub < 0 && Math.abs(mouse.x - originX) < 10)
                return
            root.pressed = -1
            root.scrub = indexAt(mouse.x)
        }
        onReleased: {
            const i = root.scrub >= 0 ? root.scrub : root.pressed
            root.scrub = -1
            root.pressed = -1
            if (i >= 0)
                root.pick(i)
        }
        onCanceled: {
            root.scrub = -1
            root.pressed = -1
        }
    }
}
