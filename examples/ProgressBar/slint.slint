import { ProgressBar } from "purrimer-components.slint";

// Set indeterminate: true to sweep while the amount is unknown.
export component Example inherits VerticalLayout {
    spacing: 16px;
    alignment: start;
    ProgressBar { value: 40; }
    ProgressBar { value: 75; tone: "success"; }
    ProgressBar { value: 95; tone: "danger"; }
}
