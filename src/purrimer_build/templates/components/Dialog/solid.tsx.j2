import { Show, createEffect, createUniqueId } from "solid-js";
import { Portal, type JSX } from "@solidjs/web";
import { IconButton } from "./IconButton";

export type DialogProps = { open: boolean; title: string; onClose: () => void; footer?: JSX.Element; children?: JSX.Element };

export function Dialog(props: DialogProps): JSX.Element {
  const uid = createUniqueId();
  const onKey = (e: KeyboardEvent) => e.key === "Escape" && props.onClose();

  createEffect(
    () => props.open,
    (open) => {
      if (!open) return;
      window.addEventListener("keydown", onKey);
      return () => window.removeEventListener("keydown", onKey);
    }
  );

  const focusFirst = (el: HTMLElement) => {
    queueMicrotask(() => el.querySelector<HTMLElement>("[autofocus], button, input, select, textarea")?.focus());
  };

  return (
    <Show when={props.open}>
      <Portal>
        <div class="pm-dialog-scrim" role="presentation" onClick={(e) => e.target === e.currentTarget && props.onClose()}>
          <div class="pm-dialog" role="dialog" aria-modal="true" aria-labelledby={`${uid}-title`} ref={focusFirst}>
            <div class="pm-dialog__header">
              <h2 class="pm-dialog__title" id={`${uid}-title`}>{props.title}</h2>
              <IconButton icon="x" label="Close" variant="invisible" onClick={() => props.onClose()} />
            </div>
            <div class="pm-dialog__body">{props.children}</div>
            <Show when={props.footer}><div class="pm-dialog__footer">{props.footer}</div></Show>
          </div>
        </div>
      </Portal>
    </Show>
  );
}
