// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { Icon } from "icon.slint";

export component Select inherits VerticalLayout {
    in property <string> label;
    in property <[string]> options;
    in-out property <int> current-index: -1;
    in property <string> placeholder: "{{ c.spec.props.placeholder.default }}";
    in property <bool> enabled: true;
    callback selected(int);
    property <bool> open;

    spacing: 4px;

    Text {
        text: root.label;
        color: {{ "fgColor-default" | tok }};
        font-family: {{ "text-body-medium" | tok }}.font-family;
        font-size: 14px;
        font-weight: 600;
    }

    field := Rectangle {
        height: {{ "control-medium-size" | tok }};
        border-radius: {{ "borderRadius-medium" | tok }};
        background: !root.enabled ? {{ "bgColor-disabled" | tok }} : root.open ? {{ "overlay-bgColor" | tok }} : {{ "control-bgColor-rest" | tok }};
        border-width: focus.has-focus && !root.open ? {{ "borderWidth-thick" | tok }} : {{ "borderWidth-thin" | tok }};
        border-color: focus.has-focus && !root.open ? {{ "focus-outlineColor" | tok }} : root.open ? {{ "borderColor-default" | tok }} : {{ "control-borderColor-rest" | tok }};
        accessible-role: combobox;
        accessible-label: root.label;
        accessible-value: root.current-index >= 0 ? root.options[root.current-index] : "";
        accessible-expandable: true;
        accessible-expanded: root.open;
        accessible-action-default => { popup.show(); }

        HorizontalLayout {
            padding-left: {{ "control-medium-paddingInline-normal" | tok }};
            padding-right: 8px;
            spacing: 8px;
            Text {
                text: root.current-index >= 0 ? root.options[root.current-index] : root.placeholder;
                color: !root.enabled ? {{ "fgColor-disabled" | tok }} : root.current-index >= 0 ? {{ "fgColor-default" | tok }} : {{ "fgColor-muted" | tok }};
                font-family: {{ "text-body-medium" | tok }}.font-family;
                font-size: 14px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            Icon { path: PurrimerIcons.chevron-down-16; color: {{ "fgColor-muted" | tok }}; y: (parent.height - self.height) / 2; }
        }

        TouchArea {
            enabled: root.enabled;
            mouse-cursor: pointer;
            clicked => { root.open = true; popup.show(); }
        }

        focus := FocusScope {
            enabled: root.enabled;
            key-pressed(event) => {
                if (event.text == Key.DownArrow) {
                    root.current-index = Math.min(root.options.length - 1, root.current-index + 1);
                    root.selected(root.current-index);
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    root.current-index = Math.max(0, root.current-index - 1);
                    root.selected(root.current-index);
                    return accept;
                }
                if (event.text == " " || event.text == "\n") {
                    root.open = true;
                    popup.show();
                    return accept;
                }
                reject
            }
        }

        popup := PopupWindow {
            x: 0px;
            y: parent.height - 1px;
            width: parent.width;
            close-policy: close-on-click-outside;
            Rectangle {
                background: {{ "overlay-bgColor" | tok }};
                border-width: {{ "borderWidth-thin" | tok }};
                border-color: {{ "borderColor-default" | tok }};
                border-bottom-left-radius: {{ "borderRadius-large" | tok }};
                border-bottom-right-radius: {{ "borderRadius-large" | tok }};
                drop-shadow-offset-y: {{ "shadow-floating-small" | tok }}.offset-y;
                drop-shadow-blur: {{ "shadow-floating-small" | tok }}.blur;
                drop-shadow-color: {{ "shadow-floating-small" | tok }}.color;
                VerticalLayout {
                    padding: 4px;
                    for option[i] in root.options: Rectangle {
                        height: 32px;
                        border-radius: {{ "borderRadius-small" | tok }};
                        background: option-touch.has-hover ? {{ "control-transparent-bgColor-hover" | tok }} : transparent;
                        accessible-role: list-item;
                        accessible-label: option;
                        accessible-item-selectable: true;
                        accessible-item-selected: i == root.current-index;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: option;
                                color: {{ "fgColor-default" | tok }};
                                font-family: {{ "text-body-medium" | tok }}.font-family;
                                font-size: 14px;
                                font-weight: i == root.current-index ? 600 : 400;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            if i == root.current-index: Icon { path: PurrimerIcons.check-16; color: {{ "fgColor-accent" | tok }}; y: (parent.height - self.height) / 2; }
                        }
                        option-touch := TouchArea {
                            clicked => {
                                root.current-index = i;
                                root.open = false;
                                root.selected(i);
                            }
                        }
                    }
                }
            }
        }
    }
}
