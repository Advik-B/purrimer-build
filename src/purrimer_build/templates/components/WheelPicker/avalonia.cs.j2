using System;
using System.Collections.Generic;
using System.Globalization;
using System.Linq;
using Avalonia;
using Avalonia.Collections;
using Avalonia.Controls;
using Avalonia.Controls.Documents;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.Media;
using Avalonia.Metadata;

namespace {{ ns }};

// One wheel of a WheelPicker. Options is a comma-separated list; Value is the chosen one. Width fixes the column's
// width (NaN shares the space); Align is start, center or end.
public class WheelColumn
{
    public string Label { get; set; } = "";
    public string Options { get; set; } = "";
    public string? Value { get; set; }
    public double Width { get; set; } = double.NaN;
    public string Align { get; set; } = "center";

    internal string[] Items => Options.Split(',', StringSplitOptions.TrimEntries);
}

public class WheelChangedEventArgs : RoutedEventArgs
{
    public WheelChangedEventArgs(RoutedEvent routedEvent, int column, string value) : base(routedEvent)
    {
        Column = column;
        Value = value;
    }

    public int Column { get; }
    public string Value { get; }
}

// Wheels for picking from an ordered set: one column for a list, several for a time or date. Each wheel rolls under a
// finger, pen or dragged mouse with momentum and settles on a row; the mouse wheel, a tap on a row and the arrow keys
// turn it too. Changed fires as a value changes.
public class WheelPicker : Control
{
    public static readonly StyledProperty<FontFamily> FontFamilyProperty =
        TextElement.FontFamilyProperty.AddOwner<WheelPicker>();

    public static readonly StyledProperty<IBrush?> InkProperty =
        AvaloniaProperty.Register<WheelPicker, IBrush?>(nameof(Ink));

    public static readonly StyledProperty<IBrush?> MutedInkProperty =
        AvaloniaProperty.Register<WheelPicker, IBrush?>(nameof(MutedInk));

    public static readonly StyledProperty<IBrush?> BandBrushProperty =
        AvaloniaProperty.Register<WheelPicker, IBrush?>(nameof(BandBrush));

    public static readonly StyledProperty<IBrush?> BandStrokeProperty =
        AvaloniaProperty.Register<WheelPicker, IBrush?>(nameof(BandStroke));

    public static readonly StyledProperty<IBrush?> FocusBrushProperty =
        AvaloniaProperty.Register<WheelPicker, IBrush?>(nameof(FocusBrush));

    public static readonly RoutedEvent<WheelChangedEventArgs> ChangedEvent =
        RoutedEvent.Register<WheelPicker, WheelChangedEventArgs>(nameof(Changed), RoutingStrategies.Bubble);

    private const double Row = 44;
    private const double Rows = 5;
    private const double Gap = 4;

    private readonly List<PurrimerSpring> _offsets = new();
    private readonly List<int> _indices = new();
    private readonly PurrimerVelocityTracker _tracker = new();
    private int _active = -1;
    private int _focus;
    private bool _keyboard;
    private Point? _origin;
    private double _originOffset;
    private bool _dragging;

    static WheelPicker()
    {
        AffectsRender<WheelPicker>(InkProperty, MutedInkProperty, BandBrushProperty, BandStrokeProperty, FocusBrushProperty);
        FocusableProperty.OverrideDefaultValue<WheelPicker>(true);
    }

    public WheelPicker()
    {
        Columns.CollectionChanged += (_, _) => Rebuild();
    }

    [Content]
    public AvaloniaList<WheelColumn> Columns { get; } = new();

    public FontFamily FontFamily { get => GetValue(FontFamilyProperty); set => SetValue(FontFamilyProperty, value); }
    public IBrush? Ink { get => GetValue(InkProperty); set => SetValue(InkProperty, value); }
    public IBrush? MutedInk { get => GetValue(MutedInkProperty); set => SetValue(MutedInkProperty, value); }
    public IBrush? BandBrush { get => GetValue(BandBrushProperty); set => SetValue(BandBrushProperty, value); }
    public IBrush? BandStroke { get => GetValue(BandStrokeProperty); set => SetValue(BandStrokeProperty, value); }
    public IBrush? FocusBrush { get => GetValue(FocusBrushProperty); set => SetValue(FocusBrushProperty, value); }

    public event EventHandler<WheelChangedEventArgs>? Changed
    {
        add => AddHandler(ChangedEvent, value);
        remove => RemoveHandler(ChangedEvent, value);
    }

    public string ValueOf(int column) => Columns[column].Items[_indices[column]];

    private void Rebuild()
    {
        _offsets.Clear();
        _indices.Clear();
        for (var c = 0; c < Columns.Count; c++)
        {
            var column = c;
            var items = Columns[c].Items;
            var start = Math.Max(0, Array.IndexOf(items, Columns[c].Value));
            var spring = new PurrimerSpring(start * Row, 0.5);
            spring.Changed += v => OnMoved(column, v);
            _offsets.Add(spring);
            _indices.Add(start);
        }
        InvalidateVisual();
    }

    private void OnMoved(int column, double value)
    {
        var count = Columns[column].Items.Length;
        var index = Math.Clamp((int)Math.Round(value / Row), 0, Math.Max(0, count - 1));
        if (index != _indices[column])
        {
            _indices[column] = index;
            Columns[column].Value = Columns[column].Items[index];
            RaiseEvent(new WheelChangedEventArgs(ChangedEvent, column, Columns[column].Items[index]));
        }
        InvalidateVisual();
    }

    private void Go(int column, int index, double? velocity = null)
    {
        var count = Columns[column].Items.Length;
        _offsets[column].To(Math.Clamp(index, 0, Math.Max(0, count - 1)) * Row, velocity);
    }

    private List<Rect> ColumnRects()
    {
        var fixedWidth = Columns.Where(c => !double.IsNaN(c.Width)).Sum(c => c.Width);
        var free = Columns.Count(c => double.IsNaN(c.Width));
        var share = free > 0 ? (Bounds.Width - fixedWidth - Gap * Math.Max(0, Columns.Count - 1)) / free : 0;
        var rects = new List<Rect>();
        double x = 0;
        foreach (var c in Columns)
        {
            var w = double.IsNaN(c.Width) ? share : c.Width;
            rects.Add(new Rect(x, 0, Math.Max(0, w), Row * Rows));
            x += w + Gap;
        }
        return rects;
    }

    private int ColumnAt(Point p)
    {
        var rects = ColumnRects();
        for (var i = 0; i < rects.Count; i++)
            if (p.X >= rects[i].X && p.X < rects[i].Right)
                return i;
        return -1;
    }

    protected override Size MeasureOverride(Size availableSize) =>
        new(double.IsInfinity(availableSize.Width) ? 320 : availableSize.Width, Row * Rows);

    protected override void OnPointerPressed(PointerPressedEventArgs e)
    {
        base.OnPointerPressed(e);
        var p = e.GetPosition(this);
        _active = ColumnAt(p);
        if (_active < 0 || !e.GetCurrentPoint(this).Properties.IsLeftButtonPressed)
            return;
        _keyboard = false;
        _focus = _active;
        _offsets[_active].Stop();
        _origin = p;
        _originOffset = _offsets[_active].Value;
        _dragging = false;
        _tracker.Reset();
        _tracker.Add(p);
        e.Pointer.Capture(this);
    }

    protected override void OnPointerMoved(PointerEventArgs e)
    {
        base.OnPointerMoved(e);
        if (_origin is not { } origin || _active < 0)
            return;
        var p = e.GetPosition(this);
        _tracker.Add(p);
        var dy = p.Y - origin.Y;
        if (!_dragging && Math.Abs(dy) > PurrimerMotion.Slop)
            _dragging = true;
        if (!_dragging)
            return;
        var limit = (Columns[_active].Items.Length - 1) * Row;
        var offset = _originOffset - dy;
        if (offset < 0)
            offset = PurrimerMotion.RubberBand(offset, Bounds.Height);
        else if (offset > limit)
            offset = limit + PurrimerMotion.RubberBand(offset - limit, Bounds.Height);
        _offsets[_active].Set(offset);
    }

    protected override void OnPointerReleased(PointerReleasedEventArgs e)
    {
        base.OnPointerReleased(e);
        if (_origin == null || _active < 0)
            return;
        _origin = null;
        e.Pointer.Capture(null);
        if (_dragging)
        {
            var velocity = -_tracker.Velocity().Y;
            Go(_active, (int)Math.Round((_offsets[_active].Value + PurrimerMotion.Project(velocity)) / Row), velocity);
        }
        else
        {
            // A tap on a row rolls it to the band.
            Go(_active, _indices[_active] + (int)Math.Round((e.GetPosition(this).Y - Bounds.Height / 2) / Row));
        }
        _dragging = false;
    }

    protected override void OnPointerWheelChanged(PointerWheelEventArgs e)
    {
        base.OnPointerWheelChanged(e);
        var column = ColumnAt(e.GetPosition(this));
        if (column < 0 || e.Delta.Y == 0)
            return;
        Go(column, (int)Math.Round(_offsets[column].Target / Row) + (e.Delta.Y > 0 ? -1 : 1));
        e.Handled = true;
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        base.OnKeyDown(e);
        if (Columns.Count == 0)
            return;
        _keyboard = true;
        var index = _indices[_focus];
        int? next = e.Key switch
        {
            Key.Up => index - 1,
            Key.Down => index + 1,
            Key.PageUp => index - 5,
            Key.PageDown => index + 5,
            Key.Home => 0,
            Key.End => Columns[_focus].Items.Length - 1,
            _ => null,
        };
        if (next is { } n)
        {
            Go(_focus, n);
            e.Handled = true;
        }
        else if (e.Key is Key.Left or Key.Right)
        {
            _focus = Math.Clamp(_focus + (e.Key == Key.Left ? -1 : 1), 0, Columns.Count - 1);
            InvalidateVisual();
            e.Handled = true;
        }
    }

    protected override void OnGotFocus(FocusChangedEventArgs e)
    {
        base.OnGotFocus(e);
        _keyboard = e.NavigationMethod == NavigationMethod.Tab;
        InvalidateVisual();
    }

    protected override void OnLostFocus(FocusChangedEventArgs e)
    {
        base.OnLostFocus(e);
        InvalidateVisual();
    }

    public override void Render(DrawingContext context)
    {
        var radius = {{ px("borderRadius-medium") | num }};
        context.DrawRectangle(BandBrush, new Pen(BandStroke, {{ px("borderWidth-thin") | num }}),
            new Rect(0.5, Row * 2 + 0.5, Bounds.Width - 1, Row - 1), radius, radius);
        var rects = ColumnRects();
        var center = Bounds.Height / 2;
        for (var c = 0; c < Columns.Count && c < _offsets.Count; c++)
        {
            var rect = rects[c];
            var items = Columns[c].Items;
            using (context.PushClip(rect))
            {
                for (var i = 0; i < items.Length; i++)
                {
                    var y = center - Row / 2 + i * Row - _offsets[c].Value;
                    if (y < -Row || y > Bounds.Height)
                        continue;
                    var on = i == _indices[c];
                    var distance = Math.Abs(y + Row / 2 - center) / center;
                    var text = new FormattedText(items[i], CultureInfo.CurrentUICulture, FlowDirection.LeftToRight,
                        new Typeface(FontFamily, FontStyle.Normal, on ? FontWeight.SemiBold : FontWeight.Normal), 20,
                        on ? Ink : MutedInk);
                    var x = Columns[c].Align switch
                    {
                        "start" => rect.X + 8,
                        "end" => rect.Right - 8 - text.Width,
                        _ => rect.X + (rect.Width - text.Width) / 2,
                    };
                    // Rows fade towards the edges of the wheel.
                    using (context.PushOpacity(Math.Clamp(1.6 - 1.6 * distance, 0, 1)))
                        context.DrawText(text, new Point(x, y + (Row - text.Height) / 2));
                }
            }
            if (IsFocused && _keyboard && c == _focus)
                context.DrawRectangle(null, new Pen(FocusBrush, {{ px("borderWidth-thick") | num }}), rect.Deflate(1), radius, radius);
        }
    }
}
