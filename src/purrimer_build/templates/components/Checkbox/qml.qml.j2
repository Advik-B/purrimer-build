// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Templates as T
import "PmMotion.js" as PmMotion

T.CheckBox {
    id: control
    implicitWidth: implicitContentWidth + leftPadding + rightPadding
    implicitHeight: Math.max(implicitContentHeight, implicitIndicatorHeight) + topPadding + bottomPadding
    spacing: 8
    padding: 2
    // The kind's control timings: the mark pops in on the kind's curve, and in a playful scope the box presses to 95%.
    readonly property var motionControls: PmMotion.controls(Purrimer.effectiveKind(control, ""))

    indicator: Rectangle {
        implicitWidth: 16
        implicitHeight: 16
        x: control.leftPadding
        y: (control.height - height) / 2
        radius: {{ "borderRadius-small" | tok }}
        readonly property bool on: control.checkState !== Qt.Unchecked
        scale: control.pressed && control.enabled ? control.motionControls.press : 1
        Behavior on scale {
            NumberAnimation {
                duration: control.motionControls.pressDur
                easing.type: Easing.BezierSpline
                easing.bezierCurve: PmMotion.curve(control.motionControls.pressEase)
            }
        }
        color: !control.enabled ? {{ "bgColor-disabled" | tok }} : on ? {{ "bgColor-accent-emphasis" | tok }} : {{ "control-bgColor-rest" | tok }}
        border.width: {{ "borderWidth-thin" | tok }}
        border.color: !control.enabled ? {{ "bgColor-disabled" | tok }} : on ? color : control.hovered ? {{ "borderColor-emphasis" | tok }} : {{ "control-borderColor-rest" | tok }}

        Icon {
            anchors.centerIn: parent
            name: control.checkState === Qt.PartiallyChecked ? "dash" : "check"
            color: {{ "fgColor-onEmphasis" | tok }}
            scale: parent.on ? 0.75 : 0
            Behavior on scale {
                NumberAnimation {
                    duration: control.motionControls.checkDur
                    easing.type: Easing.BezierSpline
                    easing.bezierCurve: PmMotion.curve(control.motionControls.checkEase)
                }
            }
        }

        Rectangle {
            anchors.fill: parent
            anchors.margins: -4
            radius: parent.radius + 4
            color: "transparent"
            border.width: {{ "borderWidth-thick" | tok }}
            border.color: {{ "focus-outlineColor" | tok }}
            visible: control.visualFocus
        }
    }

    contentItem: Text {
        leftPadding: control.indicator.width + control.spacing
        text: control.text
        font: {{ "text-body-medium" | tok }}
        color: control.enabled ? {{ "fgColor-default" | tok }} : {{ "fgColor-disabled" | tok }}
        verticalAlignment: Text.AlignVCenter
    }
}
