<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<script lang="ts">
  import Icon from "./Icon.svelte";

  let { label, options = [], value = $bindable(-1), placeholder = "{{ c.spec.props.placeholder.default }}", disabled = false, onchange }: {
    label: string;
    options?: string[];
    value?: number;
    placeholder?: string;
    disabled?: boolean;
    onchange?: (index: number) => void;
  } = $props();

  const uid = $props.id();
  let open = $state(false);
  let active = $state(0);
  let root: HTMLDivElement;

  function show() {
    if (disabled) return;
    active = value >= 0 ? value : 0;
    open = true;
  }

  function choose(index: number) {
    value = index;
    open = false;
    onchange?.(index);
  }

  function onkeydown(e: KeyboardEvent) {
    if (!open && (e.key === "ArrowDown" || e.key === "ArrowUp" || e.key === "Enter" || e.key === " ")) {
      e.preventDefault();
      show();
      return;
    }
    if (!open) return;
    if (e.key === "ArrowDown") active = Math.min(options.length - 1, active + 1);
    else if (e.key === "ArrowUp") active = Math.max(0, active - 1);
    else if (e.key === "Home") active = 0;
    else if (e.key === "End") active = options.length - 1;
    else if (e.key === "Enter" || e.key === " ") choose(active);
    else if (e.key === "Escape") open = false;
    else return;
    e.preventDefault();
  }

  function onfocusout(e: FocusEvent) {
    if (!root.contains(e.relatedTarget as Node)) open = false;
  }
</script>

<div class={["pm-select", open && "pm-select--open", disabled && "pm-select--disabled"]} bind:this={root} {onfocusout}>
  <span class="pm-select__label" id="pm-select-{uid}-label">{label}</span>
  <button
    type="button"
    class="pm-select__field"
    role="combobox"
    aria-haspopup="listbox"
    aria-expanded={open}
    aria-controls="pm-select-{uid}-list"
    aria-labelledby="pm-select-{uid}-label"
    aria-activedescendant={open ? `pm-select-${uid}-${active}` : undefined}
    {disabled}
    onclick={() => (open ? (open = false) : show())}
    {onkeydown}
  >
    {#if value >= 0}<span>{options[value]}</span>{:else}<span class="pm-select__placeholder">{placeholder}</span>{/if}
    <Icon name="chevron-down" />
  </button>
  {#if open}
    <ul class="pm-select__list" role="listbox" id="pm-select-{uid}-list" aria-labelledby="pm-select-{uid}-label">
      {#each options as option, i}
        <!-- svelte-ignore a11y_click_events_have_key_events (the combobox button handles the keyboard through aria-activedescendant) -->
        <li
          id="pm-select-{uid}-{i}"
          class={["pm-select__option", i === active && "pm-select__option--active"]}
          role="option"
          aria-selected={i === value}
          onpointerenter={() => (active = i)}
          onpointerdown={(e) => e.preventDefault()}
          onclick={() => choose(i)}
        >
          <span>{option}</span>
          {#if i === value}<Icon name="check" />{/if}
        </li>
      {/each}
    </ul>
  {/if}
</div>
