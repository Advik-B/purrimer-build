.pm-avatar-stack { display: inline-flex; align-items: center; border-radius: {{ "borderRadius-full" | tok }}; }
.pm-avatar-stack__person {
  position: relative;
  display: inline-grid;
  place-items: center;
  flex: none;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: {{ "borderRadius-full" | tok }};
  background: {{ "bgColor-accent-muted" | tok }};
  color: {{ "fgColor-accent" | tok }};
  box-shadow: 0 0 0 1px {{ "bgColor-default" | tok }};
  font-family: var(--font-sans);
  font-weight: 600;
  line-height: 1;
  user-select: none;
  transition: margin {{ "duration-base" | tok }} {{ "easing-standard" | tok }}, color {{ "duration-base" | tok }} {{ "easing-standard" | tok }};
}
.pm-avatar-stack__person img { width: 100%; height: 100%; object-fit: cover; }
.pm-avatar-stack__person + .pm-avatar-stack__person { margin-left: calc(var(--pm-av) * -0.6); }
/* Tucked initials would show as fragments, so they stay hidden until the stack spreads. */
.pm-avatar-stack__person + .pm-avatar-stack__person:not(.pm-avatar-stack__more) { color: transparent; }
.pm-avatar-stack:hover .pm-avatar-stack__person + .pm-avatar-stack__person,
.pm-avatar-stack:focus-visible .pm-avatar-stack__person + .pm-avatar-stack__person { margin-left: 4px; color: {{ "fgColor-accent" | tok }}; }
.pm-avatar-stack__more { min-width: var(--pm-av); padding: 0 4px; background: {{ "bgColor-neutral-muted" | tok }}; color: {{ "fgColor-muted" | tok }}; }
.pm-avatar-stack .pm-avatar-stack__person + .pm-avatar-stack__more { margin-left: 4px; color: {{ "fgColor-muted" | tok }}; }
.pm-avatar-stack:focus-visible { outline: {{ "borderWidth-thick" | tok }} solid {{ "focus-outlineColor" | tok }}; outline-offset: 2px; }
