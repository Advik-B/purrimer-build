using System;
using Avalonia;
using Avalonia.Automation;
using Avalonia.Controls;
using Avalonia.Controls.Metadata;
using Avalonia.Controls.Primitives;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.LogicalTree;

namespace {{ ns }};

// Rows for navigation, selection and menus: ActionListItem, ActionListGroup and ActionListDivider children.
public class ActionList : ItemsControl
{
    public static readonly RoutedEvent<RoutedEventArgs> TriggeredEvent =
        RoutedEvent.Register<ActionList, RoutedEventArgs>(nameof(Triggered), RoutingStrategies.Bubble);

    // Raised with the picked ActionListItem as the source.
    public event EventHandler<RoutedEventArgs>? Triggered
    {
        add => AddHandler(TriggeredEvent, value);
        remove => RemoveHandler(TriggeredEvent, value);
    }

    protected override bool NeedsContainerOverride(object? item, int index, out object? recycleKey) =>
        NeedsContainer<Control>(item, out recycleKey);

    protected override Control CreateContainerForItemOverride(object? item, int index, object? recycleKey) => new ActionListItem();
}

// A heading for a group of items.
public class ActionListGroup : TemplatedControl
{
    public static readonly StyledProperty<string?> HeaderProperty =
        AvaloniaProperty.Register<ActionListGroup, string?>(nameof(Header));

    public string? Header
    {
        get => GetValue(HeaderProperty);
        set => SetValue(HeaderProperty, value);
    }
}

// A rule between groups.
public class ActionListDivider : TemplatedControl
{
}

// One row: optional check, leading icon, label with description, and a trailing icon or text such as a shortcut.
[PseudoClasses(":current", ":checkable", ":checked", ":pressed")]
public class ActionListItem : TemplatedControl
{
    public static readonly StyledProperty<string?> LabelProperty =
        AvaloniaProperty.Register<ActionListItem, string?>(nameof(Label));

    public static readonly StyledProperty<string?> DescriptionProperty =
        AvaloniaProperty.Register<ActionListItem, string?>(nameof(Description));

    public static readonly StyledProperty<string?> LeadingIconProperty =
        AvaloniaProperty.Register<ActionListItem, string?>(nameof(LeadingIcon));

    public static readonly StyledProperty<string?> TrailingIconProperty =
        AvaloniaProperty.Register<ActionListItem, string?>(nameof(TrailingIcon));

    public static readonly StyledProperty<string?> TrailingTextProperty =
        AvaloniaProperty.Register<ActionListItem, string?>(nameof(TrailingText));

    public static readonly StyledProperty<bool> IsCurrentProperty =
        AvaloniaProperty.Register<ActionListItem, bool>(nameof(IsCurrent));

    public static readonly StyledProperty<bool?> IsSelectedProperty =
        AvaloniaProperty.Register<ActionListItem, bool?>(nameof(IsSelected));

    public static readonly StyledProperty<string> VariantProperty =
        AvaloniaProperty.Register<ActionListItem, string>(nameof(Variant), "default");

    public string? Label { get => GetValue(LabelProperty); set => SetValue(LabelProperty, value); }
    public string? Description { get => GetValue(DescriptionProperty); set => SetValue(DescriptionProperty, value); }
    public string? LeadingIcon { get => GetValue(LeadingIconProperty); set => SetValue(LeadingIconProperty, value); }
    public string? TrailingIcon { get => GetValue(TrailingIconProperty); set => SetValue(TrailingIconProperty, value); }
    public string? TrailingText { get => GetValue(TrailingTextProperty); set => SetValue(TrailingTextProperty, value); }

    // The page or view you are on: weight 600 and an accent indicator at the left edge.
    public bool IsCurrent { get => GetValue(IsCurrentProperty); set => SetValue(IsCurrentProperty, value); }

    // Null for a plain item; true or false makes it checkable.
    public bool? IsSelected { get => GetValue(IsSelectedProperty); set => SetValue(IsSelectedProperty, value); }

    // default or danger
    public string Variant { get => GetValue(VariantProperty); set => SetValue(VariantProperty, value); }

    protected override void OnPropertyChanged(AvaloniaPropertyChangedEventArgs change)
    {
        base.OnPropertyChanged(change);
        if (change.Property == IsCurrentProperty)
            PseudoClasses.Set(":current", IsCurrent);
        else if (change.Property == IsSelectedProperty)
        {
            PseudoClasses.Set(":checkable", IsSelected.HasValue);
            PseudoClasses.Set(":checked", IsSelected == true);
        }
        else if (change.Property == LabelProperty)
            AutomationProperties.SetName(this, Label);
    }

    private void Trigger() => RaiseEvent(new RoutedEventArgs(ActionList.TriggeredEvent, this));

    protected override void OnPointerPressed(PointerPressedEventArgs e)
    {
        base.OnPointerPressed(e);
        if (e.GetCurrentPoint(this).Properties.IsLeftButtonPressed)
            PseudoClasses.Set(":pressed", true);
    }

    protected override void OnPointerReleased(PointerReleasedEventArgs e)
    {
        base.OnPointerReleased(e);
        PseudoClasses.Set(":pressed", false);
        if (e.InitialPressMouseButton == MouseButton.Left && IsEffectivelyEnabled)
        {
            Trigger();
            e.Handled = true;
        }
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        base.OnKeyDown(e);
        if (e.Key is Key.Enter or Key.Space)
        {
            Trigger();
            e.Handled = true;
        }
    }
}
