// A named detent: the thumb snaps to it within 10px and its label sits under the track.
public class SliderMark
{
    public double Value { get; set; }
    public string? Label { get; set; }
}

// A labelled slider with an optional value read-out. RangeBase keeps Minimum, Maximum, Value, SmallChange (the
// step) and LargeChange (the page step); SliderBar draws it.
// Inside a touch scope (pm:PurrimerTouch.Scope, which MobileScreen sets), or whenever IsRange or Marks is set, it uses
// its touch design: a 28px thumb that grows while held, a value bubble, detents, mark labels and, with IsRange, a
// second thumb for LowValue and HighValue. The touch design is always horizontal.
[TemplatePart("PART_Bar", typeof(SliderBar))]
[PseudoClasses(":touch")]
public class Slider : RangeBase
{
    public static readonly StyledProperty<bool> IsRangeProperty =
        AvaloniaProperty.Register<Slider, bool>(nameof(IsRange));

    public static readonly StyledProperty<double> LowValueProperty =
        AvaloniaProperty.Register<Slider, double>(nameof(LowValue), 0, defaultBindingMode: global::Avalonia.Data.BindingMode.TwoWay);

    public static readonly StyledProperty<double> HighValueProperty =
        AvaloniaProperty.Register<Slider, double>(nameof(HighValue), {{ c.spec.props.max.default }}, defaultBindingMode: global::Avalonia.Data.BindingMode.TwoWay);

    public static readonly DirectProperty<Slider, bool> IsTouchProperty =
        AvaloniaProperty.RegisterDirect<Slider, bool>(nameof(IsTouch), o => o.IsTouch);

    // With a step and no more than this many steps, every step is a detent with a dot on the rail.
    private const int DetentMax = 20;
    private bool _isTouch;

    public Slider()
    {
        Marks.CollectionChanged += (_, _) => Refresh();
    }

    // Two thumbs for LowValue and HighValue, which cannot pass each other.
    public bool IsRange
    {
        get => GetValue(IsRangeProperty);
        set => SetValue(IsRangeProperty, value);
    }

    public double LowValue
    {
        get => GetValue(LowValueProperty);
        set => SetValue(LowValueProperty, value);
    }

    public double HighValue
    {
        get => GetValue(HighValueProperty);
        set => SetValue(HighValueProperty, value);
    }

    // Named detents. With marks, a SmallChange of 0 snaps to the marks alone.
    public AvaloniaList<SliderMark> Marks { get; } = new();

    public bool IsTouch
    {
        get => _isTouch;
        private set => SetAndRaise(IsTouchProperty, ref _isTouch, value);
    }

    // The thumb the keyboard moves.
    internal int FocusThumb { get; set; }

    internal List<SliderMark> MarkList =>
        Marks.Where(m => m.Value >= Minimum && m.Value <= Maximum).OrderBy(m => m.Value).ToList();

    internal double SnapStep => MarkList.Count > 0 && SmallChange == 0 ? 0 : SmallChange;

    internal List<double> Detents()
    {
        var marks = MarkList;
        if (marks.Count > 0)
            return marks.Select(m => m.Value).ToList();
        var list = new List<double>();
        var step = SnapStep;
        if (step > 0 && (Maximum - Minimum) / step <= DetentMax)
        {
            for (var v = Minimum; v <= Maximum + step / 2; v += step)
                list.Add(Math.Round(v, 6));
        }
        return list;
    }

    internal double Snap(double v)
    {
        var c = Math.Clamp(v, Minimum, Maximum);
        var step = SnapStep;
        if (step > 0)
            return Math.Min(Maximum, Math.Round(Minimum + Math.Round((c - Minimum) / step) * step, 6));
        var marks = MarkList;
        return marks.Count == 0 ? c : marks.OrderBy(m => Math.Abs(m.Value - c)).First().Value;
    }

    internal double FractionOf(double v) =>
        Maximum > Minimum ? (Math.Clamp(v, Minimum, Maximum) - Minimum) / (Maximum - Minimum) : 0;

    internal int Thumbs => IsRange ? 2 : 1;

    internal double ValueOf(int i) => IsRange ? (i == 0 ? LowValue : HighValue) : Value;

    internal (double Low, double High) LimitsOf(int i) =>
        !IsRange ? (Minimum, Maximum) : i == 0 ? (Minimum, HighValue) : (LowValue, Maximum);

    internal void SetAt(int i, double v)
    {
        if (ValueOf(i) == v)
            return;
        if (!IsRange)
            Value = v;
        else if (i == 0)
            LowValue = v;
        else
            HighValue = v;
    }

    internal string Format(double v)
    {
        var mark = MarkList.FirstOrDefault(m => m.Value == v && !string.IsNullOrEmpty(m.Label));
        return mark?.Label ?? v.ToString(CultureInfo.CurrentCulture) + Suffix;
    }

    public static readonly StyledProperty<string?> LabelProperty =
        AvaloniaProperty.Register<Slider, string?>(nameof(Label));

    public static readonly StyledProperty<Orientation> OrientationProperty =
        AvaloniaProperty.Register<Slider, Orientation>(nameof(Orientation), Orientation.Horizontal);

    public static readonly StyledProperty<string> TickPositionProperty =
        AvaloniaProperty.Register<Slider, string>(nameof(TickPosition), "none");

    public static readonly StyledProperty<double> TickIntervalProperty =
        AvaloniaProperty.Register<Slider, double>(nameof(TickInterval));

    public static readonly StyledProperty<double> LengthProperty =
        AvaloniaProperty.Register<Slider, double>(nameof(Length));

    public static readonly StyledProperty<bool> ShowValueProperty =
        AvaloniaProperty.Register<Slider, bool>(nameof(ShowValue));

    public static readonly StyledProperty<string?> SuffixProperty =
        AvaloniaProperty.Register<Slider, string?>(nameof(Suffix));

    public static readonly DirectProperty<Slider, string> ValueTextProperty =
        AvaloniaProperty.RegisterDirect<Slider, string>(nameof(ValueText), o => o.ValueText);

    public static readonly DirectProperty<Slider, bool> HasHeadProperty =
        AvaloniaProperty.RegisterDirect<Slider, bool>(nameof(HasHead), o => o.HasHead);

    private string _valueText = "0";
    private bool _hasHead;
    private SliderBar? _bar;

    static Slider()
    {
        MaximumProperty.OverrideDefaultValue<Slider>({{ c.spec.props.max.default }});
        SmallChangeProperty.OverrideDefaultValue<Slider>({{ c.spec.props.step.default }});
        LargeChangeProperty.OverrideDefaultValue<Slider>({{ c.spec.props.pageStep.default }});
    }

    public string? Label
    {
        get => GetValue(LabelProperty);
        set => SetValue(LabelProperty, value);
    }

    public Orientation Orientation
    {
        get => GetValue(OrientationProperty);
        set => SetValue(OrientationProperty, value);
    }

    // none, above, below or both; vertical sliders use left and right.
    public string TickPosition
    {
        get => GetValue(TickPositionProperty);
        set => SetValue(TickPositionProperty, value);
    }

    // Distance between ticks; 0 uses LargeChange.
    public double TickInterval
    {
        get => GetValue(TickIntervalProperty);
        set => SetValue(TickIntervalProperty, value);
    }

    // Track length in px; 0 fills the width, or 160px when vertical.
    public double Length
    {
        get => GetValue(LengthProperty);
        set => SetValue(LengthProperty, value);
    }

    public bool ShowValue
    {
        get => GetValue(ShowValueProperty);
        set => SetValue(ShowValueProperty, value);
    }

    // Text after the shown value, such as "%".
    public string? Suffix
    {
        get => GetValue(SuffixProperty);
        set => SetValue(SuffixProperty, value);
    }

    public string ValueText
    {
        get => _valueText;
        private set => SetAndRaise(ValueTextProperty, ref _valueText, value);
    }

    public bool HasHead
    {
        get => _hasHead;
        private set => SetAndRaise(HasHeadProperty, ref _hasHead, value);
    }

    internal bool Dragging { get; set; }

    protected override void OnApplyTemplate(TemplateAppliedEventArgs e)
    {
        base.OnApplyTemplate(e);
        _bar = e.NameScope.Find<SliderBar>("PART_Bar");
        if (_bar != null)
            _bar.Owner = this;
        Refresh();
    }

    protected override void OnPropertyChanged(AvaloniaPropertyChangedEventArgs change)
    {
        base.OnPropertyChanged(change);
        if (change.Property == LabelProperty)
            AutomationProperties.SetName(this, Label);
        if (change.Property == ValueProperty || change.Property == LowValueProperty || change.Property == HighValueProperty)
            _bar?.ValuesChanged();
        Refresh();
    }

    private void Refresh()
    {
        IsTouch = IsRange || Marks.Count > 0 || PurrimerTouch.GetScope(this);
        PseudoClasses.Set(":touch", IsTouch);
        ValueText = !IsTouch ? Value.ToString(CultureInfo.CurrentCulture) + Suffix
            : IsRange ? Format(LowValue) + " to " + Format(HighValue) : Format(Value);
        HasHead = !string.IsNullOrEmpty(Label) || ShowValue;
        _bar?.InvalidateMeasure();
        _bar?.InvalidateVisual();
    }

    protected override void OnGotFocus(FocusChangedEventArgs e)
    {
        base.OnGotFocus(e);
        if (IsTouch && IsRange && e.NavigationMethod == NavigationMethod.Tab)
            FocusThumb = e.KeyModifiers.HasFlag(KeyModifiers.Shift) ? 1 : 0;
        _bar?.FocusChanged();
    }

    protected override void OnLostFocus(FocusChangedEventArgs e)
    {
        base.OnLostFocus(e);
        _bar?.FocusChanged();
    }

    // The touch design's keys: Tab moves between the two thumbs of a range before it leaves the slider.
    private void TouchKey(KeyEventArgs e)
    {
        if (e.Key == Key.Tab && IsRange)
        {
            var back = e.KeyModifiers.HasFlag(KeyModifiers.Shift);
            if ((!back && FocusThumb == 0) || (back && FocusThumb == 1))
            {
                FocusThumb = back ? 0 : 1;
                _bar?.FocusChanged();
                e.Handled = true;
            }
            return;
        }
        var i = FocusThumb;
        var v = ValueOf(i);
        var (lo, hi) = LimitsOf(i);
        var up = e.Key is Key.Right or Key.Up;
        var down = e.Key is Key.Left or Key.Down;
        double next;
        if (up || down)
        {
            if (SnapStep > 0)
            {
                next = v + (up ? SnapStep : -SnapStep);
            }
            else
            {
                var detents = Detents();
                var at = Math.Max(0, detents.IndexOf(Snap(v)));
                next = detents[Math.Clamp(at + (up ? 1 : -1), 0, detents.Count - 1)];
            }
        }
        else if (e.Key is Key.PageUp or Key.PageDown)
        {
            next = v + (e.Key == Key.PageUp ? LargeChange : -LargeChange);
        }
        else if (e.Key == Key.Home)
        {
            next = lo;
        }
        else if (e.Key == Key.End)
        {
            next = hi;
        }
        else
        {
            return;
        }
        SetAt(i, Math.Clamp(Snap(next), lo, hi));
        _bar?.FocusChanged();
        e.Handled = true;
    }

    // Sets a value from a raw number: snapped to SmallChange and kept in range.
    internal void SetSnapped(double raw)
    {
        var step = SmallChange > 0 ? SmallChange : 1;
        var snapped = Math.Round((raw - Minimum) / step) * step + Minimum;
        Value = Math.Clamp(Math.Round(snapped, 10), Minimum, Maximum);
    }

    protected override void OnKeyDown(KeyEventArgs e)
    {
        base.OnKeyDown(e);
        if (!IsEnabled)
            return;
        if (IsTouch)
        {
            TouchKey(e);
            return;
        }
        double? next = e.Key switch
        {
            Key.Up or Key.Right => Value + SmallChange,
            Key.Down or Key.Left => Value - SmallChange,
            Key.PageUp => Value + LargeChange,
            Key.PageDown => Value - LargeChange,
            Key.Home => Minimum,
            Key.End => Maximum,
            _ => null,
        };
        if (next is { } v)
        {
            SetSnapped(v);
            e.Handled = true;
        }
    }
}

// The track, fill, ticks and squircle-fallback thumb of a Slider, drawn by Purrimer.
public class SliderBar : Control
{
    private const double Thumb = 16;
    private const double Track = 4;
    private const double Tick = 6;
    private const double TickGap = 4;
    private const double Pad = 8;
    private const double Depth = 28;
    private const double Radius = {{ px("borderRadius-small") | num }};

    public static readonly StyledProperty<IBrush?> TrackBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(TrackBrush));

    public static readonly StyledProperty<IBrush?> FillBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(FillBrush));

    public static readonly StyledProperty<IBrush?> DisabledFillBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(DisabledFillBrush));

    public static readonly StyledProperty<IBrush?> KnobBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(KnobBrush));

    public static readonly StyledProperty<IBrush?> DisabledKnobBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(DisabledKnobBrush));

    public static readonly StyledProperty<IBrush?> KnobBorderBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(KnobBorderBrush));

    public static readonly StyledProperty<IBrush?> ActiveKnobBorderBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(ActiveKnobBorderBrush));

    public static readonly StyledProperty<IBrush?> DisabledKnobBorderBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(DisabledKnobBorderBrush));

    public static readonly StyledProperty<IBrush?> TickBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(TickBrush));

    public static readonly StyledProperty<IBrush?> FocusBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(FocusBrush));

    public static readonly StyledProperty<BoxShadows> RestShadowProperty =
        AvaloniaProperty.Register<SliderBar, BoxShadows>(nameof(RestShadow));

    public static readonly StyledProperty<BoxShadows> ActiveShadowProperty =
        AvaloniaProperty.Register<SliderBar, BoxShadows>(nameof(ActiveShadow));

    public static readonly StyledProperty<IBrush?> TouchDisabledFillBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(TouchDisabledFillBrush));

    public static readonly StyledProperty<IBrush?> DetentOnBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(DetentOnBrush));

    public static readonly StyledProperty<IBrush?> BubbleBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(BubbleBrush));

    public static readonly StyledProperty<IBrush?> BubbleTextBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(BubbleTextBrush));

    public static readonly StyledProperty<BoxShadows> BubbleShadowProperty =
        AvaloniaProperty.Register<SliderBar, BoxShadows>(nameof(BubbleShadow));

    public static readonly StyledProperty<FontFamily?> BubbleFontFamilyProperty =
        AvaloniaProperty.Register<SliderBar, FontFamily?>(nameof(BubbleFontFamily));

    public static readonly StyledProperty<IBrush?> MarkBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(MarkBrush));

    public static readonly StyledProperty<IBrush?> MarkOnBrushProperty =
        AvaloniaProperty.Register<SliderBar, IBrush?>(nameof(MarkOnBrush));

    // Touch design measures.
    private const double Hit = {{ px("touch-target-min") | num }};
    private const double Knob = 28;
    private const double Rail = 6;
    private const double Gutter = 14;
    private const double MarkRow = 16;
    private const double Magnet = 10;
    private const double KnobRadius = {{ px("borderRadius-medium") | num }};

    private Slider? _owner;
    private readonly PurrimerSpring[] _shown = { new(0, 0.0005), new(0, 0.0005) };
    private readonly PurrimerSpring[] _scale = { new(1, 0.0005), new(1, 0.0005) };
    private readonly PurrimerSpring[] _lift = { new(0, 0.005), new(0, 0.005) };
    private int _pressed = -1;
    private int _grab = -1;
    private bool _active;
    private Point _start;

    static SliderBar()
    {
        AffectsRender<SliderBar>(TrackBrushProperty, FillBrushProperty, DisabledFillBrushProperty, KnobBrushProperty,
            DisabledKnobBrushProperty, KnobBorderBrushProperty, ActiveKnobBorderBrushProperty,
            DisabledKnobBorderBrushProperty, TickBrushProperty, FocusBrushProperty, RestShadowProperty,
            ActiveShadowProperty, IsPointerOverProperty, TouchDisabledFillBrushProperty, DetentOnBrushProperty,
            BubbleBrushProperty, BubbleTextBrushProperty, BubbleShadowProperty, MarkBrushProperty, MarkOnBrushProperty);
    }

    public SliderBar()
    {
        foreach (var spring in _shown.Concat(_scale).Concat(_lift))
            spring.Changed += _ => InvalidateVisual();
    }

    public IBrush? TouchDisabledFillBrush { get => GetValue(TouchDisabledFillBrushProperty); set => SetValue(TouchDisabledFillBrushProperty, value); }
    public IBrush? DetentOnBrush { get => GetValue(DetentOnBrushProperty); set => SetValue(DetentOnBrushProperty, value); }
    public IBrush? BubbleBrush { get => GetValue(BubbleBrushProperty); set => SetValue(BubbleBrushProperty, value); }
    public IBrush? BubbleTextBrush { get => GetValue(BubbleTextBrushProperty); set => SetValue(BubbleTextBrushProperty, value); }
    public BoxShadows BubbleShadow { get => GetValue(BubbleShadowProperty); set => SetValue(BubbleShadowProperty, value); }
    public FontFamily? BubbleFontFamily { get => GetValue(BubbleFontFamilyProperty); set => SetValue(BubbleFontFamilyProperty, value); }
    public IBrush? MarkBrush { get => GetValue(MarkBrushProperty); set => SetValue(MarkBrushProperty, value); }
    public IBrush? MarkOnBrush { get => GetValue(MarkOnBrushProperty); set => SetValue(MarkOnBrushProperty, value); }

    public IBrush? TrackBrush { get => GetValue(TrackBrushProperty); set => SetValue(TrackBrushProperty, value); }
    public IBrush? FillBrush { get => GetValue(FillBrushProperty); set => SetValue(FillBrushProperty, value); }
    public IBrush? DisabledFillBrush { get => GetValue(DisabledFillBrushProperty); set => SetValue(DisabledFillBrushProperty, value); }
    public IBrush? KnobBrush { get => GetValue(KnobBrushProperty); set => SetValue(KnobBrushProperty, value); }
    public IBrush? DisabledKnobBrush { get => GetValue(DisabledKnobBrushProperty); set => SetValue(DisabledKnobBrushProperty, value); }
    public IBrush? KnobBorderBrush { get => GetValue(KnobBorderBrushProperty); set => SetValue(KnobBorderBrushProperty, value); }
    public IBrush? ActiveKnobBorderBrush { get => GetValue(ActiveKnobBorderBrushProperty); set => SetValue(ActiveKnobBorderBrushProperty, value); }
    public IBrush? DisabledKnobBorderBrush { get => GetValue(DisabledKnobBorderBrushProperty); set => SetValue(DisabledKnobBorderBrushProperty, value); }
    public IBrush? TickBrush { get => GetValue(TickBrushProperty); set => SetValue(TickBrushProperty, value); }
    public IBrush? FocusBrush { get => GetValue(FocusBrushProperty); set => SetValue(FocusBrushProperty, value); }
    public BoxShadows RestShadow { get => GetValue(RestShadowProperty); set => SetValue(RestShadowProperty, value); }
    public BoxShadows ActiveShadow { get => GetValue(ActiveShadowProperty); set => SetValue(ActiveShadowProperty, value); }

    internal Slider? Owner
    {
        get => _owner;
        set
        {
            if (_owner != null)
                _owner.PropertyChanged -= OnOwnerChanged;
            _owner = value;
            if (_owner != null)
                _owner.PropertyChanged += OnOwnerChanged;
            ValuesChanged(false);
        }
    }

    // Thumbs not under a pointer settle onto their values.
    internal void ValuesChanged(bool animate = true)
    {
        if (_owner == null)
            return;
        for (var i = 0; i < _owner.Thumbs; i++)
        {
            if (i == _grab && _active)
                continue;
            var f = _owner.FractionOf(_owner.ValueOf(i));
            if (animate)
                _shown[i].To(f);
            else
                _shown[i].Set(f);
        }
        InvalidateVisual();
    }

    // The bubble shows over a held thumb, or over the keyboard's thumb while focus came from the keyboard.
    internal void FocusChanged()
    {
        if (_owner == null)
            return;
        var keyboard = _owner.Classes.Contains(":focus-visible");
        for (var i = 0; i < 2; i++)
        {
            var on = i == _pressed || (_pressed < 0 && keyboard && _owner.IsFocused && i == _owner.FocusThumb);
            _lift[i].To(on ? 1 : 0);
        }
        InvalidateVisual();
    }

    private bool Touch => _owner?.IsTouch == true;

    private bool Labelled => _owner != null && _owner.MarkList.Any(m => !string.IsNullOrEmpty(m.Label));

    private double LaneLength => Math.Max(1, Bounds.Width - Gutter * 2);

    private double ThumbX(int i) => Gutter + _shown[i].Value * LaneLength;

    private double TouchValueAt(double x) =>
        _owner!.Minimum + Math.Clamp((x - Gutter) / LaneLength, 0, 1) * (_owner.Maximum - _owner.Minimum);

    private void OnOwnerChanged(object? sender, AvaloniaPropertyChangedEventArgs e) => InvalidateVisual();

    private bool Vertical => _owner?.Orientation == Orientation.Vertical;
    private bool Before => _owner != null && (_owner.TickPosition == "both" || _owner.TickPosition == (Vertical ? "left" : "above"));
    private bool After => _owner != null && (_owner.TickPosition == "both" || _owner.TickPosition == (Vertical ? "right" : "below"));

    // The track and its tick rows are centred together across the 28px control.
    private double Centre
    {
        get
        {
            var before = Before ? 1 : 0;
            var group = Track + (Tick + TickGap) * (before + (After ? 1 : 0));
            return (Depth - group) / 2 + (Tick + TickGap) * before + Track / 2;
        }
    }

    protected override Size MeasureOverride(Size availableSize)
    {
        var length = _owner?.Length ?? 0;
        if (Touch)
            return new Size(length > 0 ? length : 120, Hit + (Labelled ? MarkRow : 0));
        return Vertical ? new Size(Depth, length > 0 ? length : 160) : new Size(length > 0 ? length : 120, Depth);
    }

    protected override Size ArrangeOverride(Size finalSize)
    {
        var length = _owner?.Length ?? 0;
        if (Touch)
            return new Size(length > 0 ? length : finalSize.Width, Hit + (Labelled ? MarkRow : 0));
        if (Vertical)
            return new Size(Depth, length > 0 ? length : finalSize.Height);
        return new Size(length > 0 ? length : finalSize.Width, Depth);
    }

    private (double Start, double Length) Span()
    {
        var size = Vertical ? Bounds.Height : Bounds.Width;
        return (Pad, Math.Max(1, size - Pad * 2));
    }

    private double Fraction()
    {
        if (_owner == null || _owner.Maximum <= _owner.Minimum)
            return 0;
        return (Math.Clamp(_owner.Value, _owner.Minimum, _owner.Maximum) - _owner.Minimum) / (_owner.Maximum - _owner.Minimum);
    }

    private double ValueAt(Point p)
    {
        var (start, length) = Span();
        var f = Vertical ? 1 - (p.Y - start) / length : (p.X - start) / length;
        return _owner!.Minimum + Math.Clamp(f, 0, 1) * (_owner.Maximum - _owner.Minimum);
    }

    protected override void OnPointerPressed(PointerPressedEventArgs e)
    {
        base.OnPointerPressed(e);
        if (_owner == null || !_owner.IsEnabled || !e.GetCurrentPoint(this).Properties.IsLeftButtonPressed)
            return;
        if (Touch)
        {
            TouchPressed(e);
            return;
        }
        e.Pointer.Capture(this);
        _owner.Dragging = true;
        _owner.Focus();
        _owner.SetSnapped(ValueAt(e.GetPosition(this)));
        e.Handled = true;
    }

    protected override void OnPointerMoved(PointerEventArgs e)
    {
        base.OnPointerMoved(e);
        if (Touch)
        {
            TouchMoved(e);
            return;
        }
        if (_owner is { Dragging: true })
            _owner.SetSnapped(ValueAt(e.GetPosition(this)));
    }

    protected override void OnPointerReleased(PointerReleasedEventArgs e)
    {
        base.OnPointerReleased(e);
        if (Touch)
        {
            if (_grab >= 0)
            {
                if (!_active)
                {
                    var (lo, hi) = _owner!.LimitsOf(_grab);
                    _owner.SetAt(_grab, Math.Clamp(_owner.Snap(TouchValueAt(e.GetPosition(this).X)), lo, hi));
                }
                Finish();
                e.Pointer.Capture(null);
            }
            return;
        }
        if (_owner is { Dragging: true })
        {
            _owner.Dragging = false;
            e.Pointer.Capture(null);
            InvalidateVisual();
        }
    }

    protected override void OnPointerCaptureLost(PointerCaptureLostEventArgs e)
    {
        base.OnPointerCaptureLost(e);
        if (Touch && _grab >= 0 && _active)
            Finish();
    }

    // Pressing a thumb drags at once; pressing the track drags once the pointer moves sideways, and a tap jumps there.
    // A vertical move is left to scrolling.
    private void TouchPressed(PointerPressedEventArgs e)
    {
        var x = e.GetPosition(this).X;
        var n = _owner!.Thumbs;
        var hit = Enumerable.Range(0, n).Where(i => Math.Abs(x - ThumbX(i)) <= Hit / 2).OrderBy(i => Math.Abs(x - ThumbX(i))).ToList();
        int grab;
        if (hit.Count > 0)
            grab = hit[0];
        else if (n == 2)
            grab = ThumbX(0) == ThumbX(1) ? (x < ThumbX(0) ? 0 : 1) : (Math.Abs(x - ThumbX(0)) <= Math.Abs(x - ThumbX(1)) ? 0 : 1);
        else
            grab = 0;
        _grab = grab;
        _owner.FocusThumb = grab;
        _owner.Focus(NavigationMethod.Pointer);
        _start = e.GetPosition(this);
        _active = hit.Count > 0;
        if (_active)
        {
            e.Pointer.Capture(this);
            Press(grab);
        }
        e.Handled = true;
    }

    private void Press(int i)
    {
        _pressed = i;
        _scale[i].To(PurrimerMotion.PauseLoops ? 1 : 1.2);
        FocusChanged();
    }

    private void TouchMoved(PointerEventArgs e)
    {
        if (_grab < 0 || _owner == null)
            return;
        var p = e.GetPosition(this);
        if (!_active)
        {
            var mx = Math.Abs(p.X - _start.X);
            var my = Math.Abs(p.Y - _start.Y);
            if (mx < 10 && my < 10)
                return;
            if (my > mx)
            {
                _grab = -1;
                return;
            }
            _active = true;
            e.Pointer.Capture(this);
            Press(_grab);
        }
        var (lo, hi) = _owner.LimitsOf(_grab);
        var raw = TouchValueAt(p.X);
        var v = Math.Clamp(_owner.Snap(raw), lo, hi);
        var shown = Math.Clamp(raw, lo, hi);
        foreach (var m in _owner.MarkList)
        {
            if (Math.Abs(_owner.FractionOf(m.Value) - _owner.FractionOf(shown)) * LaneLength <= Magnet)
                shown = m.Value;
        }
        if (_owner.SnapStep <= 0 || shown == _owner.Minimum || shown == _owner.Maximum)
            shown = v;
        _shown[_grab].Set(_owner.FractionOf(shown));
        _owner.SetAt(_grab, v);
        e.Handled = true;
    }

    private void Finish()
    {
        var i = _grab;
        if (i < 0)
            return;
        _grab = -1;
        _active = false;
        _pressed = -1;
        _scale[i].To(1);
        _shown[i].To(_owner!.FractionOf(_owner.ValueOf(i)));
        FocusChanged();
    }

    private void RenderTouch(DrawingContext context)
    {
        var owner = _owner!;
        var enabled = owner.IsEffectivelyEnabled;
        var length = LaneLength;
        var cy = Hit / 2;
        var n = owner.Thumbs;
        var from = n == 2 ? _shown[0].Value : 0;
        var to = n == 2 ? _shown[1].Value : _shown[0].Value;
        context.DrawRectangle(TrackBrush, null, new RoundedRect(new Rect(Gutter, cy - Rail / 2, length, Rail), Rail / 2));
        context.DrawRectangle(enabled ? FillBrush : TouchDisabledFillBrush, null,
            new RoundedRect(new Rect(Gutter + from * length, cy - Rail / 2, (to - from) * length, Rail), Rail / 2));
        foreach (var d in owner.Detents())
        {
            var f = owner.FractionOf(d);
            var on = f >= from - 1e-4 && f <= to + 1e-4;
            context.DrawRectangle(on ? DetentOnBrush : TickBrush, null, new RoundedRect(new Rect(Gutter + f * length - 2, cy - 2, 4, 4), 1));
        }
        var keyboard = owner.Classes.Contains(":focus-visible");
        for (var i = 0; i < n; i++)
        {
            var x = ThumbX(i);
            var scale = _scale[i].Value;
            using (context.PushTransform(Matrix.CreateScale(scale, scale) * Matrix.CreateTranslation(x, cy)))
            {
                var knob = new Rect(-Knob / 2, -Knob / 2, Knob, Knob);
                context.DrawRectangle(enabled ? KnobBrush : DisabledKnobBrush, new Pen(KnobBorderBrush, 1),
                    new RoundedRect(knob.Deflate(0.5), KnobRadius), enabled ? ActiveShadow : default);
                if (enabled && keyboard && owner.IsFocused && i == owner.FocusThumb && _pressed < 0)
                    context.DrawRectangle(null, new Pen(FocusBrush, 2), new RoundedRect(knob.Inflate(3), KnobRadius + 3));
            }
        }
        var marks = owner.MarkList.Where(m => !string.IsNullOrEmpty(m.Label)).ToList();
        foreach (var m in marks)
        {
            var on = Enumerable.Range(0, n).Any(i => owner.ValueOf(i) == m.Value);
            var text = new FormattedText(m.Label!, CultureInfo.CurrentCulture, FlowDirection.LeftToRight,
                new Typeface(owner.FontFamily, FontStyle.Normal, on ? FontWeight.SemiBold : FontWeight.Normal), 14,
                on ? MarkOnBrush : MarkBrush);
            var x = Gutter + owner.FractionOf(m.Value) * length;
            context.DrawText(text, new Point(x - text.Width / 2, Hit - 4 + (20 - text.Height) / 2));
        }
        // The value bubble, above the hit area; Avalonia does not clip a control to its bounds.
        for (var i = 0; i < n; i++)
        {
            var lift = _lift[i].Value;
            if (lift < 0.01)
                continue;
            var label = new FormattedText(owner.Format(owner.ValueOf(i)), CultureInfo.CurrentCulture, FlowDirection.LeftToRight,
                new Typeface(BubbleFontFamily ?? owner.FontFamily, FontStyle.Normal, FontWeight.SemiBold), 14, BubbleTextBrush);
            var w = label.Width + 20;
            var body = new Rect(ThumbX(i) - w / 2, -4 - 28 + (1 - lift) * 6, w, 28);
            using (context.PushOpacity(lift))
            {
                context.DrawRectangle(BubbleBrush, null, new RoundedRect(body, KnobRadius), BubbleShadow);
                context.DrawText(label, new Point(body.X + 10, body.Y + (28 - label.Height) / 2));
            }
        }
    }

    public override void Render(DrawingContext context)
    {
        if (_owner == null)
            return;
        if (Touch)
        {
            RenderTouch(context);
            return;
        }
        var enabled = _owner.IsEffectivelyEnabled;
        var (start, length) = Span();
        var centre = Centre;
        if (Before)
            DrawTicks(context, centre - Track / 2 - TickGap - Tick, start, length);
        if (After)
            DrawTicks(context, centre + Track / 2 + TickGap, start, length);
        var along = start + Fraction() * length;
        Rect track, fill;
        Point thumbCentre;
        if (Vertical)
        {
            track = new Rect(centre - Track / 2, start, Track, length);
            fill = new Rect(centre - Track / 2, start + length - (along - start), Track, along - start);
            thumbCentre = new Point(centre, start + length - (along - start));
        }
        else
        {
            track = new Rect(start, centre - Track / 2, length, Track);
            fill = new Rect(start, centre - Track / 2, along - start, Track);
            thumbCentre = new Point(along, centre);
        }
        context.DrawRectangle(TrackBrush, null, new RoundedRect(track, Track / 2));
        context.DrawRectangle(enabled ? FillBrush : DisabledFillBrush, null, new RoundedRect(fill, Track / 2));
        var thumb = new Rect(thumbCentre.X - Thumb / 2, thumbCentre.Y - Thumb / 2, Thumb, Thumb);
        var active = enabled && (IsPointerOver || _owner.Dragging);
        var border = !enabled ? DisabledKnobBorderBrush : active ? ActiveKnobBorderBrush : KnobBorderBrush;
        context.DrawRectangle(enabled ? KnobBrush : DisabledKnobBrush, new Pen(border, 1),
            new RoundedRect(thumb.Deflate(0.5), Radius), enabled ? (active ? ActiveShadow : RestShadow) : default);
        if (enabled && _owner.Classes.Contains(":focus-visible"))
            context.DrawRectangle(null, new Pen(FocusBrush, 2), new RoundedRect(thumb.Inflate(3), Radius + 3));
    }

    private void DrawTicks(DrawingContext context, double across, double start, double length)
    {
        var range = _owner!.Maximum - _owner.Minimum;
        var every = _owner.TickInterval > 0 ? _owner.TickInterval : _owner.LargeChange;
        if (range <= 0 || every <= 0)
            return;
        for (var t = _owner.Minimum; t <= _owner.Maximum + 1e-9; t += every)
        {
            var at = start + (t - _owner.Minimum) / range * length;
            var rect = Vertical ? new Rect(across, start + length - (at - start) - 0.5, Tick, 1) : new Rect(at - 0.5, across, 1, Tick);
            context.DrawRectangle(TickBrush, null, rect);
        }
    }
}
