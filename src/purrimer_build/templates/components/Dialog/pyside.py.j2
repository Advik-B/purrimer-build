from __future__ import annotations

from PySide6.QtGui import QPainter
from PySide6.QtWidgets import QDialog, QFrame, QHBoxLayout, QLabel, QVBoxLayout, QWidget

from ..theme import theme
from .icon_button import IconButton


class Dialog(QDialog):
    """A modal dialog with a title row and close button. Add widgets to `body` and buttons to `footer`."""

    def __init__(self, title: str, parent: QWidget | None = None, width: int = 440) -> None:
        super().__init__(parent)
        self.setWindowTitle(title)
        self.setModal(True)
        self.setMinimumWidth(width)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        header = QHBoxLayout()
        header.setContentsMargins(16, 0, 8, 0)
        self.title = QLabel(title)
        self.title.setStyleSheet(theme.text_css({{ "text-title-medium" | tok }}))
        header.addWidget(self.title, 1)
        close = IconButton("x", "Close", variant="invisible")
        close.clicked.connect(self.reject)
        header.addWidget(close)
        head = QWidget()
        head.setFixedHeight(48)
        head.setLayout(header)
        layout.addWidget(head)
        divider = QFrame()
        divider.setFixedHeight(1)
        divider.setObjectName("pmDialogDivider")
        layout.addWidget(divider)
        self.body = QVBoxLayout()
        self.body.setContentsMargins(16, 16, 16, 16)
        self.body.setSpacing(16)
        layout.addLayout(self.body, 1)
        self.footer = QHBoxLayout()
        self.footer.setContentsMargins(16, 0, 16, 16)
        self.footer.addStretch(1)
        layout.addLayout(self.footer)
        theme.changed.connect(self.update)

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        painter.fillRect(self.rect(), theme.color({{ "overlay-bgColor" | tok }}))
        painter.fillRect(0, 48, self.width(), 1, theme.color({{ "borderColor-default" | tok }}))
