<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:ChipGroup}" TargetType="pm:ChipGroup">
    <Setter Property="Fill" Value="{{ "bgColor-default" | tok }}" />
    <Setter Property="PressedFill" Value="{{ "control-transparent-bgColor-selected" | tok }}" />
    <Setter Property="OnFill" Value="{{ "bgColor-accent-muted" | tok }}" />
    <Setter Property="Stroke" Value="{{ "borderColor-emphasis" | tok }}" />
    <Setter Property="OnStroke" Value="{{ "borderColor-accent-emphasis" | tok }}" />
    <Setter Property="DisabledStroke" Value="{{ "borderColor-default" | tok }}" />
    <Setter Property="Ink" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="MutedInk" Value="{{ "fgColor-muted" | tok }}" />
    <Setter Property="OnInk" Value="{{ "fgColor-accent" | tok }}" />
    <Setter Property="DisabledInk" Value="{{ "fgColor-disabled" | tok }}" />
    <Setter Property="FocusBrush" Value="{{ "focus-outlineColor" | tok }}" />
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="Cursor" Value="Hand" />
  </ControlTheme>
</ResourceDictionary>
