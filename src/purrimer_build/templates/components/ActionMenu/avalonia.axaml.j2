<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:ActionMenuSurface}" TargetType="pm:ActionMenuSurface">
    <Setter Property="Fill" Value="{{ "overlay-bgColor" | tok }}" />
    <Setter Property="Stroke" Value="{{ "borderColor-default" | tok }}" />
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="6" BlurRadius="10" Opacity="0.7" Color="{DynamicResource PmOverlayBackdropBgColorColor}" />
    </Setter>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type pm:ActionMenu}" TargetType="pm:ActionMenu">
    <Setter Property="Foreground" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="Background" Value="{{ "button-default-bgColor-rest" | tok }}" />
    <Setter Property="BorderBrush" Value="{{ "button-default-borderColor-rest" | tok }}" />
    <Setter Property="BorderThickness" Value="{{ "borderWidth-thin" | tokx("Thickness") }}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Template">
      <ControlTemplate TargetType="pm:ActionMenu">
        <Panel>
          <Border Name="PART_Anchor" Height="{{ "control-medium-size" | tok }}" MinWidth="{{ "control-medium-size" | tok }}" Padding="12,0"
                  CornerRadius="{{ "borderRadius-medium" | tok }}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
            <Border.Transitions>
              <Transitions>
                <BrushTransition Property="Background" Duration="{{ "duration-fast" | tok }}" />
              </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
              <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center" IsVisible="{TemplateBinding HasText}" />
              <pm:Icon Name="anchorIcon" IconName="{TemplateBinding AnchorIcon}" Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <Border Name="focusRing" Margin="-4" CornerRadius="10" BorderThickness="2" IsVisible="False"
                  BorderBrush="{{ "focus-outlineColor" | tok }}" />
          <Popup Name="PART_Popup" IsLightDismissEnabled="True" ShouldUseOverlayLayer="True" Placement="AnchorAndGravity"
                 PlacementAnchor="TopLeft" PlacementGravity="BottomRight">
            <Panel Width="{TemplateBinding MenuWidth}" Margin="0,0,24,24">
              <pm:ActionMenuSurface Name="PART_Surface" />
              <StackPanel>
                <Panel Name="PART_Face" Height="{TemplateBinding AnchorHeight}" Width="{TemplateBinding AnchorWidth}" HorizontalAlignment="Left"
                       Background="Transparent" Margin="0,0,0,-1">
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="{TemplateBinding Label}" VerticalAlignment="Center" Foreground="{{ "fgColor-default" | tok }}"
                               IsVisible="{TemplateBinding HasText}" />
                    <pm:Icon IconName="{TemplateBinding AnchorIcon}" Foreground="{{ "fgColor-default" | tok }}" VerticalAlignment="Center" />
                  </StackPanel>
                </Panel>
                <pm:ActionList Name="PART_List" Margin="1,0,1,1" FontWeight="Normal" />
              </StackPanel>
            </Panel>
          </Popup>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{{ "button-default-bgColor-hover" | tok }}" />
    </Style>
    <Style Selector="^[IsIconOnly=True]">
      <Setter Property="Foreground" Value="{{ "fgColor-muted" | tok }}" />
    </Style>
    <Style Selector="^[IsIconOnly=True] /template/ Border#PART_Anchor">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="{{ "control-medium-size" | tok }}" />
    </Style>
    <Style Selector="^[Variant=primary]">
      <Setter Property="Background" Value="{{ "button-primary-bgColor-rest" | tok }}" />
      <Setter Property="BorderBrush" Value="{{ "button-primary-bgColor-rest" | tok }}" />
      <Setter Property="Foreground" Value="{{ "fgColor-onEmphasis" | tok }}" />
    </Style>
    <Style Selector="^[Variant=primary]:pointerover">
      <Setter Property="Background" Value="{{ "button-primary-bgColor-hover" | tok }}" />
      <Setter Property="BorderBrush" Value="{{ "button-primary-bgColor-hover" | tok }}" />
    </Style>
    <Style Selector="^[Variant=invisible]">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="^[Variant=invisible]:pointerover">
      <Setter Property="Background" Value="{{ "control-transparent-bgColor-hover" | tok }}" />
    </Style>
    <Style Selector="^:focus-visible:not(:open) /template/ Border#focusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
