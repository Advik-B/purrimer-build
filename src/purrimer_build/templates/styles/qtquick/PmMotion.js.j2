.pragma library
// {{ note }}
// The motion catalog: the same keyframes as the web's pm-m-* classes, per kind ("reduced" is sleepy under reduced
// motion: fades only). Each track is [[offset, value, easing or null], ...]; null means the animation's own curve.

var CATALOG = {
{% for kind in ["sleepy", "playful", "reduced"] %}
    "{{ kind }}": {{ motion.table(tokens, kind) | tojson }}{{ "," if not loop.last }}
{% endfor %}
}

var EASINGS = {{ motion.easings(tokens) | tojson }}

var STAGGER = {{ {"sleepy": motion.stagger_ms(tokens, "sleepy"), "playful": motion.stagger_ms(tokens, "playful"), "reduced": 0} | tojson }}

var REST = {{ motion.rest | tojson }}

var CLAMPED = { "opacity": true, "ringO": true, "wash": true, "draw": true }

function tableFor(kind) {
    return CATALOG[kind === "still" ? "reduced" : kind] || CATALOG.sleepy
}

function has(name) {
    return CATALOG.sleepy[name] !== undefined
}

function entry(name, kind) {
    return tableFor(kind)[name]
}

function cubicBezier(x1, y1, x2, y2, x) {
    if (x <= 0)
        return 0
    if (x >= 1)
        return 1
    function bx(t) { return ((1 - 3 * x2 + 3 * x1) * t + (3 * x2 - 6 * x1)) * t * t + 3 * x1 * t }
    function by(t) { return ((1 - 3 * y2 + 3 * y1) * t + (3 * y2 - 6 * y1)) * t * t + 3 * y1 * t }
    var t = x
    for (var i = 0; i < 8; i++) {
        var err = bx(t) - x
        if (Math.abs(err) < 1e-6)
            return by(t)
        var d = (3 * (1 - 3 * x2 + 3 * x1) * t + 2 * (3 * x2 - 6 * x1)) * t + 3 * x1
        if (Math.abs(d) < 1e-6)
            break
        t -= err / d
    }
    var lo = 0, hi = 1
    t = x
    for (var j = 0; j < 30; j++) {
        if (bx(t) < x)
            lo = t
        else
            hi = t
        t = (lo + hi) / 2
    }
    return by(t)
}

function ease(spec, p) {
    if (spec[0] === "linear")
        return p
    if (spec[0] === "points") {
        var pts = spec[1]
        if (p <= pts[0][0])
            return pts[0][1]
        for (var i = 1; i < pts.length; i++) {
            if (p <= pts[i][0]) {
                var x0 = pts[i - 1][0], y0 = pts[i - 1][1], x1 = pts[i][0], y1 = pts[i][1]
                return x1 === x0 ? y1 : y0 + (y1 - y0) * (p - x0) / (x1 - x0)
            }
        }
        return pts[pts.length - 1][1]
    }
    return cubicBezier(spec[1], spec[2], spec[3], spec[4], p)
}

function trackAt(track, p, fallback) {
    if (p <= track[0][0])
        return track[0][1]
    for (var i = 1; i < track.length; i++) {
        var a = track[i - 1], b = track[i]
        if (p <= b[0]) {
            if (b[0] === a[0])
                return b[1]
            return a[1] + (b[1] - a[1]) * ease(a[2] ? EASINGS[a[2]] : fallback, (p - a[0]) / (b[0] - a[0]))
        }
    }
    return track[track.length - 1][1]
}

function rest() {
    var out = {}
    for (var k in REST)
        out[k] = REST[k]
    return out
}

// Every channel of `name` at `progress` (0 to 1) of one iteration, in an effective kind ("sleepy", "playful" or
// "still").
function sample(name, kind, progress, easing) {
    var e = entry(name, kind)
    var p = e.reverse ? 1 - progress : progress
    var fallback = EASINGS[easing || e.ease]
    var out = rest()
    for (var ch in e.tracks) {
        var v = trackAt(e.tracks[ch], p, fallback)
        if (CLAMPED[ch])
            v = Math.min(1, Math.max(0, v))
        else if (ch === "blur")
            v = Math.max(0, v)
        out[ch] = v
    }
    if (e.tracks.orbit) {
        var a = out.orbit * Math.PI / 180
        out.tx += e.orbit * Math.cos(a)
        out.ty += e.orbit * Math.sin(a)
    }
    return out
}

function mul(a, b) {
    return [
        a[0] * b[0] + a[1] * b[3] + a[2] * b[6], a[0] * b[1] + a[1] * b[4] + a[2] * b[7], a[0] * b[2] + a[1] * b[5] + a[2] * b[8],
        a[3] * b[0] + a[4] * b[3] + a[5] * b[6], a[3] * b[1] + a[4] * b[4] + a[5] * b[7], a[3] * b[2] + a[4] * b[5] + a[5] * b[8],
        a[6] * b[0] + a[7] * b[3] + a[8] * b[6], a[6] * b[1] + a[7] * b[4] + a[8] * b[7], a[6] * b[2] + a[7] * b[5] + a[8] * b[8]
    ]
}

// The frame's CSS transform as a 3x3 matrix (column vectors, row-major) about the origin, in item coordinates:
// translate, rotate, rotateX in perspective, rotateY, scale and skewX.
function homography(f, w, h, origin, perspective) {
    var ox = origin[0] * w, oy = origin[1] * h
    var r = f.rot * Math.PI / 180
    var m = [1, 0, ox + f.tx + f.txp * w, 0, 1, oy + f.ty + f.typ * h, 0, 0, 1]
    m = mul(m, [Math.cos(r), -Math.sin(r), 0, Math.sin(r), Math.cos(r), 0, 0, 0, 1])
    if (f.rotX) {
        var a = f.rotX * Math.PI / 180
        m = mul(m, [1, 0, 0, 0, Math.cos(a), 0, 0, -Math.sin(a) / (perspective || 1e9), 1])
    }
    var sx = f.sx * Math.cos(f.rotY * Math.PI / 180)
    m = mul(m, [sx, 0, 0, 0, f.sy, 0, 0, 0, 1])
    if (f.skew)
        m = mul(m, [1, Math.tan(f.skew * Math.PI / 180), 0, 0, 1, 0, 0, 0, 1])
    return mul(m, [1, 0, -ox, 0, 1, -oy, 0, 0, 1])
}

// The same transform as the 16 values of a Qt.matrix4x4 for a Matrix4x4 item transform.
function matrix(f, w, h, origin, perspective) {
    var m = homography(f, w, h, origin, perspective)
    return [m[0], m[1], 0, m[2], m[3], m[4], 0, m[5], 0, 0, 1, 0, m[6], m[7], 0, m[8]]
}

function stagger(kind) {
    return STAGGER[kind === "still" ? "reduced" : kind] || 0
}

// Sets a property a delegate declares, if it declares it (delegates are loaded as plain QObjects).
function assign(target, name, value) {
    if (target && name in target)
        target[name] = value
}
