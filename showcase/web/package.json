{
  "name": "purrimer-showcase-web",
  "private": true,
  "type": "module",
  "description": "Renders the examples for the css, svelte and solid targets and screenshots them.",
  "scripts": {
    "check:svelte": "svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "check:solid": "tsc -p tsconfig.solid.json",
    "check:harness": "tsc -p tsconfig.node.json",
    "build": "vite build",
    "shoot": "node shoot.ts"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "3.0.1",
    "@solidjs/web": "2.0.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.19.2",
    "playwright": "1.65.1",
    "solid-js": "2.0.3",
    "svelte": "5.59.1",
    "svelte-check": "4.7.8",
    "typescript": "^6.0.0",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24"
  }
}
