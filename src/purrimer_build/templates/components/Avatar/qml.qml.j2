// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Effects

Item {
    id: root
    property string name
    property url source
    property int size: 32
    property bool square: false
    readonly property string initials: name.split(/\s+/).filter(w => w.length > 0).slice(0, 2).map(w => w[0].toUpperCase()).join("")

    implicitWidth: size
    implicitHeight: size
    Accessible.role: Accessible.Graphic
    Accessible.name: name

    Rectangle {
        id: disc
        anchors.fill: parent
        radius: root.square ? {{ "borderRadius-small" | tok }} : width / 2
        color: {{ "bgColor-accent-muted" | tok }}
        border.width: 1
        border.color: {{ "borderColor-muted" | tok }}
        Text {
            anchors.centerIn: parent
            visible: image.status !== Image.Ready
            text: root.initials
            font.family: {{ "text-body-medium" | tok }}.family
            font.pixelSize: Math.round(root.size * 0.4)
            font.weight: Font.DemiBold
            color: {{ "fgColor-accent" | tok }}
        }
    }

    Image {
        id: image
        anchors.fill: parent
        source: root.source
        fillMode: Image.PreserveAspectCrop
        visible: false
        smooth: true
    }

    Rectangle {
        id: mask
        anchors.fill: parent
        radius: disc.radius
        visible: false
        layer.enabled: true
    }

    MultiEffect {
        anchors.fill: parent
        visible: image.status === Image.Ready
        source: image
        maskEnabled: true
        maskSource: mask
    }
}
