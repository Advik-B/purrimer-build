<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:FAB}" TargetType="pm:FAB">
    <Setter Property="Background" Value="{{ "button-primary-bgColor-rest" | tok }}" />
    <Setter Property="Foreground" Value="{{ "fgColor-onEmphasis" | tok }}" />
    <Setter Property="CornerRadius" Value="{{ "borderRadius-large" | tok }}" />
    <Setter Property="Height" Value="{{ "mobile-fab-size" | tok }}" />
    <Setter Property="MinWidth" Value="{{ "mobile-fab-size" | tok }}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="Padding" Value="16,0" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="RenderTransform" Value="scale(1)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="{{ "duration-base" | tok }}" Easing="{{ "easing-sleepy-enter" | tok }}" />
      </Transitions>
    </Setter>
    <Setter Property="Template">
      <ControlTemplate TargetType="pm:FAB">
        <Panel>
          <Border Name="focusRing" Margin="-4" IsVisible="False" IsHitTestVisible="False"
                  BorderThickness="2" BorderBrush="{{ "focus-outlineColor" | tok }}"
                  CornerRadius="{{ "borderRadius-xlarge" | tok }}" />
          <pm:HoldMenu Name="PART_Hold" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                       Layout="{TemplateBinding ActionsLayout}" TapOpens="{TemplateBinding TapOpens}">
            <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}"
                    Padding="{TemplateBinding Padding}" BoxShadow="{{ "shadow-floating-small" | tok }}">
              <StackPanel Name="row" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <pm:Icon IconName="{TemplateBinding IconName}" Size="24" VerticalAlignment="Center" />
                <TextBlock Name="label" Text="{TemplateBinding Label}" VerticalAlignment="Center" IsVisible="{TemplateBinding IsExtended}"
                           MaxWidth="240" TextTrimming="None">
                  <TextBlock.Transitions>
                    <Transitions>
                      <DoubleTransition Property="MaxWidth" Duration="{{ "duration-base" | tok }}" />
                      <DoubleTransition Property="Opacity" Duration="{{ "duration-fast" | tok }}" />
                    </Transitions>
                  </TextBlock.Transitions>
                </TextBlock>
              </StackPanel>
            </Border>
          </pm:HoldMenu>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^[IsExtended=True]">
      <Setter Property="Padding" Value="16,0,20,0" />
    </Style>
    <Style Selector="^[IsExtended=True][IsFolded=True]">
      <Setter Property="Padding" Value="16,0" />
    </Style>
    <Style Selector="^[IsExtended=True][IsFolded=True] /template/ StackPanel#row">
      <Setter Property="Spacing" Value="0" />
    </Style>
    <Style Selector="^[IsExtended=True][IsFolded=True] /template/ TextBlock#label">
      <Setter Property="MaxWidth" Value="0" />
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="^:pointerover">
      <Setter Property="Background" Value="{{ "button-primary-bgColor-hover" | tok }}" />
    </Style>
    <Style Selector="^:pressed">
      <Setter Property="Background" Value="{{ "button-primary-bgColor-active" | tok }}" />
      <Setter Property="RenderTransform" Value="scale(0.96)" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#focusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
