<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="PmRadio" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="Template">
      <ControlTemplate TargetType="RadioButton">
        <Grid ColumnDefinitions="Auto,*" Background="{TemplateBinding Background}">
          <Panel Width="16" Height="16" VerticalAlignment="Center">
            <Border Name="focusRing" Margin="-4" CornerRadius="12" BorderThickness="2" IsVisible="False"
                    BorderBrush="{{ "focus-outlineColor" | tok }}" />
            <Border Name="box" CornerRadius="8" Background="{{ "control-bgColor-rest" | tok }}"
                    BorderBrush="{{ "control-borderColor-rest" | tok }}" BorderThickness="{{ "borderWidth-thin" | tokx("Thickness") }}">
              <Ellipse Name="dot" Width="6" Height="6" Fill="{{ "fgColor-onEmphasis" | tok }}" IsVisible="False" />
            </Border>
          </Panel>
          <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                            RecognizesAccessKey="True" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </Grid>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#box">
      <Setter Property="BorderBrush" Value="{{ "borderColor-emphasis" | tok }}" />
    </Style>
    <Style Selector="^:checked /template/ Border#box, ^:indeterminate /template/ Border#box">
      <Setter Property="Background" Value="{{ "bgColor-accent-emphasis" | tok }}" />
      <Setter Property="BorderBrush" Value="{{ "bgColor-accent-emphasis" | tok }}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{{ "fgColor-disabled" | tok }}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#box">
      <Setter Property="Background" Value="{{ "bgColor-disabled" | tok }}" />
      <Setter Property="BorderBrush" Value="{{ "bgColor-disabled" | tok }}" />
    </Style>
    <Style Selector="^:focus-visible /template/ Border#focusRing">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:checked /template/ Ellipse#dot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
  <ControlTheme x:Key="{x:Type RadioButton}" TargetType="RadioButton" BasedOn="{StaticResource PmRadio}" />
</ResourceDictionary>
