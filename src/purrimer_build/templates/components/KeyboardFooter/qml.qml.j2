import QtQuick

// A footer for a screen's primary action: assign it to MobileScreen.footer with one or two Buttons, the primary one
// last. While the on-screen keyboard is up it gains the height the keyboard covers, so its buttons ride above it.
Rectangle {
    id: root
    default property alias content: column.data
    // Qt.inputMethod is typed as a plain QObject, so its members are read through a var.
    readonly property var inputMethod: Qt.inputMethod
    readonly property real keyboardCover: inputMethod.visible && Window.window ? Math.max(0, Window.window.height - inputMethod.keyboardRectangle.y / Screen.devicePixelRatio) : 0

    implicitHeight: column.implicitHeight + 24 + keyboardCover
    color: {{ "bgColor-default" | tok }}

    Rectangle {
        width: parent.width
        height: {{ "borderWidth-thin" | tok }}
        color: {{ "borderColor-default" | tok }}
    }

    Column {
        id: column
        x: {{ "mobile-gutter" | tok }}
        y: 12
        width: parent.width - 2 * {{ "mobile-gutter" | tok }}
        spacing: 8
        onChildrenChanged: {
            for (let i = 0; i < children.length; i++)
                children[i].width = Qt.binding(() => column.width)
        }
    }
}
