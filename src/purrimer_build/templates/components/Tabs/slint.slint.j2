// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";

export component Tabs inherits VerticalLayout {
    in property <[string]> items;
    in-out property <int> selected;
    callback activated(int);

    HorizontalLayout {
        alignment: start;
        spacing: 2px;
        z: 1;
        for item[i] in root.items: Rectangle {
            property <bool> current: i == root.selected;
            height: 32px;
            width: label.preferred-width + 28px;
            border-top-left-radius: {{ "borderRadius-medium" | tok }};
            border-top-right-radius: {{ "borderRadius-medium" | tok }};
            background: current ? {{ "bgColor-default" | tok }} : touch.has-hover ? {{ "control-transparent-bgColor-hover" | tok }} : transparent;
            border-width: current ? {{ "borderWidth-thin" | tok }} : 0px;
            border-color: {{ "borderColor-default" | tok }};
            accessible-role: tab;
            accessible-label: item;
            accessible-item-selectable: true;
            accessible-item-selected: current;
            accessible-action-default => { root.selected = i; root.activated(i); }
            if current: Rectangle {
                x: 1px;
                y: parent.height - 1px;
                width: parent.width - 2px;
                height: 2px;
                background: {{ "bgColor-default" | tok }};
            }
            label := Text {
                text: item;
                color: current ? {{ "fgColor-default" | tok }} : {{ "fgColor-muted" | tok }};
                font-family: {{ "text-body-medium" | tok }}.font-family;
                font-size: 14px;
                font-weight: current ? 600 : 500;
            }
            touch := TouchArea { mouse-cursor: pointer; clicked => { root.selected = i; root.activated(i); } }
        }
    }

    Rectangle {
        vertical-stretch: 1;
        border-top-right-radius: {{ "borderRadius-large" | tok }};
        border-bottom-left-radius: {{ "borderRadius-large" | tok }};
        border-bottom-right-radius: {{ "borderRadius-large" | tok }};
        background: {{ "bgColor-default" | tok }};
        border-width: {{ "borderWidth-thin" | tok }};
        border-color: {{ "borderColor-default" | tok }};
        accessible-role: tab-panel;
        VerticalLayout {
            padding: {{ "stack-padding-normal" | tok }};
            @children
        }
    }
}
