.pm-sheet-layer { position: fixed; inset: 0; z-index: 100; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
.pm-sheet-scrim { position: absolute; inset: 0; background: {{ "overlay-backdrop-bgColor" | tok }}; animation: pm-fade-in {{ "duration-slow" | tok }} {{ "easing-standard" | tok }} backwards; }
.pm-sheet {
  position: relative;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: {{ "mobile-sheet-maxWidth" | tok }};
  max-height: calc(100% - 48px);
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom, 0px);
  color: {{ "fgColor-default" | tok }};
  background: {{ "overlay-bgColor" | tok }};
  border: {{ "borderWidth-thin" | tok }} solid {{ "borderColor-default" | tok }};
  border-bottom: 0;
  border-radius: {{ "borderRadius-xlarge" | tok }} {{ "borderRadius-xlarge" | tok }} 0 0;
  box-shadow: {{ "shadow-floating-large" | tok }};
  font: 400 14px/20px var(--font-sans);
  outline: none;
  animation: pm-sheet-in {{ "duration-slow" | tok }} {{ "easing-sleepy-enter" | tok }} both;
}
/* Once a finger has moved the sheet, a spring owns its position. */
.pm-sheet--sprung { animation: none; }
.pm-sheet--half { height: 50%; }
.pm-sheet--full { height: calc(100% - 48px); }
.pm-sheet__handle { flex: none; padding: 8px {{ "mobile-gutter" | tok }} 0; }
.pm-sheet__handle--drag { touch-action: none; cursor: grab; }
.pm-sheet--dragging .pm-sheet__handle--drag { cursor: grabbing; }
.pm-sheet__grabber { display: block; width: 36px; height: 5px; margin: 0 auto 8px; border-radius: {{ "borderRadius-full" | tok }}; background: {{ "borderColor-emphasis" | tok }}; }
.pm-sheet__head { padding: 4px 0 12px; }
.pm-sheet__title { margin: 0; font: 600 18px/24px var(--font-heading); }
.pm-sheet__desc { margin: 4px 0 0; font-size: 14px; line-height: 20px; color: {{ "fgColor-muted" | tok }}; }
.pm-sheet__body { flex: 1 1 auto; min-height: 0; overflow-x: hidden; overflow-y: auto; overscroll-behavior: contain; padding: 0 {{ "mobile-gutter" | tok }} 16px; }
.pm-sheet__actions { flex: none; display: flex; flex-direction: column; gap: 8px; padding: 12px {{ "mobile-gutter" | tok }} 16px; border-top: {{ "borderWidth-thin" | tok }} solid {{ "borderColor-muted" | tok }}; }
.pm-sheet__actions > * { width: 100%; }
.pm-sheet-layer--closing .pm-sheet:not(.pm-sheet--sprung) { animation: pm-sheet-out {{ "duration-sleepy-exit" | tok }} {{ "easing-sleepy-exit" | tok }} both; }
.pm-sheet-layer--closing .pm-sheet-scrim { animation: pm-fade-out {{ "duration-sleepy-exit" | tok }} {{ "easing-standard" | tok }} both; }
/* A sheet drawn in place, for docs and previews. */
.pm-sheet--inline { max-height: none; padding-bottom: 0; border-bottom: {{ "borderWidth-thin" | tok }} solid {{ "borderColor-default" | tok }}; border-radius: {{ "borderRadius-xlarge" | tok }}; box-shadow: {{ "shadow-floating-small" | tok }}; animation: none; }
@keyframes pm-sheet-in { from { translate: 0 100%; } }
@keyframes pm-sheet-out { to { translate: 0 100%; } }
@media (prefers-reduced-motion: reduce) {
  .pm-sheet { animation-name: pm-fade-in; animation-duration: {{ "duration-reduced" | tok }}; }
  .pm-sheet-layer--closing .pm-sheet:not(.pm-sheet--sprung) { animation-name: pm-fade-out; }
}
