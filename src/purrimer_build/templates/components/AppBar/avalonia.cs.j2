using System;
using Avalonia;
using Avalonia.Controls;
using Avalonia.Controls.Metadata;
using Avalonia.Controls.Primitives;
using Avalonia.Input;
using Avalonia.Interactivity;
using Avalonia.Media;

namespace {{ ns }};

// The top bar of a mobile screen. Content holds the trailing actions, usually up to two IconButtons.
[TemplatePart("PART_Back", typeof(Button))]
public class AppBar : ContentControl
{
    public static readonly StyledProperty<string?> TitleProperty =
        AvaloniaProperty.Register<AppBar, string?>(nameof(Title));

    public static readonly StyledProperty<bool> ShowBackProperty =
        AvaloniaProperty.Register<AppBar, bool>(nameof(ShowBack));

    public static readonly StyledProperty<bool> IsLargeProperty =
        AvaloniaProperty.Register<AppBar, bool>(nameof(IsLarge));

    public static readonly StyledProperty<bool> IsElevatedProperty =
        AvaloniaProperty.Register<AppBar, bool>(nameof(IsElevated));

    public static readonly RoutedEvent<RoutedEventArgs> BackRequestedEvent =
        RoutedEvent.Register<AppBar, RoutedEventArgs>(nameof(BackRequested), RoutingStrategies.Bubble);

    private Button? _back;

    public string? Title
    {
        get => GetValue(TitleProperty);
        set => SetValue(TitleProperty, value);
    }

    public bool ShowBack
    {
        get => GetValue(ShowBackProperty);
        set => SetValue(ShowBackProperty, value);
    }

    public bool IsLarge
    {
        get => GetValue(IsLargeProperty);
        set => SetValue(IsLargeProperty, value);
    }

    public bool IsElevated
    {
        get => GetValue(IsElevatedProperty);
        set => SetValue(IsElevatedProperty, value);
    }

    public event EventHandler<RoutedEventArgs>? BackRequested
    {
        add => AddHandler(BackRequestedEvent, value);
        remove => RemoveHandler(BackRequestedEvent, value);
    }

    // Shrinks a large title toward the bar's title size, from 0 (full) to 1; MobileScreen sets it as the body scrolls.
    public static readonly StyledProperty<double> CollapseProperty =
        AvaloniaProperty.Register<AppBar, double>(nameof(Collapse));

    private TextBlock? _largeTitle;

    public double Collapse
    {
        get => GetValue(CollapseProperty);
        set => SetValue(CollapseProperty, value);
    }

    protected override void OnApplyTemplate(TemplateAppliedEventArgs e)
    {
        if (_back != null)
            _back.Click -= OnBackClick;
        base.OnApplyTemplate(e);
        _back = e.NameScope.Find<Button>("PART_Back");
        if (_back != null)
            _back.Click += OnBackClick;
        _largeTitle = e.NameScope.Find<TextBlock>("largeTitle");
        ApplyCollapse();
    }

    protected override void OnPropertyChanged(AvaloniaPropertyChangedEventArgs change)
    {
        base.OnPropertyChanged(change);
        if (change.Property == CollapseProperty)
            ApplyCollapse();
    }

    private void ApplyCollapse()
    {
        if (_largeTitle == null)
            return;
        var c = Math.Clamp(Collapse, 0, 1);
        _largeTitle.FontSize = 28 - 10 * c;
        _largeTitle.Margin = new Thickness({{ px("mobile-gutter") | num }}, 0, {{ px("mobile-gutter") | num }}, 8 - 4 * c);
    }

    private void OnBackClick(object? sender, RoutedEventArgs e)
    {
        e.Handled = true;
        RaiseEvent(new RoutedEventArgs(BackRequestedEvent, this));
    }
}
