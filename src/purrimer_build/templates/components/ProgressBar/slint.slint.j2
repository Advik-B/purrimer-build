// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { PmMotionCatalog, PmMotionControls, PmTween } from "../motion.slint";

export component ProgressBar inherits Rectangle {
    // 0 to 100
    in property <float> value;
    in property <bool> indeterminate;
    in property <string> tone: "accent";
    // sleepy or playful; empty follows PurrimerMotion.playful. Slint cannot see a MotionScope, so set it by hand.
    in property <string> kind: "";
    in property <bool> reduce: false;
    property <PmMotionControls> motion: PmMotionCatalog.controls(PmMotionCatalog.kind-index(root.kind, root.reduce));
    height: 8px;
    border-radius: 4px;
    clip: true;
    background: {{ "controlTrack-bgColor-rest" | tok }};
    accessible-role: progress-indicator;
    accessible-value: indeterminate ? "" : round(value) + "%";

    // A new value eases in on the kind's curve.
    fill := PmTween {
        target: Math.clamp(root.value, 0, 100);
        length: root.motion.progress-dur;
        easing: root.motion.progress-ease;
    }

    Rectangle {
        x: root.indeterminate ? (-0.4 + 1.4 * mod(animation-tick() / 1400ms, 1)) * root.width : 0px;
        width: root.indeterminate ? root.width * 0.4 : root.width * fill.value / 100;
        height: parent.height;
        border-radius: 4px;
        background: root.tone == "success" ? {{ "bgColor-success-emphasis" | tok }} : root.tone == "attention" ? {{ "bgColor-attention-emphasis" | tok }} : root.tone == "danger" ? {{ "bgColor-danger-emphasis" | tok }} : {{ "bgColor-accent-emphasis" | tok }};
    }
}
