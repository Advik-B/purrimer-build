// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { PmMotionCatalog, PmMotionControls, PmTween } from "../motion.slint";

export component Toggle inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { self.activate(); }

    function activate() {
        root.checked = !root.checked;
        root.toggled(root.checked);
    }

    callback toggled(bool);
    // sleepy or playful; empty follows PurrimerMotion.playful. Slint cannot see a MotionScope, so set it by hand.
    in property <string> kind: "";
    in property <bool> reduce: false;
    property <PmMotionControls> motion: PmMotionCatalog.controls(PmMotionCatalog.kind-index(root.kind, root.reduce));
    out property <bool> has-focus: focus.has-focus;
    min-height: 20px;
    accessible-label: text;
    accessible-enabled: enabled;

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.activate(); }
    }

    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " ") {
                root.activate();
                return accept;
            }
            reject
        }
    }

    // The handle travels on a standard curve when sleepy and a spring when playful. In a playful scope it also
    // stretches to 120% while held, keeping the edge it rests on.
    travel := PmTween {
        target: root.checked ? 1 : 0;
        length: root.motion.toggle-dur;
        easing: root.motion.toggle-ease;
    }
    stretch := PmTween {
        target: touch.pressed && root.enabled && root.motion.stretch != 1 ? 1 : 0;
        length: root.motion.toggle-dur;
        easing: root.motion.toggle-ease;
    }
    property <float> stretch-by: root.motion.stretch;

    // TouchArea and FocusScope above cover the whole row; only the visible parts are laid out.
    HorizontalLayout {
        spacing: 12px;
        alignment: start;

        if root.text != "": Text {
            text: root.text;
            color: root.enabled ? {{ "fgColor-default" | tok }} : {{ "fgColor-disabled" | tok }};
            font-family: {{ "text-body-medium" | tok }}.font-family;
            font-size: 14px;
            vertical-alignment: center;
        }

        Rectangle {
            width: 36px;
            height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 10px;
            background: !root.enabled ? {{ "bgColor-disabled" | tok }} : root.checked ? {{ "bgColor-accent-emphasis" | tok }} : {{ "controlTrack-bgColor-rest" | tok }};
            border-width: {{ "borderWidth-thin" | tok }};
            border-color: !root.enabled ? {{ "bgColor-disabled" | tok }} : root.checked ? self.background : {{ "control-borderColor-rest" | tok }};
            animate background { duration: {{ "duration-base" | tok }}; }
            Rectangle {
                x: 3px + (parent.width - self.width - 6px) * travel.value;
                width: 14px * (1 + (root.stretch-by - 1) * stretch.value);
                height: 14px;
                border-radius: 7px;
                background: root.checked ? {{ "fgColor-onEmphasis" | tok }} : {{ "controlKnob-bgColor-rest" | tok }};
                border-width: root.checked ? 0px : 1px;
                border-color: {{ "control-borderColor-rest" | tok }};
            }
            if root.has-focus: Rectangle {
                x: -4px; y: -4px; width: parent.width + 8px; height: parent.height + 8px;
                border-radius: 14px;
                border-width: {{ "borderWidth-thick" | tok }};
                border-color: {{ "focus-outlineColor" | tok }};
            }
        }
    }
}
