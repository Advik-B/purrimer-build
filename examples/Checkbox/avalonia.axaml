<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:pm="using:Purrimer.Avalonia">
  <StackPanel Spacing="12">
    <CheckBox Content="Email me about replies" IsChecked="True" />
    <CheckBox Content="Weekly digest" />
    <CheckBox Content="Beta features (coming soon)" IsEnabled="False" />
  </StackPanel>
</UserControl>
