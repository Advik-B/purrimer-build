<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:pm="using:Purrimer.Avalonia">
  <StackPanel Spacing="12">
    <RadioButton GroupName="plan" Content="Free" />
    <RadioButton GroupName="plan" Content="Pro" IsChecked="True" />
    <RadioButton GroupName="plan" Content="Team (invite only)" IsEnabled="False" />
  </StackPanel>
</UserControl>
