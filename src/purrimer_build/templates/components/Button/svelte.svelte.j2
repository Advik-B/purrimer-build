<script lang="ts">
  import type { Snippet } from "svelte";
  import type { HTMLButtonAttributes } from "svelte/elements";
  import Icon from "./Icon.svelte";

  type Props = HTMLButtonAttributes & {
    label?: string;
    variant?: {{ c.spec.props.variant["values"] | map("tojson") | join(" | ") }};
    size?: {{ c.spec.props.size["values"] | map("tojson") | join(" | ") }};
    leadingIcon?: string;
    trailingIcon?: string;
    block?: boolean;
    children?: Snippet;
  };

  let { label = "", variant = "default", size = "medium", leadingIcon = "", trailingIcon = "", block = false, type = "button", class: className = "", children, ...rest }: Props = $props();
