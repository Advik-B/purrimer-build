"""{{ note }}
Springs and gesture helpers for the touch layer. Direct manipulation follows the pointer with no easing; releases
hand the pointer's velocity to a spring that settles on the current motion kind. Touch input reaches widgets as
synthesized mouse events, so every gesture works the same with a finger or a mouse.
"""

from __future__ import annotations

import math

from PySide6.QtCore import QElapsedTimer, QObject, QPointF, QRectF, Qt, QTimer, Signal
from PySide6.QtGui import QColor, QImage, QPainter, QPainterPath, QPen, QPixmap, QTransform
from PySide6.QtWidgets import (QGraphicsBlurEffect, QGraphicsEffect, QGraphicsPixmapItem, QGraphicsScene,
                               QWidget)

from .theme import theme

# Stiffness and damping per motion kind. Sleepy is critically damped; playful overshoots by about a tenth.
SPRINGS = {"sleepy": (180.0, 26.8), "playful": (380.0, 23.4)}
PRESS_SCALE = 0.96
LONG_PRESS_MS = 450
SLOP = 8.0


class Spring(QObject):
    """A one-dimensional spring. `changed` fires with every value, including the final one."""

    changed = Signal(float)
    settled = Signal()

    def __init__(self, value: float = 0.0, precision: float = 0.01, kind: str | None = None,
                 parent: QObject | None = None) -> None:
        super().__init__(parent)
        self.value = value
        self.target = value
        self.velocity = 0.0
        self.kind = kind
        self._precision = precision
        self._clock = QElapsedTimer()
        self._timer = QTimer(self)
        self._timer.setTimerType(Qt.TimerType.PreciseTimer)
        self._timer.setInterval(8)
        self._timer.timeout.connect(self._step)

    @property
    def moving(self) -> bool:
        return self._timer.isActive()

    def set(self, value: float) -> None:
        self._timer.stop()
        self.value = value
        self.target = value
        self.velocity = 0.0
        self.changed.emit(value)

    def to(self, target: float, velocity: float | None = None) -> None:
        self.target = target
        if velocity is not None:
            self.velocity = velocity
        if theme.pause_loops:
            self.set(target)
            self.settled.emit()
            return
        if not self._timer.isActive():
            self._clock.start()
            self._timer.start()

    def stop(self) -> None:
        self._timer.stop()

    def _step(self) -> None:
        dt = min(self._clock.restart() / 1000.0, 0.064)
        stiffness, damping = SPRINGS.get(self.kind or motion_kind_of(self.parent()), SPRINGS["sleepy"])
        while dt > 0:
            h = min(dt, 1 / 240)
            accel = -stiffness * (self.value - self.target) - damping * self.velocity
            self.velocity += accel * h
            self.value += self.velocity * h
            dt -= h
        if abs(self.value - self.target) < self._precision and abs(self.velocity) < self._precision * 10:
            self._timer.stop()
            self.value = self.target
            self.velocity = 0.0
            self.changed.emit(self.value)
            self.settled.emit()
            return
        self.changed.emit(self.value)


def rubber_band(overshoot: float, dimension: float, constant: float = 0.55) -> float:
    """Resistance past an edge: the further the drag, the less the content moves."""
    if dimension <= 0:
        return 0.0
    distance = abs(overshoot)
    return math.copysign((1 - 1 / (distance * constant / dimension + 1)) * dimension, overshoot)


def project(velocity: float, deceleration: float = 0.998) -> float:
    """Where a flick would come to rest, given its velocity in px/s."""
    return velocity / 1000.0 * deceleration / (1 - deceleration)


class VelocityTracker:
    """Pointer velocity over the last 100ms, in px/s."""

    def __init__(self) -> None:
        self._clock = QElapsedTimer()
        self._clock.start()
        self._samples: list[tuple[int, float, float]] = []

    def add(self, point: QPointF) -> None:
        t = self._clock.elapsed()
        self._samples.append((t, point.x(), point.y()))
        while len(self._samples) > 2 and t - self._samples[0][0] > 100:
            self._samples.pop(0)

    def reset(self) -> None:
        self._samples.clear()

    def velocity(self) -> QPointF:
        if len(self._samples) < 2:
            return QPointF()
        (t0, x0, y0), (t1, x1, y1) = self._samples[0], self._samples[-1]
        dt = (t1 - t0) / 1000.0
        return QPointF((x1 - x0) / dt, (y1 - y0) / dt) if dt > 0 else QPointF()


class PressFeedback(QObject):
    """Compresses a widget while it is held and springs it back on release. Read `scale` in paintEvent."""

    def __init__(self, widget: QWidget) -> None:
        super().__init__(widget)
        self._widget = widget
        self._spring = Spring(1.0, precision=0.0005, parent=self)
        self._spring.changed.connect(lambda _v: widget.update())

    @property
    def scale(self) -> float:
        return self._spring.value

    def press(self) -> None:
        self._spring.to(PRESS_SCALE)

    def release(self) -> None:
        self._spring.to(1.0)


class LongPress(QObject):
    """Fires `triggered` when a press is held still for LONG_PRESS_MS."""

    triggered = Signal(QPointF)

    def __init__(self, parent: QObject | None = None) -> None:
        super().__init__(parent)
        self._origin = QPointF()
        self._timer = QTimer(self)
        self._timer.setSingleShot(True)
        self._timer.setInterval(LONG_PRESS_MS)
        self._timer.timeout.connect(lambda: self.triggered.emit(self._origin))

    @property
    def pending(self) -> bool:
        return self._timer.isActive()

    def press(self, point: QPointF) -> None:
        self._origin = QPointF(point)
        self._timer.start()

    def move(self, point: QPointF) -> None:
        if self._timer.isActive() and (point - self._origin).manhattanLength() > SLOP:
            self._timer.stop()

    def cancel(self) -> None:
        self._timer.stop()


def in_touch_scope(widget: QWidget) -> bool:
    """True when an ancestor sets the pmTouchScope property, as MobileScreen does. Components inside switch to their
    touch design."""
    parent = widget.parentWidget()
    while parent is not None:
        if parent.property("pmTouchScope"):
            return True
        parent = parent.parentWidget()
    return False


# The motion catalog: the same keyframes as the web's pm-m-* classes, per kind ("reduced" is sleepy under reduced
# motion: fades only). Each track is [[offset, value, easing or None], ...]; None means the animation's own curve.

CATALOG = {
{% for kind in ["sleepy", "playful", "reduced"] %}
    "{{ kind }}": {{ motion.table(tokens, kind) | py | indent(4) }},
{% endfor %}
}

EASINGS = {{ motion.easings(tokens) | py }}

STAGGER = {{ {"sleepy": motion.stagger_ms(tokens, "sleepy"), "playful": motion.stagger_ms(tokens, "playful"), "reduced": 0} | py }}

REST = {{ motion.rest | py }}
CLAMPED = ("opacity", "ringO", "wash", "draw")
NAMES = tuple(CATALOG["sleepy"])


def motion_kind_of(obj: QObject | None) -> str:
    """The motion kind for an object: the closest pmMotion property on it or an ancestor (a MotionScope sets it),
    else the theme's default."""
    while obj is not None:
        kind = obj.property("pmMotion")
        if kind in ("sleepy", "playful"):
            return kind
        obj = obj.parent()
    return theme.motion_kind


def motion_reduced(obj: QObject | None) -> bool:
    """Reduced motion: the theme's in-app setting, or pmMotionReduce on the object or an ancestor."""
    if theme.reduce_motion:
        return True
    while obj is not None:
        if obj.property("pmMotionReduce"):
            return True
        obj = obj.parent()
    return False


def effective_kind(obj: QObject | None, explicit: str | None = None) -> str:
    """"sleepy", "playful" or "still": under reduced motion playful plays as sleepy and sleepy only fades."""
    kind = explicit if explicit in ("sleepy", "playful") else motion_kind_of(obj)
    if not motion_reduced(obj):
        return kind
    return "sleepy" if kind == "playful" else "still"


def table_for(kind: str) -> dict:
    return CATALOG["reduced" if kind == "still" else kind]


def cubic_bezier(x1: float, y1: float, x2: float, y2: float, x: float) -> float:
    if x <= 0:
        return 0.0
    if x >= 1:
        return 1.0

    def bx(t: float) -> float:
        return ((1 - 3 * x2 + 3 * x1) * t + (3 * x2 - 6 * x1)) * t * t + 3 * x1 * t

    def by(t: float) -> float:
        return ((1 - 3 * y2 + 3 * y1) * t + (3 * y2 - 6 * y1)) * t * t + 3 * y1 * t

    t = x
    for _ in range(8):
        err = bx(t) - x
        if abs(err) < 1e-6:
            return by(t)
        d = (3 * (1 - 3 * x2 + 3 * x1) * t + 2 * (3 * x2 - 6 * x1)) * t + 3 * x1
        if abs(d) < 1e-6:
            break
        t -= err / d
    lo, hi, t = 0.0, 1.0, x
    for _ in range(30):
        if bx(t) < x:
            lo = t
        else:
            hi = t
        t = (lo + hi) / 2
    return by(t)


def ease(spec: list, p: float) -> float:
    """An easing token's curve at p: ["cubic", x1, y1, x2, y2], ["points", [[x, y], ...]] or ["linear"]."""
    if spec[0] == "linear":
        return p
    if spec[0] == "points":
        pts = spec[1]
        if p <= pts[0][0]:
            return pts[0][1]
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):
            if p <= x1:
                return y1 if x1 == x0 else y0 + (y1 - y0) * (p - x0) / (x1 - x0)
        return pts[-1][1]
    return cubic_bezier(spec[1], spec[2], spec[3], spec[4], p)


def _track_at(track: list, p: float, default: list) -> float:
    if p <= track[0][0]:
        return track[0][1]
    for (t0, v0, e0), (t1, v1, _e1) in zip(track, track[1:]):
        if p <= t1:
            if t1 == t0:
                return v1
            return v0 + (v1 - v0) * ease(EASINGS[e0] if e0 else default, (p - t0) / (t1 - t0))
    return track[-1][1]


def sample(name: str, kind: str, progress: float, easing: str | None = None) -> dict:
    """Every channel of `name` at `progress` (0 to 1) of one iteration, in an effective kind."""
    entry = table_for(kind)[name]
    p = 1 - progress if entry["reverse"] else progress
    default = EASINGS[easing or entry["ease"]]
    out = dict(REST)
    for ch, track in entry["tracks"].items():
        v = _track_at(track, p, default)
        if ch in CLAMPED:
            v = min(1.0, max(0.0, v))
        elif ch == "blur":
            v = max(0.0, v)
        out[ch] = v
    if "orbit" in entry["tracks"]:
        a = math.radians(out["orbit"])
        out["tx"] += entry["orbit"] * math.cos(a)
        out["ty"] += entry["orbit"] * math.sin(a)
    return out


def motion_transform(frame: dict, width: float, height: float, origin: tuple[float, float],
                     perspective: float = 0.0) -> QTransform:
    """The CSS transform of a frame: translate, rotate, rotateX (in perspective), rotateY, scale and skewX about the
    origin (fractions of the size)."""
    ox, oy = origin[0] * width, origin[1] * height
    t = QTransform()
    t.translate(ox + frame["tx"] + frame["txp"] * width, oy + frame["ty"] + frame["typ"] * height)
    t.rotate(frame["rot"])
    if frame["rotX"]:
        a = math.radians(frame["rotX"])
        # rotateX in perspective(d): y scales by cos, and w grows with the depth the row tips toward the viewer.
        d = perspective or 1e9
        t = QTransform(1, 0, 0, 0, math.cos(a), -math.sin(a) / d, 0, 0, 1) * t
    sx = frame["sx"] * math.cos(math.radians(frame["rotY"]))
    t.scale(sx, frame["sy"])
    if frame["skew"]:
        t.shear(math.tan(math.radians(frame["skew"])), 0)
    t.translate(-ox, -oy)
    return t


class MotionPlayer(QObject):
    """Plays one catalog animation over time. `frame` fires with every channel's value; `done` fires when a finite
    animation ends. While the theme pauses loops (screenshot runs), every frame is the rest pose and finite
    animations end at once, as the web does with animations off."""

    frame = Signal(dict)
    done = Signal()

    def __init__(self, parent: QObject | None = None) -> None:
        super().__init__(parent)
        self._timer = QTimer(self)
        self._timer.setTimerType(Qt.TimerType.PreciseTimer)
        self._timer.setInterval(16)
        self._timer.timeout.connect(self._tick)
        self._clock = QElapsedTimer()
        self.name = ""
        self.kind = "sleepy"
        self.current = dict(REST)
        self._duration = 0.0
        self._delay = 0.0
        self._count = 1
        self._easing: str | None = None
        self._fill = "both"
        self._alternate = False

    @property
    def running(self) -> bool:
        return self._timer.isActive()

    def entry(self) -> dict:
        return table_for(self.kind)[self.name]

    def play(self, name: str, kind: str = "sleepy", duration: float | None = None, delay: float = 0.0,
             easing: str | None = None, index: int = 0, loop: bool = False, count: int | None = None,
             alternate: bool = False, paused: bool = False) -> None:
        """Starts `name` in an effective kind ("sleepy", "playful" or "still"). `duration` and `delay` are ms;
        `easing` is an easing token; `index` staggers by the kind's stagger token."""
        if name not in NAMES:
            raise KeyError(f"Unknown motion: {name}")
        self.stop()
        self.name, self.kind = name, kind
        entry = self.entry()
        self._duration = float(duration if duration is not None else entry["dur"])
        self._delay = float(delay) + index * STAGGER["reduced" if kind == "still" else kind]
        self._count = -1 if loop else (count if count is not None else entry["count"])
        self._easing = easing
        self._fill = entry["fill"]
        self._alternate = alternate
        if theme.pause_loops:
            self._emit(dict(REST))
            if self._count >= 0:
                self.done.emit()
            return
        # Decorative loops stop under reduced motion, resting on their first frame.
        if kind == "still" and (entry["decorative"] or self._count < 0):
            self._emit(sample(name, kind, 0.0, easing))
            return
        self._emit(sample(name, kind, 0.0, easing) if self._fill == "both" else dict(REST))
        if paused:
            return
        self._clock.start()
        self._timer.start()

    def stop(self) -> None:
        self._timer.stop()

    def reset(self) -> None:
        """Stops and returns to the rest pose."""
        self.stop()
        self._emit(dict(REST))

    def _emit(self, values: dict) -> None:
        self.current = values
        self.frame.emit(values)

    def _tick(self) -> None:
        t = self._clock.elapsed() - self._delay
        if t < 0:
            return
        dur = max(self._duration, 1.0)
        iteration = int(t // dur)
        if self._count >= 0 and iteration >= self._count:
            self._timer.stop()
            last = (self._count - 1) % 2 == 1 if self._alternate else False
            end = 0.0 if last else 1.0
            self._emit(sample(self.name, self.kind, end, self._easing) if self._fill == "both" else dict(REST))
            self.done.emit()
            return
        p = (t - iteration * dur) / dur
        if self._alternate and iteration % 2 == 1:
            p = 1 - p
        self._emit(sample(self.name, self.kind, p, self._easing))


def _blurred(pixmap: QPixmap, radius: float) -> QPixmap:
    """A Gaussian-like blur of a pixmap, standard deviation `radius` px (as CSS blur()), padded so it can spread."""
    pad = int(math.ceil(radius * 3))
    scene = QGraphicsScene()
    item = QGraphicsPixmapItem(pixmap)
    effect = QGraphicsBlurEffect()
    effect.setBlurRadius(radius * 2.5)
    effect.setBlurHints(QGraphicsBlurEffect.BlurHint.QualityHint)
    item.setGraphicsEffect(effect)
    scene.addItem(item)
    dpr = pixmap.devicePixelRatio()
    w, h = pixmap.width() / dpr, pixmap.height() / dpr
    image = QImage(int((w + 2 * pad) * dpr), int((h + 2 * pad) * dpr), QImage.Format.Format_ARGB32_Premultiplied)
    image.setDevicePixelRatio(dpr)
    image.fill(Qt.GlobalColor.transparent)
    painter = QPainter(image)
    scene.render(painter, QRectF(0, 0, w + 2 * pad, h + 2 * pad), QRectF(-pad, -pad, w + 2 * pad, h + 2 * pad))
    painter.end()
    out = QPixmap.fromImage(image)
    out.setDevicePixelRatio(dpr)
    return out


class MotionEffect(QGraphicsEffect):
    """Draws a widget as a motion frame: its transform, opacity, clip, blur (only while it is above zero), and the
    halo, ring and wash that bask, meow and warm-spot draw around it. Put it on a wrapper (Motion does), so the
    content keeps its own effects, such as shadows."""

    def __init__(self, parent: QObject | None = None) -> None:
        super().__init__(parent)
        self.values = dict(REST)
        self.origin = (0.5, 0.5)
        self.perspective = 0.0
        self.radius = 0.0

    def set_frame(self, values: dict, origin: tuple[float, float] = (0.5, 0.5), perspective: float = 0.0) -> None:
        self.values = values
        self.origin = origin
        self.perspective = perspective
        self.updateBoundingRect()
        self.update()

    def at_rest(self) -> bool:
        return all(abs(self.values[k] - REST[k]) < 1e-4 for k in REST)

    def boundingRectFor(self, rect: QRectF) -> QRectF:
        v = self.values
        m = 2 + abs(v["tx"]) + abs(v["ty"]) + abs(v["txp"]) * rect.width() + abs(v["typ"]) * rect.height()
        m += max(rect.width(), rect.height()) * (max(v["sx"], v["sy"], v["ringS"], 1) - 1)
        if v["rot"] or v["skew"] or v["rotX"]:
            m += max(rect.width(), rect.height()) * 0.5
        m += v["blur"] * 3 + v["halo"] + 2
        return rect.adjusted(-m, -m, m, m)

    def draw(self, painter: QPainter) -> None:
        if self.at_rest():
            self.drawSource(painter)
            return
        v = self.values
        source = self.sourceBoundingRect(Qt.CoordinateSystem.LogicalCoordinates)
        # Without padding, the pixmap covers exactly the source rect.
        pixmap = self.sourcePixmap(Qt.CoordinateSystem.LogicalCoordinates, mode=QGraphicsEffect.PixmapPadMode.NoPad)
        w, h = source.width(), source.height()
        painter.save()
        painter.setRenderHint(QPainter.RenderHint.SmoothPixmapTransform)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.translate(source.topLeft())
        transform = motion_transform(v, w, h, self.origin, self.perspective)
        painter.setTransform(transform, True)
        local = QRectF(0, 0, w, h)
        if v["halo"] > 0.01:
            pen = QPen(theme.color("bgColor-accent-muted"), v["halo"])
            painter.setPen(pen)
            painter.setBrush(Qt.BrushStyle.NoBrush)
            r = self.radius + v["halo"] / 2
            painter.drawRoundedRect(local.adjusted(-v["halo"] / 2, -v["halo"] / 2, v["halo"] / 2, v["halo"] / 2), r, r)
        if v["wash"] > 0.001:
            wash = theme.color("bgColor-attention-muted")
            wash.setAlphaF(wash.alphaF() * v["wash"])
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(wash)
            painter.drawRoundedRect(local, self.radius, self.radius)
        if v["reveal"] < 0.999:
            painter.setClipRect(QRectF(-64, -64, w + 128, v["reveal"] * (h + 64)), Qt.ClipOperation.IntersectClip)
        if v["draw"] < 0.999:
            painter.setClipRect(QRectF(-64, -64, 64 + v["draw"] * w, h + 128), Qt.ClipOperation.IntersectClip)
        painter.setOpacity(painter.opacity() * v["opacity"])
        if v["blur"] > 0.05:
            blurred = _blurred(pixmap, v["blur"])
            pad = int(math.ceil(v["blur"] * 3))
            painter.drawPixmap(-pad, -pad, blurred)
        else:
            painter.drawPixmap(0, 0, pixmap)
        painter.restore()
        if v["ringO"] > 0.001:
            painter.save()
            painter.setRenderHint(QPainter.RenderHint.Antialiasing)
            painter.translate(source.topLeft())
            painter.setTransform(transform, True)
            c = QPointF(w / 2, h / 2)
            painter.translate(c)
            painter.scale(v["ringS"], v["ringS"])
            painter.translate(-c)
            painter.setOpacity(painter.opacity() * v["ringO"])
            pen = QPen(theme.color("borderColor-accent-emphasis"), theme.length("borderWidth-thick") / v["ringS"])
            painter.setPen(pen)
            painter.setBrush(Qt.BrushStyle.NoBrush)
            painter.drawRoundedRect(local.adjusted(1, 1, -1, -1), self.radius, self.radius)
            painter.restore()


def play(widget: QWidget, name: str, kind: str | None = None, **options) -> MotionPlayer:
    """Plays a catalog animation on a widget, in the kind of its scope (or `kind`). Exits hold their end state;
    other animations return the widget to rest when they end. This replaces the widget's graphics effect, so for a
    widget with its own effect (a shadow), wrap it in Motion instead."""
    effect = widget.graphicsEffect()
    if not isinstance(effect, MotionEffect):
        effect = MotionEffect(widget)
        widget.setGraphicsEffect(effect)
    player = widget.findChild(MotionPlayer, "pmMotionPlayer")
    if player is None:
        player = MotionPlayer(widget)
        player.setObjectName("pmMotionPlayer")
        player.frame.connect(lambda v, p=player, e=effect: e.set_frame(v, _origin(p.entry()), p.entry()["perspective"]))
    else:
        try:
            player.done.disconnect()
        except (RuntimeError, TypeError):
            pass
    entry = table_for(effective_kind(widget, kind))[name]
    keep = entry["cat"] == "exit" or name.endswith("-out")
    if not keep:
        player.done.connect(player.reset)
    player.play(name, effective_kind(widget, kind), **options)
    return player


def _origin(entry: dict) -> tuple[float, float]:
    return (entry["origin"][0], entry["origin"][1])


# Burst: celebration particles, the same lists as the web's for the same seed.

{{ burst_python() }}

def burst_state(particle: dict, elapsed: float, width: float, height: float) -> dict:
    """One particle at `elapsed` ms after the burst: x and y (px from the origin), rotate, scale and opacity."""
    t = (elapsed - particle["delay"]) / particle["duration"]
    t = min(1.0, max(0.0, t))
    frames = particle["frames"]
    for i in range(len(frames) - 1):
        a, b = frames[i], frames[i + 1]
        if t <= b["at"] or i == len(frames) - 2:
            curve = particle["easings"][min(i, len(particle["easings"]) - 1)]
            local = 0.0 if b["at"] == a["at"] else (t - a["at"]) / (b["at"] - a["at"])
            e = local if curve == "linear" else cubic_bezier(*curve, local)
            out = {k: a[k] + (b[k] - a[k]) * e for k in ("x", "y", "xf", "yf", "rotate", "scale", "opacity")}
            out["x"] += out.pop("xf") * width
            out["y"] += out.pop("yf") * height
            out["opacity"] = min(1.0, max(0.0, out["opacity"]))
            return out
    return {"x": 0.0, "y": 0.0, "rotate": 0.0, "scale": 1.0, "opacity": 0.0}


def burst_length(particles: list[dict]) -> float:
    return max((p["delay"] + p["duration"] for p in particles), default=0.0)
