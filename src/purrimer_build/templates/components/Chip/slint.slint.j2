// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { Icon } from "icon.slint";

export component Chip inherits Rectangle {
    in property <string> text;
    // "neutral", "accent", "success", "attention", "severe", "danger", "done" or "info"
    in property <string> tone: "accent";
    in property <string> icon;
    in property <bool> removable;
    callback removed();
    property <brush> ink: tone == "success" ? {{ "fgColor-success" | tok }} : tone == "attention" ? {{ "fgColor-attention" | tok }} : tone == "severe" ? {{ "fgColor-severe" | tok }} : tone == "danger" ? {{ "fgColor-danger" | tok }} : tone == "done" ? {{ "fgColor-done" | tok }} : tone == "info" ? {{ "fgColor-info" | tok }} : tone == "neutral" ? {{ "fgColor-default" | tok }} : {{ "fgColor-accent" | tok }};
    height: 24px;
    width: row.preferred-width;
    border-radius: 12px;
    background: tone == "success" ? {{ "bgColor-success-muted" | tok }} : tone == "attention" ? {{ "bgColor-attention-muted" | tok }} : tone == "severe" ? {{ "bgColor-severe-muted" | tok }} : tone == "danger" ? {{ "bgColor-danger-muted" | tok }} : tone == "done" ? {{ "bgColor-done-muted" | tok }} : tone == "info" ? {{ "bgColor-info-muted" | tok }} : tone == "neutral" ? {{ "bgColor-neutral-muted" | tok }} : {{ "bgColor-accent-muted" | tok }};
    accessible-role: AccessibleRole.text;
    accessible-label: text;

    row := HorizontalLayout {
        padding-left: 10px;
        padding-right: root.removable ? 6px : 10px;
        spacing: 4px;
        if root.icon != "": Icon { path: root.icon; size: 12px; color: root.ink; y: (parent.height - self.height) / 2; }
        Text {
            text: root.text;
            color: root.ink;
            font-family: {{ "text-caption" | tok }}.font-family;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
        if root.removable: Rectangle {
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 8px;
            background: remove-touch.has-hover ? {{ "control-transparent-bgColor-hover" | tok }} : transparent;
            accessible-role: button;
            accessible-label: "Remove " + root.text;
            accessible-action-default => { root.removed(); }
            Icon { path: PurrimerIcons.x-16; size: 12px; color: root.ink; }
            remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.removed(); } }
        }
    }
}
