.pm-radio { display: inline-flex; align-items: center; gap: 8px; font: 400 14px/20px var(--font-sans); color: {{ "fgColor-default" | tok }}; cursor: pointer; }
.pm-radio__input {
  appearance: none;
  display: grid;
  place-items: center;
  width: 16px;
  height: 16px;
  margin: 0;
  border: {{ "borderWidth-thin" | tok }} solid {{ "control-borderColor-rest" | tok }};
  border-radius: {{ "borderRadius-full" | tok }};
  background: {{ "control-bgColor-rest" | tok }};
  cursor: inherit;
  transition: scale var(--pm-m-press) var(--pm-m-pop);
}
/* Playful scopes press to 95% and pop the mark; sleepy keeps the calm chrome. */
.pm-radio__input:active:not(:disabled) { scale: var(--pm-m-control-press); }
.pm-radio__input::after { content: ""; width: 6px; height: 6px; border-radius: 50%; background: {{ "fgColor-onEmphasis" | tok }}; scale: 0; transition: scale var(--pm-m-check-dur) var(--pm-m-check-ease); }
.pm-radio__input:checked { background: {{ "bgColor-accent-emphasis" | tok }}; border-color: {{ "bgColor-accent-emphasis" | tok }}; }
.pm-radio__input:checked::after { scale: 1; }
.pm-radio__input:focus-visible { outline: {{ "borderWidth-thick" | tok }} solid {{ "focus-outlineColor" | tok }}; outline-offset: 2px; }
.pm-radio__input:disabled { background: {{ "bgColor-disabled" | tok }}; border-color: {{ "bgColor-disabled" | tok }}; }
.pm-radio:has(:disabled) { color: {{ "fgColor-disabled" | tok }}; cursor: not-allowed; }
[data-density="touch"] .pm-radio { min-height: {{ "touch-target-min" | tok }}; }
