.pm-bottomnav {
  display: flex;
  height: {{ "mobile-bottomNav-height" | tok }};
  padding-bottom: env(safe-area-inset-bottom, 0px);
  box-sizing: content-box;
  border-top: {{ "borderWidth-thin" | tok }} solid {{ "borderColor-muted" | tok }};
  background: {{ "bgColor-default" | tok }};
}
.pm-bottomnav__item {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2px;
  padding: 0;
  border: 0;
  background: transparent;
  color: {{ "fgColor-muted" | tok }};
  font: 600 12px/16px var(--font-sans);
  cursor: pointer;
}
.pm-bottomnav__item svg { width: 24px; height: 24px; fill: currentColor; }
.pm-bottomnav__item::before { content: ""; position: absolute; top: 0; left: 50%; width: 24px; height: 3px; margin-left: -12px; border-radius: 0 0 3px 3px; background: {{ "bgColor-accent-emphasis" | tok }}; scale: 0 1; transition: scale {{ "duration-base" | tok }} {{ "easing-sleepy-enter" | tok }}; }
.pm-bottomnav__item[aria-current="page"] { color: {{ "fgColor-accent" | tok }}; }
.pm-bottomnav__item[aria-current="page"]::before { scale: 1 1; }
.pm-bottomnav__item:focus-visible { outline: {{ "borderWidth-thick" | tok }} solid {{ "focus-outlineColor" | tok }}; outline-offset: -4px; border-radius: {{ "borderRadius-medium" | tok }}; }
.pm-bottomnav__badge { position: absolute; top: 6px; left: calc(50% + 6px); min-width: 16px; height: 16px; padding: 0 4px; box-sizing: border-box; border-radius: {{ "borderRadius-full" | tok }}; background: {{ "bgColor-danger-emphasis" | tok }}; color: {{ "fgColor-onEmphasis" | tok }}; font: 600 11px/16px var(--font-sans); }
