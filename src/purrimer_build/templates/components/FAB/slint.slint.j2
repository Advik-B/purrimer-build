// {{ note }}
// {{ c.summary }}
import { Purrimer, PurrimerMotion } from "../purrimer.slint";
import { PurrimerIcons } from "../icons.slint";
import { Icon } from "icon.slint";

export component FAB inherits Rectangle {
    // 24px path commands, such as PurrimerIcons.plus-24
    in property <string> icon: PurrimerIcons.plus-24;
    in property <string> label;
    in property <bool> extended;
    callback clicked();

    height: {{ "mobile-fab-size" | tok }};
    width: root.extended ? max(self.height, row.preferred-width) : self.height;
    border-radius: {{ "borderRadius-large" | tok }};
    background: touch.pressed ? {{ "button-primary-bgColor-active" | tok }} : touch.has-hover ? {{ "button-primary-bgColor-hover" | tok }} : {{ "button-primary-bgColor-rest" | tok }};
    drop-shadow-offset-y: {{ "shadow-floating-small" | tok }}.offset-y;
    drop-shadow-blur: {{ "shadow-floating-small" | tok }}.blur;
    drop-shadow-color: {{ "shadow-floating-small" | tok }}.color;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }

    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: root.extended ? 20px : 16px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Icon { path: root.icon; box: 24; size: 24px; color: {{ "fgColor-onEmphasis" | tok }}; }
        }
        if root.extended: Text {
            text: root.label;
            vertical-alignment: center;
            color: {{ "fgColor-onEmphasis" | tok }};
            font-family: {{ "text-mobile-body" | tok }}.font-family;
            font-size: 16px;
            font-weight: 600;
        }
    }
}
