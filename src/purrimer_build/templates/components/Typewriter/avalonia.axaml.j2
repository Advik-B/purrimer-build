<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:Typewriter}" TargetType="pm:Typewriter">
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="FontSize" Value="{{ "text-body-medium" | tokx("FontSize") }}" />
    <Setter Property="LineHeight" Value="{{ "text-body-medium" | tokx("LineHeight") }}" />
    <Setter Property="Foreground" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="CaretBrush" Value="{{ "fgColor-accent" | tok }}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </ControlTheme>
</ResourceDictionary>
