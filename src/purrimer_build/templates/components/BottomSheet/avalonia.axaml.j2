<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:BottomSheet}" TargetType="pm:BottomSheet">
    <Setter Property="Foreground" Value="{{ "fgColor-default" | tok }}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="True" />
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Template">
      <ControlTemplate TargetType="pm:BottomSheet">
        <Panel>
          <Border Name="PART_Backdrop" Background="{{ "overlay-backdrop-bgColor" | tok }}" Opacity="0">
            <Border.Transitions>
              <Transitions>
                <DoubleTransition Property="Opacity" Duration="{{ "duration-slow" | tok }}" />
              </Transitions>
            </Border.Transitions>
          </Border>
          <Border Name="PART_Sheet" VerticalAlignment="Bottom"
                  MaxWidth="{{ "mobile-sheet-maxWidth" | tok }}" Background="{{ "overlay-bgColor" | tok }}"
                  BorderBrush="{{ "borderColor-default" | tok }}" BorderThickness="1,1,1,0"
                  CornerRadius="{{ px("borderRadius-xlarge") | num }},{{ px("borderRadius-xlarge") | num }},0,0"
                  BoxShadow="{{ "shadow-floating-large" | tok }}">
            <Border.Transitions>
              <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="{{ "duration-slow" | tok }}"
                                               Easing="{{ "easing-sleepy-enter" | tok }}" />
              </Transitions>
            </Border.Transitions>
            <DockPanel>
              <StackPanel Name="PART_Handle" DockPanel.Dock="Top" Background="Transparent" Cursor="Hand">
                <Border Width="36" Height="5" Margin="0,8,0,8" CornerRadius="2.5" Background="{{ "borderColor-emphasis" | tok }}"
                        IsVisible="{TemplateBinding ShowGrabber}" />
                <StackPanel Margin="{{ px("mobile-gutter") | num }},4,{{ px("mobile-gutter") | num }},12" Spacing="4"
                            IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <DockPanel>
                    <Border Name="PART_Tile" DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0"
                            CornerRadius="{{ px("borderRadius-medium") | num }}" Background="{{ "bgColor-accent-muted" | tok }}"
                            IsVisible="{TemplateBinding IconName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                      <pm:Icon Name="PART_TileIcon" IconName="{TemplateBinding TileIcon}" Foreground="{{ "fgColor-accent" | tok }}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{TemplateBinding Title}" TextWrapping="Wrap" VerticalAlignment="Center"
                               FontFamily="{{ "heading" | font }}" FontSize="{{ "text-mobile-title" | tokx("FontSize") }}" FontWeight="{{ "text-mobile-title" | tokx("FontWeight") }}" />
                  </DockPanel>
                  <TextBlock Text="{TemplateBinding Description}" TextWrapping="Wrap" FontSize="14" LineHeight="20"
                             Foreground="{{ "fgColor-muted" | tok }}"
                             IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
              </StackPanel>
              <Border DockPanel.Dock="Bottom" BorderBrush="{{ "borderColor-muted" | tok }}" BorderThickness="0,1,0,0"
                      Padding="{{ px("mobile-gutter") | num }},12,{{ px("mobile-gutter") | num }},16"
                      IsVisible="{TemplateBinding Actions, Converter={x:Static ObjectConverters.IsNotNull}}">
                <ContentPresenter Content="{TemplateBinding Actions}" HorizontalContentAlignment="Stretch" />
              </Border>
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Margin="{{ px("mobile-gutter") | num }},0,{{ px("mobile-gutter") | num }},16" />
              </ScrollViewer>
            </DockPanel>
          </Border>
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:open">
      <Setter Property="IsHitTestVisible" Value="True" />
    </Style>
    <Style Selector="^:open /template/ Border#PART_Backdrop">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="^:dragging /template/ StackPanel#PART_Handle">
      <Setter Property="Cursor" Value="SizeNorthSouth" />
    </Style>
    <Style Selector="^:info /template/ Border#PART_Tile">
      <Setter Property="Background" Value="{{ "bgColor-info-muted" | tok }}" />
    </Style>
    <Style Selector="^:info /template/ pm|Icon#PART_TileIcon">
      <Setter Property="Foreground" Value="{{ "fgColor-info" | tok }}" />
    </Style>
    <Style Selector="^:success /template/ Border#PART_Tile">
      <Setter Property="Background" Value="{{ "bgColor-success-muted" | tok }}" />
    </Style>
    <Style Selector="^:success /template/ pm|Icon#PART_TileIcon">
      <Setter Property="Foreground" Value="{{ "fgColor-success" | tok }}" />
    </Style>
    <Style Selector="^:attention /template/ Border#PART_Tile">
      <Setter Property="Background" Value="{{ "bgColor-attention-muted" | tok }}" />
    </Style>
    <Style Selector="^:attention /template/ pm|Icon#PART_TileIcon">
      <Setter Property="Foreground" Value="{{ "fgColor-attention" | tok }}" />
    </Style>
    <Style Selector="^:danger /template/ Border#PART_Tile">
      <Setter Property="Background" Value="{{ "bgColor-danger-muted" | tok }}" />
    </Style>
    <Style Selector="^:danger /template/ pm|Icon#PART_TileIcon">
      <Setter Property="Foreground" Value="{{ "fgColor-danger" | tok }}" />
    </Style>
    <Style Selector="^:neutral /template/ Border#PART_Tile">
      <Setter Property="Background" Value="{{ "bgColor-neutral-muted" | tok }}" />
    </Style>
    <Style Selector="^:neutral /template/ pm|Icon#PART_TileIcon">
      <Setter Property="Foreground" Value="{{ "fgColor-muted" | tok }}" />
    </Style>
    <Style Selector="^:inline">
      <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="^:inline /template/ Border#PART_Backdrop">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="^:inline /template/ Border#PART_Sheet">
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{{ px("borderRadius-xlarge") | num }}" />
      <Setter Property="BoxShadow" Value="{{ "shadow-floating-small" | tok }}" />
      <Setter Property="Transitions" Value="{x:Null}" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
