from __future__ import annotations

from PySide6.QtCore import QRectF, Qt, Signal
from PySide6.QtGui import QPainter, QPen
from PySide6.QtWidgets import QHBoxLayout, QLabel, QVBoxLayout, QWidget

from ..theme import theme
from .icon import Icon
from .icon_button import IconButton


def _surface(widget: QWidget, painter: QPainter, bg: str, border: str, radius: float) -> None:
    painter.setRenderHint(QPainter.RenderHint.Antialiasing)
    painter.setPen(QPen(theme.color(border), 1))
    painter.setBrush(theme.color(bg))
    painter.drawRoundedRect(QRectF(widget.rect()).adjusted(0.5, 0.5, -0.5, -0.5), radius, radius)

TONES = {
    "info": "info",
    "success": "check-circle",
    "attention": "alert",
    "danger": "stop",
    "done": "check-circle-fill",
}
COLORS = {
{% for t in ["info", "success", "attention", "danger", "done"] %}
    "{{ t }}": ({{ ("bgColor-" ~ t ~ "-muted") | tok }}, {{ ("borderColor-" ~ t ~ "-emphasis") | tok }}, {{ ("fgColor-" ~ t) | tok }}),
{% endfor %}
}


class Banner(QWidget):
    """An inline message in info, success, attention, danger or done tone."""

    dismissed = Signal()

    def __init__(self, tone: str = "info", title: str = "", text: str = "", dismissible: bool = False,
                 parent: QWidget | None = None) -> None:
        super().__init__(parent)
        if tone not in TONES:
            raise ValueError(f"tone must be one of {tuple(TONES)}")
        self._tone = tone
        bg, border, fg = COLORS[tone]
        layout = QHBoxLayout(self)
        layout.setContentsMargins(16, 12, 8 if dismissible else 16, 12)
        layout.setSpacing(12)
        self.icon = Icon(TONES[tone], 16, fg)
        layout.addWidget(self.icon, 0, Qt.AlignmentFlag.AlignTop)
        texts = QVBoxLayout()
        texts.setSpacing(0)
        body_font = theme.font({{ "text-body-medium" | tok }})
        self.title = QLabel(title)
        title_font = theme.font({{ "text-body-medium" | tok }})
        title_font.setBold(True)
        self.title.setFont(title_font)
        self.title.setWordWrap(True)
        self.title.setVisible(bool(title))
        self.text = QLabel(text)
        self.text.setFont(body_font)
        self.text.setWordWrap(True)
        self.text.setVisible(bool(text))
        texts.addWidget(self.title)
        texts.addWidget(self.text)
        layout.addLayout(texts, 1)
        if dismissible:
            close = IconButton("x", "Dismiss", variant="invisible", size="small")
            close.clicked.connect(self.dismissed)
            layout.addWidget(close, 0, Qt.AlignmentFlag.AlignTop)
        theme.changed.connect(self.update)

    def paintEvent(self, event) -> None:
        bg, border, _ = COLORS[self._tone]
        _surface(self, QPainter(self), bg, border, {{ px("borderRadius-large") | num }})
