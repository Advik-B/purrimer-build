<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:TextReveal}" TargetType="pm:TextReveal">
    <Setter Property="FontFamily" Value="{{ "heading" | font }}" />
    <Setter Property="FontSize" Value="{{ "text-title-large" | tokx("FontSize") }}" />
    <Setter Property="FontWeight" Value="{{ "text-title-large" | tokx("FontWeight") }}" />
    <Setter Property="Foreground" Value="{{ "fgColor-default" | tok }}" />
  </ControlTheme>
</ResourceDictionary>
