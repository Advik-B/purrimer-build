import { Show } from "solid-js";
import type { JSX } from "@solidjs/web";

export type CardProps = { title?: string; interactive?: boolean; onClick?: () => void; children?: JSX.Element };

export function Card(props: CardProps): JSX.Element {
  const body = () => (
    <>
      <Show when={props.title}><h3 class="pm-card__title">{props.title}</h3></Show>
      {props.children}
    </>
  );
  return (
    <Show when={props.interactive} fallback={<section class="pm-card">{body()}</section>}>
      <button type="button" class="pm-card pm-card--interactive" onClick={() => props.onClick?.()}>{body()}</button>
    </Show>
  );
}
