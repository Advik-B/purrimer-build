<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:pm="using:Purrimer.Avalonia">
  <!-- Set Source for a picture. -->
  <StackPanel Orientation="Horizontal" Spacing="12">
    <pm:Avatar DisplayName="Ada Lovelace" Size="24" VerticalAlignment="Center" />
    <pm:Avatar DisplayName="Grace Hopper" VerticalAlignment="Center" />
    <pm:Avatar DisplayName="Alan Turing" Size="40" VerticalAlignment="Center" />
    <pm:Avatar DisplayName="Purrimer" Size="48" IsSquare="True" />
  </StackPanel>
</UserControl>
