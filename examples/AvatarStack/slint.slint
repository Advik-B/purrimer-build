import { AvatarStack } from "purrimer-components.slint";

export component Example inherits HorizontalLayout {
    spacing: 32px;
    alignment: start;
    AvatarStack {
        people: ["Mona Lisa", "Hubot", "Ada Lovelace", "Octo Cat", "Grace Hopper", "Linus Torvalds"];
        initials: ["ML", "H", "AL", "OC", "GH", "LT"];
        y: (parent.height - self.height) / 2;
    }
    AvatarStack {
        people: ["Mona Lisa", "Hubot", "Ada Lovelace"];
        initials: ["ML", "H", "AL"];
        size: 32px;
    }
}
