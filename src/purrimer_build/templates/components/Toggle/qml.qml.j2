// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Templates as T
import "PmMotion.js" as PmMotion

T.Switch {
    id: control
    implicitWidth: implicitContentWidth + leftPadding + rightPadding
    implicitHeight: Math.max(implicitContentHeight, implicitIndicatorHeight) + topPadding + bottomPadding
    spacing: 12
    padding: 2
    // The kind's control timings: the handle travels on a standard curve when sleepy and a spring when playful, and in
    // a playful scope it stretches to 120% while held, keeping the edge it rests on.
    readonly property var motionControls: PmMotion.controls(Purrimer.effectiveKind(control, ""))

    indicator: Rectangle {
        implicitWidth: 36
        implicitHeight: 20
        x: control.text ? control.width - width - control.rightPadding : control.leftPadding
        y: (control.height - height) / 2
        radius: height / 2
        color: !control.enabled ? {{ "bgColor-disabled" | tok }} : control.checked ? {{ "bgColor-accent-emphasis" | tok }} : {{ "controlTrack-bgColor-rest" | tok }}
        border.width: {{ "borderWidth-thin" | tok }}
        border.color: !control.enabled ? {{ "bgColor-disabled" | tok }} : control.checked ? color : {{ "control-borderColor-rest" | tok }}
        Behavior on color { ColorAnimation { duration: {{ "duration-base" | tok }} } }

        Rectangle {
            width: control.pressed && control.enabled ? 14 * control.motionControls.stretch : 14
            height: 14
            radius: 7
            y: 3
            // Travel and width ease on their own; x follows both, so the stretched handle keeps the edge it rests on.
            property real travel: control.checked ? 1 : 0
            x: 3 + (parent.width - width - 6) * travel
            color: control.checked ? {{ "fgColor-onEmphasis" | tok }} : {{ "controlKnob-bgColor-rest" | tok }}
            border.width: control.checked ? 0 : 1
            border.color: {{ "control-borderColor-rest" | tok }}
            Behavior on travel {
                NumberAnimation {
                    duration: control.motionControls.toggleDur
                    easing.type: Easing.BezierSpline
                    easing.bezierCurve: PmMotion.curve(control.motionControls.toggleEase)
                }
            }
            Behavior on width {
                NumberAnimation {
                    duration: control.motionControls.toggleDur
                    easing.type: Easing.BezierSpline
                    easing.bezierCurve: PmMotion.curve(control.motionControls.toggleEase)
                }
            }
        }

        Rectangle {
            anchors.fill: parent
            anchors.margins: -4
            radius: height / 2
            color: "transparent"
            border.width: {{ "borderWidth-thick" | tok }}
            border.color: {{ "focus-outlineColor" | tok }}
            visible: control.visualFocus
        }
    }

    contentItem: Text {
        rightPadding: control.text ? control.indicator.width + control.spacing : 0
        text: control.text
        font: {{ "text-body-medium" | tok }}
        color: control.enabled ? {{ "fgColor-default" | tok }} : {{ "fgColor-disabled" | tok }}
        verticalAlignment: Text.AlignVCenter
    }
}
