// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Shapes

Item {
    id: root
    property string name
    property int size: 16
    property color color: {{ "fgColor-default" | tok }}
    readonly property int box: Octicons.box(name, size)

    implicitWidth: size
    implicitHeight: size

    Shape {
        width: root.box
        height: root.box
        scale: root.size / root.box
        transformOrigin: Item.TopLeft
        preferredRendererType: Shape.CurveRenderer
        ShapePath {
            fillColor: root.color
            strokeColor: "transparent"
            strokeWidth: 0
            PathSvg { path: Octicons.path(root.name, root.size) }
        }
    }
}
