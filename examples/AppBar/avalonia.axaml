<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:pm="using:Purrimer.Avalonia">
  <pm:AppBar Title="Inbox" ShowBack="True" IsLarge="True" VerticalAlignment="Top">
    <StackPanel Orientation="Horizontal">
      <pm:IconButton IconName="search" Label="Search" Classes="invisible large" IconSize="24" />
      <pm:IconButton IconName="kebab-horizontal" Label="More" Classes="invisible large" IconSize="24" />
    </StackPanel>
  </pm:AppBar>
</UserControl>
