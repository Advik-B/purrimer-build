<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:pm="using:Purrimer.Avalonia">
  <pm:ActionMenu Label="File" IsOpen="True" VerticalAlignment="Top">
    <pm:ActionListItem Label="Edit file" LeadingIcon="pencil" TrailingText="E" />
    <pm:ActionListItem Label="Copy permalink" LeadingIcon="link" TrailingText="Y" />
    <pm:ActionListItem Label="View history" LeadingIcon="history" />
    <pm:ActionListDivider />
    <pm:ActionListItem Label="Delete file" LeadingIcon="trash" Variant="danger" />
  </pm:ActionMenu>
</UserControl>
