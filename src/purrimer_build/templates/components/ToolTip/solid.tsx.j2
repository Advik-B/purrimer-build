// {{ note }}
// {{ c.summary }}
import { Show, createEffect, createSignal, createUniqueId } from "solid-js";
import type { JSX } from "@solidjs/web";

export type ToolTipProps = {
  text: string;
  placement?: {{ c.spec.props.placement["values"] | map("tojson") | join(" | ") }};
  delay?: number;
  whatsThis?: boolean;
  disabled?: boolean;
  open?: boolean;
  children: JSX.Element;
};

export function ToolTip(props: ToolTipProps): JSX.Element {
  const tipId = `pm-tooltip-${createUniqueId()}`;
  const [open, setOpen] = createSignal(() => props.open ?? false);
  let root!: HTMLSpanElement;
  let timer: ReturnType<typeof setTimeout> | undefined;

  const show = (now: boolean) => {
    if (props.disabled) return;
    clearTimeout(timer);
    if (now) setOpen(true);
    else timer = setTimeout(() => setOpen(true), props.delay ?? {{ c.spec.props.delay.default }});
  };
  const hide = () => {
    clearTimeout(timer);
    setOpen(false);
  };

  // The trigger is the first focusable element inside; it gets the description and, for whatsThis, the expanded state.
  createEffect(open, (isOpen) => {
    const trigger = root.querySelector<HTMLElement>("button, a, input, select, textarea, [tabindex]");
    if (!trigger) return;
    if (props.whatsThis) {
      trigger.setAttribute("aria-expanded", isOpen ? "true" : "false");
      if (isOpen) trigger.setAttribute("aria-controls", tipId);
      else trigger.removeAttribute("aria-controls");
    } else if (isOpen) trigger.setAttribute("aria-describedby", tipId);
    else trigger.removeAttribute("aria-describedby");
  });

  createEffect(open, (isOpen) => {
    if (!isOpen) return;
    const onKey = (e: KeyboardEvent) => {
      if (e.key === "Escape") hide();
    };
    const onDown = (e: PointerEvent) => {
      if (props.whatsThis && !root.contains(e.target as Node)) hide();
    };
    document.addEventListener("keydown", onKey);
    document.addEventListener("pointerdown", onDown);
    return () => {
      document.removeEventListener("keydown", onKey);
      document.removeEventListener("pointerdown", onDown);
    };
  });

  return (
    <span
      class="pm-tooltip"
      ref={root}
      onMouseEnter={() => !props.whatsThis && show(false)}
      onMouseLeave={() => !props.whatsThis && hide()}
      onFocusIn={() => !props.whatsThis && show(true)}
      onFocusOut={() => !props.whatsThis && hide()}
      onClick={() => props.whatsThis && (open() ? hide() : show(true))}
    >
      {props.children}
      <Show when={open()}>
        <span
          id={tipId}
          role={props.whatsThis ? "note" : "tooltip"}
          class={[props.whatsThis ? "pm-tooltip__note" : "pm-tooltip__bubble", `pm-tooltip--${props.placement ?? "top"}`]}
        >
          {props.text}
        </span>
      </Show>
    </span>
  );
}
