// The motion catalog: the same keyframes as the web's pm-m-* classes, per kind ("reduced" is sleepy under reduced
// motion: fades only), and the player's maths.
public static class PurrimerMotionCatalog
{
    private const string Data = """
{{ {"tables": {"sleepy": motion.table(tokens, "sleepy"), "playful": motion.table(tokens, "playful"), "reduced": motion.table(tokens, "reduced")}, "easings": motion.easings(tokens), "stagger": {"sleepy": motion.stagger_ms(tokens, "sleepy"), "playful": motion.stagger_ms(tokens, "playful"), "reduced": 0}, "controls": motion.all_controls(tokens)} | tojson }}
""";

    private static readonly Dictionary<string, Dictionary<string, PurrimerMotionEntry>> Tables = new();
    private static readonly Dictionary<string, double[]> Curves = new();
    private static readonly Dictionary<string, double> Staggers = new();

    static PurrimerMotionCatalog()
    {
        using var doc = JsonDocument.Parse(Data);
        foreach (var kind in doc.RootElement.GetProperty("tables").EnumerateObject())
        {
            var table = new Dictionary<string, PurrimerMotionEntry>();
            foreach (var e in kind.Value.EnumerateObject())
            {
                var v = e.Value;
                var tracks = new Dictionary<string, (double, double, string?)[]>();
                foreach (var t in v.GetProperty("tracks").EnumerateObject())
                {
                    var list = new List<(double, double, string?)>();
                    foreach (var k in t.Value.EnumerateArray())
                        list.Add((k[0].GetDouble(), k[1].GetDouble(), k[2].ValueKind == JsonValueKind.Null ? null : k[2].GetString()));
                    tracks[t.Name] = list.ToArray();
                }
                var origin = v.GetProperty("origin");
                table[e.Name] = new PurrimerMotionEntry
                {
                    Category = v.GetProperty("cat").GetString()!,
                    Duration = v.GetProperty("dur").GetDouble(),
                    Easing = v.GetProperty("ease").GetString()!,
                    Count = v.GetProperty("count").GetInt32(),
                    Origin = new Point(origin[0].GetDouble(), origin[1].GetDouble()),
                    MenuOrigin = v.GetProperty("menuOrigin").GetBoolean(),
                    FillBoth = v.GetProperty("fill").GetString() == "both",
                    Reverse = v.GetProperty("reverse").GetBoolean(),
                    Decorative = v.GetProperty("decorative").GetBoolean(),
                    Perspective = v.GetProperty("perspective").GetDouble(),
                    Orbit = v.GetProperty("orbit").GetDouble(),
                    Tracks = tracks,
                };
            }
            Tables[kind.Name] = table;
        }
        foreach (var c in doc.RootElement.GetProperty("easings").EnumerateObject())
        {
            var spec = c.Value;
            var type = spec[0].GetString();
            if (type == "linear")
                Curves[c.Name] = Array.Empty<double>();
            else if (type == "cubic")
                Curves[c.Name] = new[] { 0.0, spec[1].GetDouble(), spec[2].GetDouble(), spec[3].GetDouble(), spec[4].GetDouble() };
            else
            {
                var pts = new List<double> { 1.0 };
                foreach (var p in spec[1].EnumerateArray())
                {
                    pts.Add(p[0].GetDouble());
                    pts.Add(p[1].GetDouble());
                }
                Curves[c.Name] = pts.ToArray();
            }
        }
        foreach (var s in doc.RootElement.GetProperty("stagger").EnumerateObject())
            Staggers[s.Name] = s.Value.GetDouble();
        foreach (var k in doc.RootElement.GetProperty("controls").EnumerateObject())
        {
            var v = k.Value;
            ControlTable[k.Name] = new PurrimerControlTimings(
                v.GetProperty("press").GetDouble(), v.GetProperty("pressDur").GetDouble(), v.GetProperty("pressEase").GetString()!,
                v.GetProperty("checkDur").GetDouble(), v.GetProperty("checkEase").GetString()!,
                v.GetProperty("toggleDur").GetDouble(), v.GetProperty("toggleEase").GetString()!, v.GetProperty("stretch").GetDouble(),
                v.GetProperty("progressDur").GetDouble(), v.GetProperty("progressEase").GetString()!);
        }
    }

    private static readonly Dictionary<string, PurrimerControlTimings> ControlTable = new();

    // The control timings for an effective kind ("sleepy", "playful" or "still").
    public static PurrimerControlTimings Controls(string kind) =>
        ControlTable[kind == "still" ? "reduced" : kind == "playful" ? "playful" : "sleepy"];

    public static IReadOnlyCollection<string> Names => Tables["sleepy"].Keys;

    public static bool Has(string name) => Tables["sleepy"].ContainsKey(name);

    // kind is an effective kind: "sleepy", "playful" or "still" (sleepy under reduced motion).
    public static PurrimerMotionEntry Entry(string name, string kind) =>
        Tables[kind == "still" ? "reduced" : kind == "playful" ? "playful" : "sleepy"][name];

    public static double Stagger(string kind) => Staggers[kind == "still" ? "reduced" : kind == "playful" ? "playful" : "sleepy"];

    public static double CubicBezier(double x1, double y1, double x2, double y2, double x)
    {
        if (x <= 0)
            return 0;
        if (x >= 1)
            return 1;
        double Bx(double t) => ((1 - 3 * x2 + 3 * x1) * t + (3 * x2 - 6 * x1)) * t * t + 3 * x1 * t;
        double By(double t) => ((1 - 3 * y2 + 3 * y1) * t + (3 * y2 - 6 * y1)) * t * t + 3 * y1 * t;
        var t = x;
        for (var i = 0; i < 8; i++)
        {
            var err = Bx(t) - x;
            if (Math.Abs(err) < 1e-6)
                return By(t);
            var d = (3 * (1 - 3 * x2 + 3 * x1) * t + 2 * (3 * x2 - 6 * x1)) * t + 3 * x1;
            if (Math.Abs(d) < 1e-6)
                break;
            t -= err / d;
        }
        double lo = 0, hi = 1;
        t = x;
        for (var i = 0; i < 30; i++)
        {
            if (Bx(t) < x)
                lo = t;
            else
                hi = t;
            t = (lo + hi) / 2;
        }
        return By(t);
    }

    // An easing token's curve at p.
    public static double Ease(string token, double p)
    {
        var c = Curves[token];
        if (c.Length == 0)
            return p;
        if (c[0] == 0)
            return CubicBezier(c[1], c[2], c[3], c[4], p);
        if (p <= c[1])
            return c[2];
        for (var i = 3; i + 1 < c.Length; i += 2)
        {
            if (p <= c[i])
            {
                double x0 = c[i - 2], y0 = c[i - 1], x1 = c[i], y1 = c[i + 1];
                return x1 == x0 ? y1 : y0 + (y1 - y0) * (p - x0) / (x1 - x0);
            }
        }
        return c[^1];
    }

    private static double TrackAt((double At, double Value, string? Easing)[] track, double p, string fallback)
    {
        if (p <= track[0].At)
            return track[0].Value;
        for (var i = 1; i < track.Length; i++)
        {
            var a = track[i - 1];
            var b = track[i];
            if (p <= b.At)
            {
                if (b.At == a.At)
                    return b.Value;
                return a.Value + (b.Value - a.Value) * Ease(a.Easing ?? fallback, (p - a.At) / (b.At - a.At));
            }
        }
        return track[^1].Value;
    }

    // Every channel of `name` at `progress` (0 to 1) of one iteration.
    public static PurrimerMotionFrame Sample(string name, string kind, double progress, string? easing = null)
    {
        var e = Entry(name, kind);
        var p = e.Reverse ? 1 - progress : progress;
        var fallback = easing ?? e.Easing;
        var f = new PurrimerMotionFrame();
        foreach (var (ch, track) in e.Tracks)
        {
            var v = TrackAt(track, p, fallback);
            if (ch is "opacity" or "ringO" or "wash" or "draw")
                v = Math.Clamp(v, 0, 1);
            else if (ch == "blur")
                v = Math.Max(0, v);
            f.Set(ch, v);
        }
        if (e.Tracks.ContainsKey("orbit"))
        {
            var a = f.Orbit * Math.PI / 180;
            f.Tx += e.Orbit * Math.Cos(a);
            f.Ty += e.Orbit * Math.Sin(a);
        }
        return f;
    }

    // The frame's CSS transform (translate, rotate, rotateX in perspective, rotateY, scale, skewX) about the origin
    // (fractions of the size), in the control's coordinates. Use with RenderTransformOrigin at the top-left.
    public static Matrix ToMatrix(PurrimerMotionFrame f, Size size, Point origin, double perspective = 0)
    {
        double ox = origin.X * size.Width, oy = origin.Y * size.Height;
        // Built with column vectors, then transposed into Avalonia's row-vector Matrix.
        var m = Mul(new[] { 1, 0, ox + f.Tx + f.Txp * size.Width, 0, 1, oy + f.Ty + f.Typ * size.Height, 0, 0, 1.0 },
            Rot(f.Rot));
        if (f.RotX != 0)
        {
            var a = f.RotX * Math.PI / 180;
            m = Mul(m, new[] { 1, 0, 0, 0, Math.Cos(a), 0, 0, -Math.Sin(a) / (perspective == 0 ? 1e9 : perspective), 1 });
        }
        var sx = f.Sx * Math.Cos(f.RotY * Math.PI / 180);
        m = Mul(m, new[] { sx, 0, 0, 0, f.Sy, 0, 0, 0, 1.0 });
        if (f.Skew != 0)
            m = Mul(m, new[] { 1, Math.Tan(f.Skew * Math.PI / 180), 0, 0, 1, 0, 0, 0, 1.0 });
        m = Mul(m, new[] { 1, 0, -ox, 0, 1, -oy, 0, 0, 1.0 });
        return new Matrix(m[0], m[3], m[6], m[1], m[4], m[7], m[2], m[5], m[8]);
    }

    private static double[] Rot(double deg)
    {
        var r = deg * Math.PI / 180;
        return new[] { Math.Cos(r), -Math.Sin(r), 0, Math.Sin(r), Math.Cos(r), 0, 0, 0, 1.0 };
    }

    private static double[] Mul(double[] a, double[] b)
    {
        var o = new double[9];
        for (var r = 0; r < 3; r++)
            for (var c = 0; c < 3; c++)
                o[r * 3 + c] = a[r * 3] * b[c] + a[r * 3 + 1] * b[3 + c] + a[r * 3 + 2] * b[6 + c];
        return o;
    }
}

// Plays one catalog animation over time. Frame fires with every channel's value; Done fires when a finite animation
// ends. While PurrimerMotion.PauseLoops is on (screenshot runs), frames stay at rest and finite animations end at
// once, as the web does with animations off.
public sealed class PurrimerMotionPlayer
{
    private readonly DispatcherTimer _timer;
    private readonly Stopwatch _clock = new();
    private double _duration;
    private double _delay;
    private int _count = 1;
    private string? _easing;
    private bool _alternate;

    public PurrimerMotionPlayer()
    {
        _timer = new DispatcherTimer(TimeSpan.FromMilliseconds(16), DispatcherPriority.Render, (_, _) => Tick());
    }

    public string Name { get; private set; } = "";
    // An effective kind: "sleepy", "playful" or "still".
    public string Kind { get; private set; } = "sleepy";
    public PurrimerMotionFrame Current { get; private set; } = PurrimerMotionFrame.Rest;
    public bool Running => _timer.IsEnabled;
    public PurrimerMotionEntry? Entry => Name.Length > 0 ? PurrimerMotionCatalog.Entry(Name, Kind) : null;

    public event Action<PurrimerMotionFrame>? Frame;
    public event Action? Done;

    // duration and delay in ms; easing is an easing token; index staggers by the kind's stagger token.
    public void Play(string name, string kind, double? duration = null, double delay = 0, string? easing = null,
        int index = 0, bool loop = false, int? count = null, bool alternate = false, bool paused = false)
    {
        if (!PurrimerMotionCatalog.Has(name))
            throw new ArgumentException($"Unknown motion: {name}", nameof(name));
        _timer.Stop();
        Name = name;
        Kind = kind;
        var e = PurrimerMotionCatalog.Entry(name, kind);
        _duration = duration ?? e.Duration;
        _delay = delay + index * PurrimerMotionCatalog.Stagger(kind);
        _count = loop ? -1 : count ?? e.Count;
        _easing = easing;
        _alternate = alternate;
        if (PurrimerMotion.PauseLoops)
        {
            Emit(PurrimerMotionFrame.Rest);
            if (_count >= 0)
                Done?.Invoke();
            return;
        }
        // Decorative loops stop under reduced motion, resting on their first frame.
        if (kind == "still" && (e.Decorative || _count < 0))
        {
            Emit(PurrimerMotionCatalog.Sample(name, kind, 0, easing));
            return;
        }
        Emit(e.FillBoth ? PurrimerMotionCatalog.Sample(name, kind, 0, easing) : PurrimerMotionFrame.Rest);
        if (paused)
            return;
        _clock.Restart();
        _timer.Start();
    }

    public void Stop() => _timer.Stop();

    public void Reset()
    {
        _timer.Stop();
        Emit(PurrimerMotionFrame.Rest);
    }

    private void Emit(PurrimerMotionFrame f)
    {
        Current = f;
        Frame?.Invoke(f);
    }

    private void Tick()
    {
        var t = _clock.Elapsed.TotalMilliseconds - _delay;
        if (t < 0)
            return;
        var dur = Math.Max(_duration, 1);
        var iteration = (int)Math.Floor(t / dur);
        if (_count >= 0 && iteration >= _count)
        {
            _timer.Stop();
            var last = _alternate && (_count - 1) % 2 == 1;
            Emit(Entry!.FillBoth ? PurrimerMotionCatalog.Sample(Name, Kind, last ? 0 : 1, _easing) : PurrimerMotionFrame.Rest);
            Done?.Invoke();
            return;
        }
        var p = (t - iteration * dur) / dur;
        if (_alternate && iteration % 2 == 1)
            p = 1 - p;
        Emit(PurrimerMotionCatalog.Sample(Name, Kind, p, _easing));
    }
}

// Burst: celebration particles, the same lists as the web's for the same seed (mulberry32).
public sealed class PurrimerBurstFrame
{
    public double At, X, Y, Xf, Yf, Rotate, Scale, Opacity;
}

public sealed class PurrimerBurstParticle
{
    public string Shape = "circle";
    public double Width, Height, Duration, Delay;
    public string Color = "";
    public PurrimerBurstFrame[] Frames = Array.Empty<PurrimerBurstFrame>();
    // One cubic-bezier per segment; null is linear.
    public double[]?[] Easings = Array.Empty<double[]?>();
}

public static class PurrimerBurst
{
    public static readonly string[] Colors = { "bgColor-accent-emphasis", "bgColor-done-emphasis", "bgColor-info-emphasis", "bgColor-success-emphasis", "bgColor-attention-emphasis", "bgColor-severe-emphasis" };
    private static readonly double[] Enter = { 0.22, 1, 0.36, 1 };
    private static readonly double[] Fall = { 0.5, 0, 0.9, 0.5 };
    private static readonly double[] Spring = { 0.34, 1.56, 0.64, 1 };

    public static Func<double> Seeded(uint seed)
    {
        var a = seed;
        return () =>
        {
            unchecked
            {
                a += 0x6D2B79F5;
                var t = a;
                t = (t ^ (t >> 15)) * (t | 1);
                t ^= t + (t ^ (t >> 7)) * (t | 61);
                return (t ^ (t >> 14)) / 4294967296.0;
            }
        };
    }

    private static PurrimerBurstFrame F(double at, double x, double y, double rotate, double scale, double opacity, double xf = 0, double yf = 0) =>
        new() { At = at, X = x, Y = y, Xf = xf, Yf = yf, Rotate = rotate, Scale = scale, Opacity = opacity };

    // The particles of one burst in an effective kind; rain's frames add Xf and Yf, fractions of the layer's size.
    public static List<PurrimerBurstParticle> Particles(string kind, string? variant, int count, double spread, uint seed)
    {
        var output = new List<PurrimerBurstParticle>();
        if (kind == "still")
            return output;
        var playful = kind == "playful";
        variant = string.IsNullOrEmpty(variant) ? (playful ? "confetti" : "motes") : variant;
        var rand = Seeded(seed == 0 ? (uint)Random.Shared.Next(1, int.MaxValue) : seed);
        if (count <= 0)
            count = variant switch { "motes" => 9, "ring" => 10, "rain" => 36, _ => 26 };
        if (spread <= 0)
            spread = playful ? 120 : 56;
        for (var i = 0; i < count; i++)
        {
            var shape = variant == "motes" ? 0 : i % 3;
            var size = variant == "motes" ? 3 + rand() * 3 : 5 + rand() * 4;
            var p = new PurrimerBurstParticle
            {
                Shape = shape switch { 0 => "circle", 1 => "square", _ => "bar" },
                Width = shape == 2 ? size * 1.8 : size,
                Height = shape == 2 ? size * 0.55 : size,
                Color = Colors[i % Colors.Length],
            };
            if (variant == "motes")
            {
                var mx = (rand() - 0.5) * spread;
                var my = -(30 + rand() * spread);
                p.Frames = new[] { F(0, 0, 0, 0, 0.4, 0), F(0.3, mx * 0.4, my * 0.35, 0, 1, 0.9), F(1, mx, my, 0, 0.8, 0) };
                p.Duration = (playful ? 900 : 1800) + rand() * 900;
                p.Delay = rand() * (playful ? 120 : 400);
                p.Easings = new[] { Enter, Enter };
            }
            else if (variant == "ring")
            {
                var a = (double)i / count * Math.PI * 2;
                var r = spread * (playful ? 0.7 : 0.55);
                p.Frames = new[] { F(0, 0, 0, 0, 0.3, 0), F(0.45, Math.Cos(a) * r * 0.8, Math.Sin(a) * r * 0.8, 0, 1, 1), F(1, Math.Cos(a) * r, Math.Sin(a) * r, 0, 0.6, 0) };
                p.Duration = playful ? 700 : 1200;
                var e = playful ? Spring : Enter;
                p.Easings = new[] { e, e };
            }
            else if (variant == "rain")
            {
                var sx = rand();
                var drift = (rand() - 0.5) * 80;
                var rot = (rand() - 0.5) * (playful ? 720 : 180);
                p.Frames = new[] { F(0, 0, -20, 0, 1, 1, sx, 0), F(1, drift, 40, rot, 1, 0.9, sx, 1) };
                p.Duration = (playful ? 1400 : 3200) + rand() * 1200;
                p.Delay = rand() * (playful ? 500 : 1200);
                p.Easings = new[] { playful ? Fall : null };
            }
            else
            {
                var ang = -Math.PI / 2 + (rand() - 0.5) * Math.PI * 1.1;
                var v = spread * (0.6 + rand() * 0.6);
                double dx = Math.Cos(ang) * v, dy = Math.Sin(ang) * v;
                var spin = (rand() - 0.5) * (playful ? 900 : 240);
                p.Frames = new[] { F(0, 0, 0, 0, 0.6, 1), F(0.35, dx, dy, spin * 0.5, 1, 1), F(1, dx * 1.3, dy + spread * (playful ? 1.1 : 0.5), spin, 0.9, 0) };
                p.Duration = (playful ? 1100 : 1700) + rand() * 400;
                p.Easings = new[] { Enter, Fall };
            }
            output.Add(p);
        }
        return output;
    }

    // One particle at `elapsed` ms after the burst: position (px from the origin), rotation, scale and opacity.
    public static (double X, double Y, double Rotate, double Scale, double Opacity) State(PurrimerBurstParticle p, double elapsed, double width, double height)
    {
        var t = Math.Clamp((elapsed - p.Delay) / p.Duration, 0, 1);
        for (var i = 0; i < p.Frames.Length - 1; i++)
        {
            var a = p.Frames[i];
            var b = p.Frames[i + 1];
            if (t <= b.At || i == p.Frames.Length - 2)
            {
                var curve = p.Easings[Math.Min(i, p.Easings.Length - 1)];
                var local = b.At == a.At ? 0 : (t - a.At) / (b.At - a.At);
                var e = curve is null ? local : PurrimerMotionCatalog.CubicBezier(curve[0], curve[1], curve[2], curve[3], local);
                double L(double x, double y) => x + (y - x) * e;
                return (L(a.X, b.X) + L(a.Xf, b.Xf) * width, L(a.Y, b.Y) + L(a.Yf, b.Yf) * height, L(a.Rotate, b.Rotate),
                    L(a.Scale, b.Scale), Math.Clamp(L(a.Opacity, b.Opacity), 0, 1));
            }
        }
        return (0, 0, 0, 1, 0);
    }

    public static double Length(IEnumerable<PurrimerBurstParticle> particles) =>
        particles.Select(p => p.Delay + p.Duration).DefaultIfEmpty(0).Max();
}

// Applies a motion frame to a control: the same transform, opacity, blur and reveal clip as Motion, for controls
// that animate a part of themselves (Stagger's children, Dialog's card, Snackbar's bar).
public static class PurrimerMotionVisual
{
    public static void Apply(global::Avalonia.Controls.Control target, PurrimerMotionFrame f, PurrimerMotionEntry? entry, double extraOpacity = 1)
    {
        if (f.AtRest)
        {
            target.RenderTransform = null;
            target.Opacity = extraOpacity;
            target.Effect = null;
            target.Clip = null;
            return;
        }
        var size = target.Bounds.Size;
        target.RenderTransformOrigin = RelativePoint.TopLeft;
        target.RenderTransform = new global::Avalonia.Media.MatrixTransform(
            PurrimerMotionCatalog.ToMatrix(f, size, entry?.Origin ?? new Point(0.5, 0.5), entry?.Perspective ?? 0));
        target.Opacity = f.Opacity * extraOpacity;
        // Avalonia's blur radius r gives a Gaussian of sigma 0.57735 r + 0.5; CSS blur() names the sigma.
        target.Effect = f.Blur > 0.05 ? new global::Avalonia.Media.BlurEffect { Radius = Math.Max(0, (f.Blur - 0.5) / 0.57735) } : null;
        target.Clip = f.Reveal < 0.999
            ? new global::Avalonia.Media.RectangleGeometry(new Rect(-64, -64, size.Width + 128, Math.Max(0, f.Reveal * (size.Height + 64))))
            : null;
    }
}

// What the existing controls take from a kind: the press scale and its timing, the check mark's pop, the Toggle
// handle's travel and stretch, and the ProgressBar fill. Durations are ms; easings are easing tokens.
public sealed record PurrimerControlTimings(double Press, double PressDuration, string PressEasing, double CheckDuration,
    string CheckEasing, double ToggleDuration, string ToggleEasing, double Stretch, double ProgressDuration,
    string ProgressEasing);

// An easing token's curve as an Avalonia easing, for transitions. The springs may overshoot.
public sealed class PurrimerTokenEasing : Easing
{
    public string Token { get; set; } = "easing-linear";

    public override double Ease(double progress) => PurrimerMotionCatalog.Ease(Token, progress);
}

// Eases one value to a target over a duration, on an easing token's curve. Changed fires with every value. A new
// target starts from the value shown now. While loops are paused (screenshot runs), it jumps.
public sealed class PurrimerTween
{
    private readonly DispatcherTimer _timer;
    private readonly Stopwatch _clock = new();
    private double _from;
    private double _duration;
    private string _easing = "easing-linear";

    public PurrimerTween(double value = 0)
    {
        Value = value;
        Target = value;
        _timer = new DispatcherTimer(TimeSpan.FromMilliseconds(16), DispatcherPriority.Render, (_, _) => Step());
        _timer.Stop();
    }

    public double Value { get; private set; }
    public double Target { get; private set; }
    public bool Moving => _timer.IsEnabled;

    public event Action<double>? Changed;

    public void Set(double value)
    {
        _timer.Stop();
        Value = value;
        Target = value;
        Changed?.Invoke(value);
    }

    public void To(double target, double durationMs, string easing)
    {
        if (PurrimerMotion.PauseLoops || durationMs <= 0)
        {
            Set(target);
            return;
        }
        _from = Value;
        Target = target;
        _duration = durationMs;
        _easing = easing;
        _clock.Restart();
        _timer.Start();
    }

    private void Step()
    {
        var p = Math.Min(1, _clock.Elapsed.TotalMilliseconds / _duration);
        Value = _from + (Target - _from) * PurrimerMotionCatalog.Ease(_easing, p);
        if (p >= 1)
        {
            _timer.Stop();
            Value = Target;
        }
        Changed?.Invoke(Value);
    }
}

// Puts a template part of a stock control on its kind's control motion. Set pm:PurrimerControlMotion.Role on the part:
//   press     scales the part to the kind's press (95% when playful, still when sleepy) while its button is held
//   mark      pops the part in on the kind's check curve when it appears
//   knob      a ToggleSwitch handle: it travels on the kind's curve, and stretches while held when playful
//   progress  a ProgressBar fill: its width eases on the kind's curve
// The kind is the part's scope's, read when the motion starts.
public sealed class PurrimerControlMotion : AvaloniaObject
{
    public static readonly AttachedProperty<string> RoleProperty =
        AvaloniaProperty.RegisterAttached<PurrimerControlMotion, global::Avalonia.Controls.Control, string>("Role", "");

    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<global::Avalonia.Controls.Control, object> Hooked = new();

    static PurrimerControlMotion()
    {
        RoleProperty.Changed.AddClassHandler<global::Avalonia.Controls.Control>((part, _) =>
        {
            if (Hooked.TryGetValue(part, out var _))
                return;
            Hooked.Add(part, new object());
            part.AttachedToVisualTree += (_, _) => Attach(part);
        });
    }

    public static string GetRole(global::Avalonia.Controls.Control element) => element.GetValue(RoleProperty);
    public static void SetRole(global::Avalonia.Controls.Control element, string value) => element.SetValue(RoleProperty, value);

    private static PurrimerControlTimings TimingsFor(global::Avalonia.Controls.Control part) =>
        PurrimerMotionCatalog.Controls(PurrimerMotion.EffectiveKind(part));

    private static global::Avalonia.Media.ITransform? Scale(double v, bool moving) =>
        Math.Abs(v - 1) < 1e-4 && !moving ? null : new global::Avalonia.Media.ScaleTransform(v, v);

    private static void Attach(global::Avalonia.Controls.Control part)
    {
        switch (GetRole(part))
        {
            case "progress":
                {
                    var c = TimingsFor(part);
                    part.Transitions = PurrimerMotion.PauseLoops ? null : new global::Avalonia.Animation.Transitions
                    {
                        new global::Avalonia.Animation.DoubleTransition
                        {
                            Property = global::Avalonia.Layout.Layoutable.WidthProperty,
                            Duration = TimeSpan.FromMilliseconds(c.ProgressDuration),
                            Easing = new PurrimerTokenEasing { Token = c.ProgressEasing },
                        },
                    };
                    break;
                }
            case "knob" when part.TemplatedParent is global::Avalonia.Controls.ToggleSwitch sw:
                {
                    var c = TimingsFor(part);
                    sw.KnobTransitions = new global::Avalonia.Animation.Transitions
                    {
                        new global::Avalonia.Animation.DoubleTransition
                        {
                            Property = global::Avalonia.Controls.Canvas.LeftProperty,
                            Duration = TimeSpan.FromMilliseconds(c.ToggleDuration),
                            Easing = new PurrimerTokenEasing { Token = c.ToggleEasing },
                        },
                    };
                    HookOnce(part, () => HookKnob(part, sw));
                    break;
                }
            case "press" when part.TemplatedParent is global::Avalonia.Controls.Button button:
                HookOnce(part, () => HookPress(part, button));
                break;
            case "mark":
                HookOnce(part, () => HookMark(part));
                break;
        }
    }

    private static readonly System.Runtime.CompilerServices.ConditionalWeakTable<global::Avalonia.Controls.Control, object> Wired = new();

    private static void HookOnce(global::Avalonia.Controls.Control part, Action hook)
    {
        if (Wired.TryGetValue(part, out _))
            return;
        Wired.Add(part, new object());
        hook();
    }

    private static void HookPress(global::Avalonia.Controls.Control part, global::Avalonia.Controls.Button button)
    {
        var scale = new PurrimerTween(1);
        scale.Changed += v => part.RenderTransform = Scale(v, scale.Moving);
        button.PropertyChanged += (_, e) =>
        {
            if (e.Property != global::Avalonia.Controls.Button.IsPressedProperty)
                return;
            var c = TimingsFor(part);
            if (c.Press == 1 && scale.Value == 1 && !scale.Moving)
                return;
            scale.To(button.IsPressed && button.IsEnabled ? c.Press : 1, c.PressDuration, c.PressEasing);
        };
    }

    private static void HookMark(global::Avalonia.Controls.Control part)
    {
        var scale = new PurrimerTween(1);
        scale.Changed += v => part.RenderTransform = Scale(v, scale.Moving);
        part.PropertyChanged += (_, e) =>
        {
            // Only a mark that appears on a control already on screen pops; the first layout shows it at rest.
            if (e.Property != Visual.IsVisibleProperty || !part.IsVisible
                || part.TemplatedParent is not global::Avalonia.Controls.Control { IsLoaded: true })
                return;
            var c = TimingsFor(part);
            scale.Set(0);
            scale.To(1, c.CheckDuration, c.CheckEasing);
        };
    }

    private static void HookKnob(global::Avalonia.Controls.Control part, global::Avalonia.Controls.ToggleSwitch sw)
    {
        var rest = part.Width;
        var by = 1.0;
        var stretch = new PurrimerTween(0);
        stretch.Changed += v =>
        {
            var w = rest * (1 + (by - 1) * v);
            part.Width = w;
            // The handle sits centred in its slot; the stretch keeps the edge it rests on.
            var dx = sw.IsChecked == true ? (rest - w) / 2 : (w - rest) / 2;
            part.RenderTransform = Math.Abs(dx) < 1e-4 ? null : new global::Avalonia.Media.TranslateTransform(dx, 0);
        };
        sw.PropertyChanged += (_, e) =>
        {
            if (e.Property != global::Avalonia.Controls.Button.IsPressedProperty)
                return;
            var c = TimingsFor(part);
            if (sw.IsPressed)
            {
                if (c.Stretch == 1)
                    return;
                by = c.Stretch;
            }
            stretch.To(sw.IsPressed && sw.IsEnabled ? 1 : 0, c.ToggleDuration, c.ToggleEasing);
        };
    }
}
