// {{ note }}
// {{ c.summary }}
import type { JSX } from "@solidjs/web";

const SIZES = {{ c.spec.sizes | tojson }};

export type SpinnerProps = {
  size?: keyof typeof SIZES | number;
  label?: string;
  kind?: {{ c.spec.props.kind["values"] | map("tojson") | join(" | ") }};
  class?: JSX.ClassValue;
};

export function Spinner(props: SpinnerProps): JSX.Element {
  const px = () => (typeof props.size === "number" ? props.size : SIZES[props.size ?? "medium"]);
  return (
    <span class={["pm-spinner", props.class]} role="status" data-motion={props.kind}>
      <svg width={px()} height={px()} viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle class="pm-spinner__track" cx="8" cy="8" r="7" stroke-width="2" />
        <circle class="pm-spinner__arc" cx="8" cy="8" r="7" stroke-width="2" pathLength="100" />
      </svg>
      <span class="pm-sr-only">{props.label ?? "{{ c.spec.props.label.default }}"}</span>
    </span>
  );
}
