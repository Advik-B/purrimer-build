<!-- {{ note }} -->
<!-- {{ c.summary }} -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:pm="clr-namespace:{{ ns }}">
  <ControlTheme x:Key="{x:Type pm:HoldMenu}" TargetType="pm:HoldMenu">
    <Setter Property="FontFamily" Value="{{ "sans" | font }}" />
    <Setter Property="OptionShadow" Value="{{ "shadow-floating-small" | tok }}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Top" />
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" />
      </ControlTemplate>
    </Setter>
  </ControlTheme>
</ResourceDictionary>
