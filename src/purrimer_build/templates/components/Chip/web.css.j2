.pm-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 24px;
  padding: 0 10px;
  border-radius: {{ "borderRadius-full" | tok }};
  font: 500 12px/16px var(--font-sans);
  white-space: nowrap;
  background: {{ "bgColor-accent-muted" | tok }};
  color: {{ "fgColor-accent" | tok }};
}
.pm-chip svg { width: 12px; height: 12px; fill: currentColor; }
.pm-chip--neutral { background: {{ "bgColor-neutral-muted" | tok }}; color: {{ "fgColor-default" | tok }}; }
{% for tone in ["success", "attention", "severe", "danger", "done", "info"] %}
.pm-chip--{{ tone }} { background: {{ ("bgColor-" ~ tone ~ "-muted") | tok }}; color: {{ ("fgColor-" ~ tone) | tok }}; }
{% endfor %}
.pm-chip__remove { display: inline-grid; place-items: center; width: 16px; height: 16px; margin-right: -4px; padding: 0; border: 0; border-radius: 50%; background: transparent; color: inherit; cursor: pointer; }
.pm-chip__remove:hover { background: {{ "control-transparent-bgColor-hover" | tok }}; }
.pm-chip__remove:focus-visible { outline: {{ "borderWidth-thick" | tok }} solid {{ "focus-outlineColor" | tok }}; }
