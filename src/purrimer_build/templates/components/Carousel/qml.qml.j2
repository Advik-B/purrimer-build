// {{ note }}
// {{ c.summary }}
pragma ComponentBehavior: Bound
import QtQuick

// Slides from a model and a delegate, as for a ListView; each delegate should fill width and height. A finger or a
// dragged mouse pages it with momentum and snapping, one slide per flick, and the page marker follows the drag one to
// one. changed(index) fires as the slide changes; set currentIndex to move there.
Item {
    id: root
    property alias model: list.model
    property alias delegate: list.delegate
    property alias currentIndex: list.currentIndex
    property bool peek: false
    property bool controls: true
    property int slideHeight: 200
    property string accessibleName
    readonly property real slideWidth: width - (peek ? 48 : 0)
    readonly property real step: slideWidth + 8
    readonly property real position: step > 0 ? (list.contentX - list.originX + (peek ? 24 : 0)) / step : 0
    signal changed(int index)

    implicitWidth: 360
    implicitHeight: slideHeight + (controls ? 52 : 0)
    Accessible.role: Accessible.Grouping
    Accessible.name: accessibleName

    ListView {
        id: list
        width: parent.width
        height: root.slideHeight
        orientation: ListView.Horizontal
        spacing: 8
        clip: true
        snapMode: ListView.SnapOneItem
        highlightRangeMode: ListView.StrictlyEnforceRange
        preferredHighlightBegin: root.peek ? 24 : 0
        preferredHighlightEnd: root.peek ? width - 24 : width
        highlightMoveDuration: Purrimer.pauseLoops ? 0 : {{ "duration-slow" | tok }}
        boundsBehavior: Flickable.DragAndOvershootBounds
        activeFocusOnTab: true
        keyNavigationEnabled: true
        onCurrentIndexChanged: root.changed(currentIndex)
        Keys.onPressed: (event) => {
            if (event.key === Qt.Key_Home) {
                currentIndex = 0
                event.accepted = true
            } else if (event.key === Qt.Key_End) {
                currentIndex = count - 1
                event.accepted = true
            }
        }
    }

    Row {
        visible: root.controls && list.count > 1
        anchors.horizontalCenter: parent.horizontalCenter
        y: root.slideHeight + 4
        spacing: 4

        IconButton {
            width: 44
            height: 44
            iconName: "chevron-left"
            label: "Previous"
            variant: "invisible"
            opacity: list.currentIndex > 0 ? 1 : 0
            enabled: list.currentIndex > 0
            Behavior on opacity { NumberAnimation { duration: {{ "duration-fast" | tok }} } }
            onClicked: list.decrementCurrentIndex()
        }

        Row {
            anchors.verticalCenter: parent.verticalCenter
            spacing: 6
            Repeater {
                model: list.count
                Rectangle {
                    required property int index
                    readonly property real t: Math.max(0, 1 - Math.abs(root.position - index))
                    width: 6 + 14 * t
                    height: 6
                    radius: 3
                    color: Qt.tint({{ "borderColor-emphasis" | tok }}, Qt.rgba({{ "fgColor-accent" | tok }}.r, {{ "fgColor-accent" | tok }}.g, {{ "fgColor-accent" | tok }}.b, t))
                }
            }
        }

        IconButton {
            width: 44
            height: 44
            iconName: "chevron-right"
            label: "Next"
            variant: "invisible"
            opacity: list.currentIndex < list.count - 1 ? 1 : 0
            enabled: list.currentIndex < list.count - 1
            Behavior on opacity { NumberAnimation { duration: {{ "duration-fast" | tok }} } }
            onClicked: list.incrementCurrentIndex()
        }
    }
}
