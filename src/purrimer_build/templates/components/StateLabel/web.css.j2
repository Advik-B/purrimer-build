.pm-state {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  box-sizing: border-box;
  height: 32px;
  padding: 0 12px;
  border-radius: {{ "borderRadius-full" | tok }};
  background: {{ "bgColor-neutral-emphasis" | tok }};
  color: {{ "fgColor-onEmphasis" | tok }};
  font: 600 14px/20px var(--font-sans);
  white-space: nowrap;
}
.pm-state svg { width: 16px; height: 16px; fill: currentColor; flex: none; }
.pm-state--small { height: 28px; padding: 0 8px; }
{% for tone in ["success", "danger", "done"] %}
.pm-state--{{ tone }} { background: {{ ("bgColor-" ~ tone ~ "-emphasis") | tok }}; }
{% endfor %}
