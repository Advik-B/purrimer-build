from __future__ import annotations

import html
from dataclasses import dataclass

from PySide6.QtCore import QRectF, Qt
from PySide6.QtGui import QPainter, QPen
from PySide6.QtWidgets import QLabel, QSizePolicy, QVBoxLayout, QWidget

from ..icons import paint_icon
from ..theme import theme

FILLS = {
{% for tone in c.spec.tones %}
    "{{ tone }}": {{ ("bgColor-" ~ tone ~ "-emphasis") | tok }},
{% endfor %}
}


@dataclass
class TimelineEvent:
    content: str
    actor: str = ""
    icon: str = "git-commit"
    tone: str | None = None
    condensed: bool = False


class TimelineBreak:
    """A gap between eras of a timeline."""


class _Event(QWidget):
    def __init__(self, event: TimelineEvent, after_break: bool, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self._event = event
        self._after_break = after_break
        layout = QVBoxLayout(self)
        if event.condensed:
            layout.setContentsMargins(33, 4, 0, 4)
        else:
            layout.setContentsMargins(41, 22, 0, 16)
        actor = f"<b style='color: {theme.color({{ "fgColor-default" | tok }}).name()}'>{html.escape(event.actor)}</b> " if event.actor else ""
        self.body = QLabel(actor + html.escape(event.content))
        self.body.setTextFormat(Qt.TextFormat.RichText)
        self.body.setWordWrap(True)
        self.body.setProperty("role", "muted")
        layout.addWidget(self.body)
        self.setSizePolicy(QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Minimum)
        self.setMinimumHeight(24 if event.condensed else 64)
        theme.changed.connect(self.update)

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        top = 16 if self._after_break else 0
        painter.fillRect(QRectF(16, top, 2, self.height() - top), theme.color({{ "borderColor-muted" | tok }}))
        e = self._event
        if e.condensed:
            badge = QRectF(16 - 7, 4 + 2, 16, 16)
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(theme.color({{ "bgColor-default" | tok }}))
            painter.drawEllipse(badge)
            paint_icon(painter, badge, e.icon, theme.color({{ "fgColor-muted" | tok }}))
            return
        badge = QRectF(16 - 15, 16, 32, 32)
        fill = FILLS.get(e.tone or "", {{ "bgColor-muted" | tok }})
        painter.setPen(QPen(theme.color({{ "bgColor-default" | tok }}), 2))
        painter.setBrush(theme.color(fill))
        painter.drawEllipse(badge.adjusted(1, 1, -1, -1))
        ink = {{ "fgColor-onEmphasis" | tok }} if e.tone in FILLS else {{ "fgColor-muted" | tok }}
        paint_icon(painter, QRectF(badge.center().x() - 8, badge.center().y() - 8, 16, 16), e.icon, theme.color(ink))


class _Break(QWidget):
    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self.setFixedHeight(8)
        theme.changed.connect(self.update)

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        painter.fillRect(self.rect(), theme.color({{ "bgColor-default" | tok }}))
        painter.fillRect(QRectF(0, 0, self.width(), 4), theme.color({{ "borderColor-default" | tok }}))


class Timeline(QWidget):
    """A vertical history of events, with a break between eras."""

    def __init__(self, items: list[TimelineEvent | TimelineBreak], parent: QWidget | None = None) -> None:
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        after_break = False
        for item in items:
            if isinstance(item, TimelineBreak):
                layout.addWidget(_Break())
                after_break = True
            else:
                layout.addWidget(_Event(item, after_break))
                after_break = False
