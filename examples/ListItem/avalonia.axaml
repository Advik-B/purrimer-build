    <pm:ListItem IconName="bell" Headline="Notifications" Supporting="Mentions and replies" Trailing="On" ShowChevron="True" />
    <pm:ListItem IconName="globe" Headline="Language" Trailing="English" />
  </StackPanel>
</UserControl>
