// {{ c.summary }}
import type { JSX } from "@solidjs/web";
import { Icon } from "./Icon";

type Status = {{ c.spec.props.status["values"] | map("tojson") | join(" | ") }};
const ICONS: Record<Status, string> = {{ c.spec.icons | tojson }};
const TONES: Record<Status, string> = {{ c.spec.tones | tojson }};

export type StateLabelProps = { status?: Status; text?: string; size?: "medium" | "small"; children?: JSX.Element };

export function StateLabel(props: StateLabelProps): JSX.Element {
  const status = () => props.status ?? "open";
  return (
    <span class={["pm-state", TONES[status()] !== "neutral" && `pm-state--${TONES[status()]}`, props.size === "small" && "pm-state--small"]}>
      <Icon name={ICONS[status()]} />
      {props.children ?? props.text}
    </span>
  );
}
