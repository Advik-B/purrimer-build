from __future__ import annotations

from PySide6.QtCore import QRectF, QSize, Qt
from PySide6.QtGui import QFont, QFontMetrics, QPainter
from PySide6.QtWidgets import QAbstractButton, QWidget

from ..icons import paint_icon
from ..theme import theme

SIZE = {{ px("mobile-fab-size") | int }}


class FAB(QAbstractButton):
    """The floating action button; extended shows the label beside the icon."""

    def __init__(self, icon: str = "plus", label: str = "", extended: bool = False,
                 parent: QWidget | None = None) -> None:
        super().__init__(parent)
        self._icon = icon
        self._extended = extended
        self.setText(label)
        self.setAccessibleName(label)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self.setFocusPolicy(Qt.FocusPolicy.StrongFocus)
        font = theme.font({{ "text-mobile-body" | tok }})
        font.setPixelSize(16)
        font.setWeight(QFont.Weight.DemiBold)
        self._font = (font)
        self.setFixedSize(self.sizeHint())
        theme.changed.connect(self._restyle)
        self._restyle()

    def _restyle(self) -> None:
        theme.apply_shadow(self, {{ "shadow-floating-small" | tok }})
        self.update()

    def sizeHint(self) -> QSize:
        if not self._extended:
            return QSize(SIZE, SIZE)
        return QSize(16 + 24 + 8 + QFontMetrics(self._font).horizontalAdvance(self.text()) + 20, SIZE)

    def enterEvent(self, event) -> None:
        self.update()

    def leaveEvent(self, event) -> None:
        self.update()

    def paintEvent(self, event) -> None:
        painter = QPainter(self)
        painter.setFont(self._font)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        if self.isDown():
            token = {{ "button-primary-bgColor-active" | tok }}
        elif self.underMouse():
            token = {{ "button-primary-bgColor-hover" | tok }}
        else:
            token = {{ "button-primary-bgColor-rest" | tok }}
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(theme.color(token))
        radius = {{ px("borderRadius-large") | num }}
        painter.drawRoundedRect(QRectF(self.rect()), radius, radius)
        ink = theme.color({{ "fgColor-onEmphasis" | tok }})
        x = 16.0 if self._extended else (self.width() - 24) / 2
        paint_icon(painter, QRectF(x, (self.height() - 24) / 2, 24, 24), self._icon, ink)
        if self._extended:
            painter.setPen(ink)
            painter.drawText(QRectF(x + 32, 0, self.width() - x - 32, self.height()), Qt.AlignmentFlag.AlignVCenter,
                             self.text())
